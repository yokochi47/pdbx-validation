      <rdfs:subPropertyOf rdf:resource="#pdbx_chem_comp_depositor_infoItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_chem_comp_depositor_info.details</rdfs:label>
