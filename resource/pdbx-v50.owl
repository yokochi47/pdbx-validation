                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bovl</rdf:first>
                                                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
