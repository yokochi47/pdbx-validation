      <rdfs:label>pdbx_reference_molecule_related_structures.name</rdfs:label>
      <rdfs:comment xml:lang="en">
The chemical name for the structure entry in the related database
actinomycn
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_reference_molecule_related_structures.family_prd_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_reference_molecule_related_structuresItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_reference_molecule_related_structures.family_prd_id</rdfs:label>
      <rdfs:comment xml:lang="en">
The value of attribute family_prd_id in category pdbx_reference_molecule_related_structures is a reference to
 attribute family_prd_id in category pdbx_reference_molecule_list in category PDBX_REFERENCE_MOLECULE_FAMILY_LIST. 
                     </rdfs:comment>
   </owl:DatatypeProperty>
