      <rdfs:subPropertyOf rdf:resource="#struct_biol_genItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>struct_biol_gen.pdbx_after_end_residue_no</rdfs:label>
      <rdfs:comment xml:lang="en">

The new residue number after generation of portions of
the biomolecule.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="struct_biol_gen.pdbx_before_begin_residue_no">
      <rdfs:subPropertyOf rdf:resource="#struct_biol_genItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>struct_biol_gen.pdbx_before_begin_residue_no</rdfs:label>
