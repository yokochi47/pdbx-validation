               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nonpolymer_zero_occupancy_flag</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">polymer_zero_occupancy_flag</rdf:first>
                        <rdf:rest>
                           <rdf:List>
