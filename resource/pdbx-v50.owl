   <owl:DatatypeProperty rdf:ID="struct_conn.conn_type_id">
      <rdfs:subPropertyOf rdf:resource="#struct_connItem"/>
      <rdfs:domain rdf:resource="#struct_conn"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">covale</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disulf</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metalc</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hydrog</rdf:first>
                                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
This data item is a pointer to attribute id in category struct_conn_type in the
 STRUCT_CONN_TYPE category.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="struct_conn.details">
      <rdfs:subPropertyOf rdf:resource="#struct_connItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>struct_conn.details</rdfs:label>
      <rdfs:comment xml:lang="en">
A description of special aspects of the connection.
disulfide bridge C-S-S-C is highly distorted
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="struct_conn.pdbx_PDB_id">
      <rdfs:subPropertyOf rdf:resource="#struct_connItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>struct_conn.pdbx_PDB_id</rdfs:label>
