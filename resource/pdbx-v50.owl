   <owl:InverseFunctionalProperty rdf:ID="has_em_mapCategory">
      <rdfs:label>em_mapCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that datablock
        has a category holder em_mapCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#em_map"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_em_map">
      <rdfs:label>em_mapCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that em_mapCategory.
        has a category em_map.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#em_map"/>
      <rdfs:domain rdf:resource="#em_mapCategory"/>
      <rdfs:range rdf:resource="#em_map"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="em_mapItem">
      <rdfs:label>em_mapItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for em_map items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#em_map"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_em_map">
