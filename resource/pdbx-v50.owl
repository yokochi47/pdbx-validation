   <owl:Class rdf:ID="pdbx_data_processing_status">
      <rdfs:label>pdbx_data_processing_status</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_DATA_PROCESSING_STATUS category record
data processing instructions for workflow processing tasks.

    Example 1 -
&lt;PDBx:pdbx_data_processing_statusCategory&gt;
   &lt;PDBx:pdbx_data_processing_status status="skip" task_name="site"&gt;&lt;/PDBx:pdbx_data_processing_status&gt;
   &lt;PDBx:pdbx_data_processing_status status="skip" task_name="link"&gt;&lt;/PDBx:pdbx_data_processing_status&gt;
   &lt;PDBx:pdbx_data_processing_status status="skip" task_name="helix"&gt;&lt;/PDBx:pdbx_data_processing_status&gt;
   &lt;PDBx:pdbx_data_processing_status status="skip" task_name="solvent position"&gt;&lt;/PDBx:pdbx_data_processing_status&gt;
   &lt;PDBx:pdbx_data_processing_status status="skip" task_name="ssbond"&gt;&lt;/PDBx:pdbx_data_processing_status&gt;
   &lt;PDBx:pdbx_data_processing_status status="skip" task_name="metal coordination"&gt;&lt;/PDBx:pdbx_data_processing_status&gt;
&lt;/PDBx:pdbx_data_processing_statusCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_data_processing_status.status"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_data_processing_status.task_name"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_pdbx_data_processing_statusCategory">
      <rdfs:label>pdbx_data_processing_statusCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that datablock
        has a category holder pdbx_data_processing_statusCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#pdbx_data_processing_status"/>
   </owl:InverseFunctionalProperty>
