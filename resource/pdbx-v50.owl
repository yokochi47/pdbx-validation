   <owl:DatatypeProperty rdf:ID="pdbx_modification_feature.type">
      <rdfs:subPropertyOf rdf:resource="#pdbx_modification_featureItem"/>
      <rdfs:domain rdf:resource="#pdbx_modification_feature"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12-Hydroxyfarnesylation</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12-Oxomyristoylation</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12R-Hydroxymyristoylation</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">14-Hydroxy-10,13-dioxo-7-heptadecenoic acid</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(3-Aminopropyl)(5'-adenosyl)phosphono amidation</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2-Aminoadipylation</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2-Aminoethylphosphorylation</rdf:first>
                                                      <rdf:rest>
                                                         <rdf:List>
                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2-Cholinephosphorylation</rdf:first>
                                                            <rdf:rest>
                                                               <rdf:List>
                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2-Hydroxyisobutyrylation</rdf:first>
                                                                  <rdf:rest>
                                                                     <rdf:List>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2-Oxo-5,5-dimethylhexanoylation</rdf:first>
                                                                        <rdf:rest>
                                                                           <rdf:List>
                                                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2-Oxobutanoic acid</rdf:first>
                                                                              <rdf:rest>
                                                                                 <rdf:List>
                                                                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2,3-Dicarboxypropylation</rdf:first>
                                                                                    <rdf:rest>
                                                                                       <rdf:List>
                                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3-Oxoalanine</rdf:first>
                                                                                          <rdf:rest>
                                                                                             <rdf:List>
                                                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3-Phenyllactic acid</rdf:first>
                                                                                                <rdf:rest>
                                                                                                   <rdf:List>
                                                                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(3R)-3-Hydroxybutyrylation</rdf:first>
