   <owl:DatatypeProperty rdf:ID="pdbx_nmr_upload.data_file_category">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nmr_uploadItem"/>
      <rdfs:domain rdf:resource="#pdbx_nmr_upload"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assigned_chemical_shifts</rdf:first>
                  <rdf:rest>
