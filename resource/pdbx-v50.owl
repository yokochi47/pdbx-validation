      <rdfs:seeAlso rdf:resource="#pdbx_entity_src_gen_proteolysis"/>
      <rdfs:domain rdf:resource="#pdbx_entity_src_gen_proteolysisCategory"/>
      <rdfs:range rdf:resource="#pdbx_entity_src_gen_proteolysis"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_entity_src_gen_proteolysisItem">
      <rdfs:label>pdbx_entity_src_gen_proteolysisItem</rdfs:label>
