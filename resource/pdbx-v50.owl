        This property indicates that pdbx_entity_src_gen_pureCategory.
        has a category pdbx_entity_src_gen_pure.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#pdbx_entity_src_gen_pure"/>
      <rdfs:domain rdf:resource="#pdbx_entity_src_gen_pureCategory"/>
      <rdfs:range rdf:resource="#pdbx_entity_src_gen_pure"/>
   </owl:InverseFunctionalProperty>
