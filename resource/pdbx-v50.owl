   <owl:DatatypeProperty rdf:ID="struct_biol_gen.pdbx_color_green">
      <rdfs:subPropertyOf rdf:resource="#struct_biol_genItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
