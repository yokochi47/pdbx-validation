      <rdfs:label>pdbx_entity_src_gen_lysis.step_id</rdfs:label>
      <rdfs:comment xml:lang="en">
This item is the unique identifier for this lysis step.
                     </rdfs:comment>
   </owl:DatatypeProperty>
