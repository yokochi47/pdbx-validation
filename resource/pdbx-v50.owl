               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_diffraction_stats.image_processing_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_diffraction_stats.num_intensities_measured"/>
