      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#pdbx_data_processing_status"/>
      <rdfs:domain rdf:resource="#pdbx_data_processing_statusCategory"/>
      <rdfs:range rdf:resource="#pdbx_data_processing_status"/>
   </owl:InverseFunctionalProperty>
