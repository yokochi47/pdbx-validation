      <rdfs:label>pdbx_view_category_group.description</rdfs:label>
      <rdfs:comment xml:lang="en">
A description for this collection of categories.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_view_category_group.view_group_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_view_category_groupItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_view_category_group.view_group_id</rdfs:label>
      <rdfs:comment xml:lang="en">
The identifier for a collection of related mmCIF categories.
