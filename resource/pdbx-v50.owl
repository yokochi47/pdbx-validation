   <owl:DatatypeProperty rdf:ID="em_buffer_component.concentration">
      <rdfs:subPropertyOf rdf:resource="#em_buffer_componentItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_buffer_component.concentration</rdfs:label>
      <rdfs:comment xml:lang="en">
The concentration of the sample (arbitrary units).
1.35
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_buffer_component.concentration_units">
      <rdfs:subPropertyOf rdf:resource="#em_buffer_componentItem"/>
