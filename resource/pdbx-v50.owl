   <owl:DatatypeProperty rdf:ID="struct_sheet_order.offset">
      <rdfs:subPropertyOf rdf:resource="#struct_sheet_orderItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>struct_sheet_order.offset</rdfs:label>
      <rdfs:comment xml:lang="en">
Designates the relative position in the sheet, plus or minus, of
the second residue range to the first.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="struct_sheet_order.sense">
      <rdfs:subPropertyOf rdf:resource="#struct_sheet_orderItem"/>
      <rdfs:domain rdf:resource="#struct_sheet_order"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">parallel</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anti-parallel</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
A flag to indicate whether the two designated residue ranges are
parallel or antiparallel to one another.
                        </rdfs:comment>
   </owl:DatatypeProperty>
