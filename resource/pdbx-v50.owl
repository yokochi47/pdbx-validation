      <rdfs:seeAlso rdf:resource="#pdbx_dbref"/>
      <rdfs:domain rdf:resource="#pdbx_dbrefCategory"/>
      <rdfs:range rdf:resource="#pdbx_dbref"/>
   </owl:InverseFunctionalProperty>
