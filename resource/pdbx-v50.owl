   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_entity_branch_link.atom_stereo_config_2">
      <rdfs:subPropertyOf rdf:resource="#pdbx_entity_branch_linkItem"/>
      <rdfs:domain rdf:resource="#pdbx_entity_branch_link"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
