   <owl:Class rdf:ID="pdbx_family_prd_audit">
      <rdfs:label>pdbx_family_prd_audit</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_FAMILY_PRD_AUDIT category records
the status and tracking information for this family.

    Example 1 -
&lt;PDBx:pdbx_family_prd_auditCategory&gt;
   &lt;PDBx:pdbx_family_prd_audit action_type="Create family" date="2011-12-01" family_prd_id="FAM_0000001"&gt;
      &lt;PDBx:annotator&gt;JY&lt;/PDBx:annotator&gt;
      &lt;PDBx:processing_site&gt;RCSB&lt;/PDBx:processing_site&gt;
   &lt;/PDBx:pdbx_family_prd_audit&gt;
   &lt;PDBx:pdbx_family_prd_audit action_type="Modify sequence" date="2011-12-05" family_prd_id="FAM_0000001"&gt;
      &lt;PDBx:annotator&gt;MZ&lt;/PDBx:annotator&gt;
      &lt;PDBx:processing_site&gt;RCSB&lt;/PDBx:processing_site&gt;
   &lt;/PDBx:pdbx_family_prd_audit&gt;
&lt;/PDBx:pdbx_family_prd_auditCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_family_prd_audit.annotator"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_family_prd_audit.annotator"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_family_prd_audit.details"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_family_prd_audit.details"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_family_prd_audit.processing_site"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_family_prd_audit.processing_site"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_family_prd_audit.action_type"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_family_prd_audit.date"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_family_prd_audit.family_prd_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_pdbx_family_prd_auditCategory">
      <rdfs:label>pdbx_family_prd_auditCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that datablock
        has a category holder pdbx_family_prd_auditCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#pdbx_family_prd_audit"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_pdbx_family_prd_audit">
      <rdfs:label>pdbx_family_prd_auditCategory</rdfs:label>
