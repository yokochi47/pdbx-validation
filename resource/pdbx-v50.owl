                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Covalent chemical modification</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crosslinker</rdf:first>
                                                      <rdf:rest>
                                                         <rdf:List>
                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flavin</rdf:first>
                                                            <rdf:rest>
