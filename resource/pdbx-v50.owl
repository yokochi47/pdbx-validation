               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_vitrification.time_resolved_state"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
