   <owl:DatatypeProperty rdf:ID="em_2d_crystal_entityItem">
      <rdfs:label>em_2d_crystal_entityItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for em_2d_crystal_entity items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#em_2d_crystal_entity"/>
