      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="struct_biol_gen">
      <rdfs:label>struct_biol_gen</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the STRUCT_BIOL_GEN category record details about
the generation of each biological unit. The STRUCT_BIOL_GEN
data items provide the specifications of the components that
constitute that biological unit, which may include symmetry
elements.

    Example 1 - based on PDB entry 5HVP and laboratory records for the
                structure corresponding to PDB entry 5HVP.
&lt;PDBx:struct_biol_genCategory&gt;
   &lt;PDBx:struct_biol_gen asym_id="A" biol_id="1" symmetry="1_555"&gt;&lt;/PDBx:struct_biol_gen&gt;
   &lt;PDBx:struct_biol_gen asym_id="B" biol_id="1" symmetry="1_555"&gt;&lt;/PDBx:struct_biol_gen&gt;
   &lt;PDBx:struct_biol_gen asym_id="A" biol_id="2" symmetry="1_555"&gt;&lt;/PDBx:struct_biol_gen&gt;
   &lt;PDBx:struct_biol_gen asym_id="B" biol_id="2" symmetry="1_555"&gt;&lt;/PDBx:struct_biol_gen&gt;
   &lt;PDBx:struct_biol_gen asym_id="C" biol_id="2" symmetry="1_555"&gt;&lt;/PDBx:struct_biol_gen&gt;
   &lt;PDBx:struct_biol_gen asym_id="A" biol_id="3" symmetry="1_555"&gt;&lt;/PDBx:struct_biol_gen&gt;
   &lt;PDBx:struct_biol_gen asym_id="B" biol_id="3" symmetry="1_555"&gt;&lt;/PDBx:struct_biol_gen&gt;
   &lt;PDBx:struct_biol_gen asym_id="D" biol_id="3" symmetry="1_555"&gt;&lt;/PDBx:struct_biol_gen&gt;
&lt;/PDBx:struct_biol_genCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_biol_gen.details"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_biol_gen.details"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_biol_gen.pdbx_PDB_order"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_biol_gen.pdbx_PDB_order"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_biol_gen.pdbx_after_begin_residue_no"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_biol_gen.pdbx_after_begin_residue_no"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_biol_gen.pdbx_after_end_residue_no"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_biol_gen.pdbx_after_end_residue_no"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_biol_gen.pdbx_before_begin_residue_no"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_biol_gen.pdbx_before_begin_residue_no"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_biol_gen.pdbx_before_end_residue_no"/>
