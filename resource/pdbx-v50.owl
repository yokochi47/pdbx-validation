The volume in milliliters of buffer in which the lysis was performed.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_entity_src_gen_lysis.date">
      <rdfs:subPropertyOf rdf:resource="#pdbx_entity_src_gen_lysisItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_entity_src_gen_lysis.date</rdfs:label>
      <rdfs:comment xml:lang="en">
The date of this production step.
2003-12-25
2003-12-25:09:00
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_entity_src_gen_lysis.details">
      <rdfs:subPropertyOf rdf:resource="#pdbx_entity_src_gen_lysisItem"/>
