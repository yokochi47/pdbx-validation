      <rdfs:label>pdbx_database_PDB_obs_spr.details</rdfs:label>
      <rdfs:comment xml:lang="en">
Details related to the replaced or replacing entry.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_database_PDB_obs_spr.id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_database_PDB_obs_sprItem"/>
      <rdfs:domain rdf:resource="#pdbx_database_PDB_obs_spr"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBSLTE</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SPRSDE</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
Identifier for the type of obsolete entry to be added to this entry.
OBSLTE
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_database_PDB_obs_spr.pdb_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_database_PDB_obs_sprItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_database_PDB_obs_spr.pdb_id</rdfs:label>
      <rdfs:comment xml:lang="en">
The new PDB identifier for the replaced entry.
2ABC
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_database_PDB_obs_spr.replace_pdb_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_database_PDB_obs_sprItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_database_PDB_obs_spr.replace_pdb_id</rdfs:label>
      <rdfs:comment xml:lang="en">
The PDB identifier for the replaced (OLD) entry/entries.
3ABC
                     </rdfs:comment>
   </owl:DatatypeProperty>
