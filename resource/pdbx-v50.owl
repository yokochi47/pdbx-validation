      &lt;PDBx:source&gt;SciFinder&lt;/PDBx:source&gt;
   &lt;/PDBx:pdbx_reference_molecule_synonyms&gt;
   &lt;PDBx:pdbx_reference_molecule_synonyms family_prd_id="FAM_000001" ordinal="5" prd_id="PRD_000001"&gt;
