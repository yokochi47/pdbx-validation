      <rdfs:label>pdbx_phasing_MAD_shell.reflns_centric</rdfs:label>
      <rdfs:comment xml:lang="en">
attribute reflns_centric in category pdbx_phasing_MAD_shell records the number of
 centric reflections for MAD phasing.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_phasing_MAD_shell.d_res_high">
      <rdfs:subPropertyOf rdf:resource="#pdbx_phasing_MAD_shellItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_phasing_MAD_shell.d_res_high</rdfs:label>
      <rdfs:comment xml:lang="en">
attribute d_res_high in category pdbx_phasing_MAD_shell records the higher resolution
