      <rdfs:subPropertyOf rdf:resource="#atom_siteItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>atom_site.auth_comp_id</rdfs:label>
      <rdfs:comment xml:lang="en">
