      <rdfs:label>em_buffer_component.concentration_units</rdfs:label>
      <rdfs:comment xml:lang="en">
Units for the sample concentration value.
mg/mL
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_buffer_component.formula">
      <rdfs:subPropertyOf rdf:resource="#em_buffer_componentItem"/>
