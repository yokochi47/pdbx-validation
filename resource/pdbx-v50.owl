      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#pdbx_view_category_group"/>
      <rdfs:domain rdf:resource="#pdbx_view_category_groupCategory"/>
      <rdfs:range rdf:resource="#pdbx_view_category_group"/>
   </owl:InverseFunctionalProperty>
