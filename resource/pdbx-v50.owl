   <owl:Class rdf:ID="pdbx_entity_branch_descriptor">
      <rdfs:label>pdbx_entity_branch_descriptor</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_ENTITY_BRANCH_DESCRIPTOR category provide
string descriptors of entity chemical structure.

    Example 1 -
&lt;PDBx:pdbx_entity_branch_descriptorCategory&gt;
   &lt;PDBx:pdbx_entity_branch_descriptor ordinal="1"&gt;
      &lt;PDBx:descriptor&gt;[][Asn]{[(4+1)][b-D-GlcpNAc]{[(4+1)][b-D-GlcpNAc]{[(4+1)][b-D-Manp]{[(3+1)][a-D-Manp]{[(2+1)][a-D-Manp]{[(2+1)][a-D-Manp]{}}}[(6+1)][a-D-Manp]{[(3+1)][a-D-Manp]{[(2+1)][a-D-Manp]{}}[(6+1)][a-D-Manp]{[(2+1)][a-D-Manp]{}}}}}}}&lt;/PDBx:descriptor&gt;
      &lt;PDBx:entity_id&gt;1&lt;/PDBx:entity_id&gt;
      &lt;PDBx:program&gt;PDB-CARE&lt;/PDBx:program&gt;
      &lt;PDBx:program_version&gt;Beta&lt;/PDBx:program_version&gt;
      &lt;PDBx:type&gt;LINUCS&lt;/PDBx:type&gt;
   &lt;/PDBx:pdbx_entity_branch_descriptor&gt;
&lt;/PDBx:pdbx_entity_branch_descriptorCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_descriptor.descriptor"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_descriptor.descriptor"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_descriptor.entity_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_descriptor.entity_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_descriptor.program"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_descriptor.program"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_descriptor.program_version"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_descriptor.program_version"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_descriptor.type"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_descriptor.type"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_descriptor.ordinal"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_pdbx_entity_branch_descriptorCategory">
      <rdfs:label>pdbx_entity_branch_descriptorCategory</rdfs:label>
