   <owl:DatatypeProperty rdf:ID="pdbx_chem_comp_nonstandard.type">
      <rdfs:subPropertyOf rdf:resource="#pdbx_chem_comp_nonstandardItem"/>
      <rdfs:domain rdf:resource="#pdbx_chem_comp_nonstandard"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base modification</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sugar modification</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">phosphate modification</rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
This data item describes modification  type.
                     </rdfs:comment>
   </owl:DatatypeProperty>
