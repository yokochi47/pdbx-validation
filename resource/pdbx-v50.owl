        has a category holder database_PDB_revCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#database_PDB_rev"/>
   </owl:InverseFunctionalProperty>
