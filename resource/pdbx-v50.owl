      <rdfs:comment xml:lang="en">
The role of this author in the project depositing this data.
principal investigator/group leader
responsible scientist
investigator
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_contact_author.state_province">
      <rdfs:subPropertyOf rdf:resource="#pdbx_contact_authorItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_contact_author.state_province</rdfs:label>
      <rdfs:comment xml:lang="en">
The mailing address of the author of the data block to whom
correspondence should be addressed, state or province.
                             New Jersey
                        </rdfs:comment>
   </owl:DatatypeProperty>
