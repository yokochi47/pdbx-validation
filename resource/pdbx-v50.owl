      <rdfs:label>referenced_by_pdbx_chem_comp_atom_feature</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from pdbx_chem_comp_atom_feature.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#pdbx_chem_comp_atom_feature"/>
   </owl:ObjectProperty>
