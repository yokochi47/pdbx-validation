        has a category holder pdbx_crystal_alignmentCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#pdbx_crystal_alignment"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_pdbx_crystal_alignment">
      <rdfs:label>pdbx_crystal_alignmentCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that pdbx_crystal_alignmentCategory.
        has a category pdbx_crystal_alignment.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#pdbx_crystal_alignment"/>
      <rdfs:domain rdf:resource="#pdbx_crystal_alignmentCategory"/>
      <rdfs:range rdf:resource="#pdbx_crystal_alignment"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_crystal_alignmentItem">
      <rdfs:label>pdbx_crystal_alignmentItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for pdbx_crystal_alignment items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#pdbx_crystal_alignment"/>
   </owl:DatatypeProperty>
