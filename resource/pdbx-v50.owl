      &lt;PDBx:resource_accession&gt;FRAG_001&lt;/PDBx:resource_accession&gt;
      &lt;PDBx:resource_name&gt;PDB&lt;/PDBx:resource_name&gt;
      &lt;PDBx:type&gt;Fragment Screening&lt;/PDBx:type&gt;
   &lt;/PDBx:pdbx_investigation&gt;
&lt;/PDBx:pdbx_investigationCategory&gt;


         </rdfs:comment>
