      <rdfs:comment xml:lang="en">cross-reference to em_map.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#em_map"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_em_map">
      <rdfs:label>referenced_by_em_map</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from em_map.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#em_map"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="em_map.annotation_details">
      <rdfs:subPropertyOf rdf:resource="#em_mapItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_map.annotation_details</rdfs:label>
      <rdfs:comment xml:lang="en">
map annotation details
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_map.axis_order_fast">
      <rdfs:subPropertyOf rdf:resource="#em_mapItem"/>
      <rdfs:domain rdf:resource="#em_map"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Y</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Z</rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
The map axis that corresponds to Columns.
(CCP4 HEADER WORD 17 MAPC 1=x, 2=y, 3=z)
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_map.axis_order_medium">
      <rdfs:subPropertyOf rdf:resource="#em_mapItem"/>
      <rdfs:domain rdf:resource="#em_map"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Y</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Z</rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
The map axis that corresponds to Rows.
(CCP4 map header word 18 MAPR 1=x, 2=y, 3=z)
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_map.axis_order_slow">
      <rdfs:subPropertyOf rdf:resource="#em_mapItem"/>
      <rdfs:domain rdf:resource="#em_map"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X</rdf:first>
                  <rdf:rest>
