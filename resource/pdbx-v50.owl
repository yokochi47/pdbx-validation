   <owl:DatatypeProperty rdf:ID="ndb_struct_na_base_pair.hbond_type_leontis_westhof">
      <rdfs:subPropertyOf rdf:resource="#ndb_struct_na_base_pairItem"/>
      <rdfs:domain rdf:resource="#ndb_struct_na_base_pair"/>
      <rdfs:range>
         <owl:DataRange>
