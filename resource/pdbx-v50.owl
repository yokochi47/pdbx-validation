        has a category holder refine_ls_shellCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#refine_ls_shell"/>
   </owl:InverseFunctionalProperty>
