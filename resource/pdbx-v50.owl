   <owl:DatatypeProperty rdf:ID="geom_hbond.angle_DHA">
      <rdfs:subPropertyOf rdf:resource="#geom_hbondItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>geom_hbond.angle_DHA</rdfs:label>
      <rdfs:comment xml:lang="en">
The angle in degrees defined by the donor-, hydrogen- and
acceptor-atom sites in a hydrogen bond.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="geom_hbond.angle_DHA_esd">
      <rdfs:subPropertyOf rdf:resource="#geom_hbondItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>geom_hbond.angle_DHA_esd</rdfs:label>
      <rdfs:comment xml:lang="en">
The standard uncertainty (estimated standard deviation)
of attribute angle_DHA in category geom_hbond. 
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="geom_hbond.atom_site_auth_asym_id_A">
      <rdfs:subPropertyOf rdf:resource="#geom_hbondItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>geom_hbond.atom_site_auth_asym_id_A</rdfs:label>
      <rdfs:comment xml:lang="en">
An optional identifier of the acceptor-atom site that defines
the hydrogen bond.

This data item is a pointer to attribute auth_asym_id in category atom_site in the
 ATOM_SITE category.
                        </rdfs:comment>
   </owl:DatatypeProperty>
