   <owl:DatatypeProperty rdf:ID="publ_manuscript_inclItem">
      <rdfs:label>publ_manuscript_inclItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for publ_manuscript_incl items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#publ_manuscript_incl"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_publ_manuscript_incl">
      <rdfs:label>reference_to_publ_manuscript_incl</rdfs:label>
