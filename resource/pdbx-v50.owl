   <owl:DatatypeProperty rdf:ID="pdbx_reference_molecule_related_structures.db_name">
      <rdfs:subPropertyOf rdf:resource="#pdbx_reference_molecule_related_structuresItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_reference_molecule_related_structures.db_name</rdfs:label>
