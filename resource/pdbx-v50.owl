   <owl:Class rdf:ID="pdbx_nonpoly_scheme">
      <rdfs:label>pdbx_nonpoly_scheme</rdfs:label>
      <rdfs:comment xml:lang="en">
The PDBX_NONPOLY_SCHEME category provides residue level nomenclature
mapping for non-polymer entities.

    Example 1 -
&lt;PDBx:pdbx_nonpoly_schemeCategory&gt;
   &lt;PDBx:pdbx_nonpoly_scheme asym_id="C" ndb_seq_num="100"&gt;
      &lt;PDBx:auth_mon_id&gt;HOH&lt;/PDBx:auth_mon_id&gt;
      &lt;PDBx:auth_seq_num&gt;100&lt;/PDBx:auth_seq_num&gt;
      &lt;PDBx:entity_id&gt;3&lt;/PDBx:entity_id&gt;
      &lt;PDBx:mon_id&gt;HOH&lt;/PDBx:mon_id&gt;
      &lt;PDBx:pdb_ins_code xsi:nil="true" /&gt;
      &lt;PDBx:pdb_mon_id&gt;HOH&lt;/PDBx:pdb_mon_id&gt;
      &lt;PDBx:pdb_seq_num&gt;100&lt;/PDBx:pdb_seq_num&gt;
      &lt;PDBx:pdb_strand_id&gt;C&lt;/PDBx:pdb_strand_id&gt;
   &lt;/PDBx:pdbx_nonpoly_scheme&gt;
&lt;/PDBx:pdbx_nonpoly_schemeCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonpoly_scheme.auth_mon_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonpoly_scheme.auth_mon_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonpoly_scheme.auth_seq_num"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonpoly_scheme.auth_seq_num"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonpoly_scheme.entity_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonpoly_scheme.entity_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonpoly_scheme.mon_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonpoly_scheme.mon_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonpoly_scheme.pdb_ins_code"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonpoly_scheme.pdb_ins_code"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonpoly_scheme.pdb_mon_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonpoly_scheme.pdb_mon_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonpoly_scheme.pdb_seq_num"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonpoly_scheme.pdb_seq_num"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonpoly_scheme.pdb_strand_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonpoly_scheme.pdb_strand_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonpoly_scheme.asym_id"/>
