      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_mask_depositor_info.pixel_spacing_y</rdfs:label>
      <rdfs:comment xml:lang="en">
The length in angstroms of one voxel along the Y axis.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_mask_depositor_info.pixel_spacing_z">
      <rdfs:subPropertyOf rdf:resource="#em_mask_depositor_infoItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_mask_depositor_info.pixel_spacing_z</rdfs:label>
      <rdfs:comment xml:lang="en">
The length in angstroms of one voxel along the Z axis.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_mask_depositor_info.upload_file_name">
      <rdfs:subPropertyOf rdf:resource="#em_mask_depositor_infoItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_mask_depositor_info.upload_file_name</rdfs:label>
      <rdfs:comment xml:lang="en">
The name of a file containing the map.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_mask_depositor_info.upload_format">
      <rdfs:subPropertyOf rdf:resource="#em_mask_depositor_infoItem"/>
      <rdfs:domain rdf:resource="#em_mask_depositor_info"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CCP4/MRC</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SPIDER</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
map format
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_mask_depositor_info.id">
      <rdfs:subPropertyOf rdf:resource="#em_mask_depositor_infoItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_mask_depositor_info.id</rdfs:label>
      <rdfs:comment xml:lang="en">
Unique identifier for each map listed.
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="em_motion_correctionCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_em_motion_correction"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="em_motion_correction">
      <rdfs:label>em_motion_correction</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the EM_MOTION_CORRECTION category record details
corrections made during imaging the sample in the electron microscope.
  Example 1
                structure corresponding to PDB entry 1DYL
&lt;PDBx:em_motion_correctionCategory&gt;
   &lt;PDBx:em_motion_correction id="1"&gt;
      &lt;PDBx:image_processing_id&gt;1&lt;/PDBx:image_processing_id&gt;
      &lt;PDBx:type&gt;NONE&lt;/PDBx:type&gt;
   &lt;/PDBx:em_motion_correction&gt;
&lt;/PDBx:em_motion_correctionCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_motion_correction.details"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_motion_correction.details"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_motion_correction.image_processing_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_motion_correction.image_processing_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_motion_correction.type"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_motion_correction.type"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_motion_correction.id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_em_motion_correctionCategory">
      <rdfs:label>em_motion_correctionCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that datablock
        has a category holder em_motion_correctionCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#em_motion_correction"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_em_motion_correction">
      <rdfs:label>em_motion_correctionCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that em_motion_correctionCategory.
        has a category em_motion_correction.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#em_motion_correction"/>
      <rdfs:domain rdf:resource="#em_motion_correctionCategory"/>
      <rdfs:range rdf:resource="#em_motion_correction"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="em_motion_correctionItem">
      <rdfs:label>em_motion_correctionItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for em_motion_correction items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#em_motion_correction"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_em_motion_correction">
      <rdfs:label>reference_to_em_motion_correction</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to em_motion_correction.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#em_motion_correction"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_em_motion_correction">
      <rdfs:label>referenced_by_em_motion_correction</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from em_motion_correction.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#em_motion_correction"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="em_motion_correction.details">
      <rdfs:subPropertyOf rdf:resource="#em_motion_correctionItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_motion_correction.details</rdfs:label>
      <rdfs:comment xml:lang="en">
A description of the motion correction operation in more detail
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_motion_correction.image_processing_id">
      <rdfs:subPropertyOf rdf:resource="#em_motion_correctionItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_motion_correction.image_processing_id</rdfs:label>
      <rdfs:comment xml:lang="en">
pointer to attribute id in category em_image_processing in the EM_IMAGE_PROCESSING category. 
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_motion_correction.type">
      <rdfs:subPropertyOf rdf:resource="#em_motion_correctionItem"/>
      <rdfs:domain rdf:resource="#em_motion_correction"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NONE</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WHOLE MICROGRAPH</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MICROGRAPH PATCHES</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PER PARTICLE</rdf:first>
                                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
Type of motion correction carried out
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_motion_correction.id">
      <rdfs:subPropertyOf rdf:resource="#em_motion_correctionItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_motion_correction.id</rdfs:label>
      <rdfs:comment xml:lang="en">
PRIMARY KEY
                     </rdfs:comment>
   </owl:DatatypeProperty>
