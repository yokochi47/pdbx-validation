   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="em_grid_pretreatment.atmosphere">
      <rdfs:subPropertyOf rdf:resource="#em_grid_pretreatmentItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_grid_pretreatment.atmosphere</rdfs:label>
      <rdfs:comment xml:lang="en">
The atmosphere used for glow discharge of the em grid.
AIR
AMYLAMINE
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_grid_pretreatment.pressure">
      <rdfs:subPropertyOf rdf:resource="#em_grid_pretreatmentItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_grid_pretreatment.pressure</rdfs:label>
      <rdfs:comment xml:lang="en">
Pressure of the glow discharge chamber, in pascals
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_grid_pretreatment.sample_support_id">
      <rdfs:subPropertyOf rdf:resource="#em_grid_pretreatmentItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_grid_pretreatment.sample_support_id</rdfs:label>
      <rdfs:comment xml:lang="en">
Pointer to EM SAMPLE SUPPORT
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_grid_pretreatment.time">
      <rdfs:subPropertyOf rdf:resource="#em_grid_pretreatmentItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_grid_pretreatment.time</rdfs:label>
      <rdfs:comment xml:lang="en">
Time period for glow discharge of the em grid, in seconds
60
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_grid_pretreatment.type">
      <rdfs:subPropertyOf rdf:resource="#em_grid_pretreatmentItem"/>
      <rdfs:domain rdf:resource="#em_grid_pretreatment"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GLOW DISCHARGE</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PLASMA CLEANING</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
Type of grid pretreatment
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_grid_pretreatment.id">
      <rdfs:subPropertyOf rdf:resource="#em_grid_pretreatmentItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_grid_pretreatment.id</rdfs:label>
      <rdfs:comment xml:lang="en">
PRIMARY KEY
                     </rdfs:comment>
   </owl:DatatypeProperty>
