   <owl:Class rdf:ID="pdbx_entity_name_instance">
      <rdfs:label>pdbx_entity_name_instance</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_ENTITY_NAME_INSTANCE category
list names used to define entities with their
associated database, entity, chain, and molecule
identifiers.
&lt;PDBx:pdbx_entity_name_instanceCategory&gt;
   &lt;PDBx:pdbx_entity_name_instance entity_id="1" name="ALCOHOL DEHYDROGENASE" pdb_id="1B2L"&gt;
      &lt;PDBx:pdb_chain_id&gt;A&lt;/PDBx:pdb_chain_id&gt;
      &lt;PDBx:pdb_mol_id&gt;1&lt;/PDBx:pdb_mol_id&gt;
      &lt;PDBx:rcsb_id&gt;RCSB000146&lt;/PDBx:rcsb_id&gt;
   &lt;/PDBx:pdbx_entity_name_instance&gt;
&lt;/PDBx:pdbx_entity_name_instanceCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_name_instance.pdb_chain_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_name_instance.pdb_chain_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_name_instance.pdb_mol_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_name_instance.pdb_mol_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_name_instance.rcsb_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_name_instance.rcsb_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_name_instance.entity_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
