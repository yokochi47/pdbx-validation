      &lt;PDBx:protein_phi_angle_constraints_total_count&gt;96&lt;/PDBx:protein_phi_angle_constraints_total_count&gt;
   &lt;/PDBx:pdbx_nmr_constraints&gt;
&lt;/PDBx:pdbx_nmr_constraintsCategory&gt;


