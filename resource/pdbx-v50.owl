   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_density.space_group_pointless">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_densityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_dcc_density.space_group_pointless</rdfs:label>
      <rdfs:comment xml:lang="en">
Hermann-Mauguin space-group symbol calculated by the POINTLESS
