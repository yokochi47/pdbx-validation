      <rdfs:label>entity_name_sysItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for entity_name_sys items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#entity_name_sys"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_entity_name_sys">
      <rdfs:label>reference_to_entity_name_sys</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to entity_name_sys.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#entity_name_sys"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_entity_name_sys">
      <rdfs:label>referenced_by_entity_name_sys</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from entity_name_sys.</rdfs:comment>
