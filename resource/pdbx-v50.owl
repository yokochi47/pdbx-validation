      <rdfs:label>pdbx_reference_molecule_annotation.type</rdfs:label>
      <rdfs:comment xml:lang="en">
Type of annotation for this entity.
Function
Use
Pharmacology
Mechanism_of_Action
Biological_Activity
Inhibitor_Class
Therapeutic_Category
Research_Use
Other_annotation
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_reference_molecule_annotation.family_prd_id">
