      <rdfs:label>em_final_classificationCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that em_final_classificationCategory.
        has a category em_final_classification.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#em_final_classification"/>
      <rdfs:domain rdf:resource="#em_final_classificationCategory"/>
