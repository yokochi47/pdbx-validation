                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_struct_assembly_gen_depositor_info.helical_rotation">
      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_assembly_gen_depositor_infoItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
