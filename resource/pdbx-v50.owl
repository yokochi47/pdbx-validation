   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="struct_mon_nucl.tau3">
      <rdfs:subPropertyOf rdf:resource="#struct_mon_nuclItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>struct_mon_nucl.tau3</rdfs:label>
      <rdfs:comment xml:lang="en">
The value in degrees of the sugar torsion angle tau3
(C2'-C3'-C4'-O4').
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="struct_mon_nucl.tau4">
      <rdfs:subPropertyOf rdf:resource="#struct_mon_nuclItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>struct_mon_nucl.tau4</rdfs:label>
      <rdfs:comment xml:lang="en">
The value in degrees of the sugar torsion angle tau4
(C3'-C4'-O4'-C1').
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="struct_mon_nucl.taum">
      <rdfs:subPropertyOf rdf:resource="#struct_mon_nuclItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>struct_mon_nucl.taum</rdfs:label>
      <rdfs:comment xml:lang="en">
The maximum amplitude of puckering. This is derived from the
pseudorotation value P and the torsion angles in the ribose
ring.

Tau2= Taum cosP
Tau3= Taum cos(P+144)
Tau4= Taum cos(P+288)
Tau0= Taum cos(P+ 72)
Tau1= Taum cos(P+216)
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="struct_mon_nucl.zeta">
      <rdfs:subPropertyOf rdf:resource="#struct_mon_nuclItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>struct_mon_nucl.zeta</rdfs:label>
      <rdfs:comment xml:lang="en">
The value in degrees of the backbone torsion angle zeta
(C3'-O3'-P-O5').
                        </rdfs:comment>
   </owl:DatatypeProperty>
