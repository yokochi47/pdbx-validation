      <rdfs:label>referenced_by_pdbx_serial_crystallography_measurement</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from pdbx_serial_crystallography_measurement.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
