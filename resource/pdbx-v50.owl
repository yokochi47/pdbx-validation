               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#entity_poly.pdbx_seq_one_letter_code_can"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
