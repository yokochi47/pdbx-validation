   <owl:DatatypeProperty rdf:ID="pdbx_exptl_crystal_cryo_treatment.annealing_details">
      <rdfs:subPropertyOf rdf:resource="#pdbx_exptl_crystal_cryo_treatmentItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_exptl_crystal_cryo_treatment.annealing_details</rdfs:label>
      <rdfs:comment xml:lang="en">
Details of the annealing treatment applied to this crystal.
 10 sec interruption of cold stream with plastic ruler.
  Performed twice.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_exptl_crystal_cryo_treatment.cooling_details">
      <rdfs:subPropertyOf rdf:resource="#pdbx_exptl_crystal_cryo_treatmentItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_exptl_crystal_cryo_treatment.cooling_details</rdfs:label>
      <rdfs:comment xml:lang="en">
Details of the cooling treatment applied to this crystal.
  Direct immersion in liquid nitrogen
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_exptl_crystal_cryo_treatment.cryogen">
      <rdfs:subPropertyOf rdf:resource="#pdbx_exptl_crystal_cryo_treatmentItem"/>
      <rdfs:domain rdf:resource="#pdbx_exptl_crystal_cryo_treatment"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ETHANE</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NITROGEN</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OTHER</rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
The name of cryogen used for vitrification
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_exptl_crystal_cryo_treatment.final_solution_details">
      <rdfs:subPropertyOf rdf:resource="#pdbx_exptl_crystal_cryo_treatmentItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_exptl_crystal_cryo_treatment.final_solution_details</rdfs:label>
      <rdfs:comment xml:lang="en">
Details of the final solution used in the treatment of this crystal
 25% (v/v) glycerol in precipitant solution
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_exptl_crystal_cryo_treatment.soaking_details">
      <rdfs:subPropertyOf rdf:resource="#pdbx_exptl_crystal_cryo_treatmentItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_exptl_crystal_cryo_treatment.soaking_details</rdfs:label>
      <rdfs:comment xml:lang="en">
Details of the soaking treatment applied to this crystal.
  A series of 1 min soaks beginning at 5% (v/v) glycerol in precipitant,
   transiting to 20% (v/v) glycerol, and finally to 25% glycerol
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_exptl_crystal_cryo_treatment.crystal_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_exptl_crystal_cryo_treatmentItem"/>
