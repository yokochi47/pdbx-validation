   <owl:DatatypeProperty rdf:ID="pdbx_nmr_force_constants.covalent_geom_angles_term">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nmr_force_constantsItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_nmr_force_constants.covalent_geom_angles_term</rdfs:label>
      <rdfs:comment xml:lang="en">
The final force constant for covalent geometry angle constraints
term employed in the target function used for simulated annealing.
500
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nmr_force_constants.covalent_geom_angles_term_units">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nmr_force_constantsItem"/>
      <rdfs:domain rdf:resource="#pdbx_nmr_force_constants"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kcal/mol/rad**2</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kJ/mol/rad**2</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">other</rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
The units for the force constant for the covalent geometry angle
constraints term.
kcal/mol/rad**2
                        </rdfs:comment>
   </owl:DatatypeProperty>
