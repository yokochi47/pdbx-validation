      <rdfs:comment xml:lang="en">Abstract datatype property for pdbx_entity_remapping items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#pdbx_entity_remapping"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_pdbx_entity_remapping">
      <rdfs:label>reference_to_pdbx_entity_remapping</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to pdbx_entity_remapping.</rdfs:comment>
