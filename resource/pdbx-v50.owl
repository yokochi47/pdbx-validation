               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_pdbx_serial_crystallography_data_reduction"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
