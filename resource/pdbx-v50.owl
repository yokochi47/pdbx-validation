   <owl:Class rdf:ID="pdbx_helical_symmetry">
      <rdfs:label>pdbx_helical_symmetry</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_HELICAL_SYMMETRY category record details about the
helical symmetry group associated with this entry.

    Example 1 -
&lt;PDBx:pdbx_helical_symmetryCategory&gt;
   &lt;PDBx:pdbx_helical_symmetry entry_id="1ABC"&gt;
      &lt;PDBx:circular_symmetry&gt;1&lt;/PDBx:circular_symmetry&gt;
      &lt;PDBx:dyad_axis&gt;no&lt;/PDBx:dyad_axis&gt;
      &lt;PDBx:n_subunits_divisor&gt;1&lt;/PDBx:n_subunits_divisor&gt;
      &lt;PDBx:number_of_operations&gt;35&lt;/PDBx:number_of_operations&gt;
      &lt;PDBx:rise_per_n_subunits&gt;6.10&lt;/PDBx:rise_per_n_subunits&gt;
      &lt;PDBx:rotation_per_n_subunits&gt;131.84&lt;/PDBx:rotation_per_n_subunits&gt;
   &lt;/PDBx:pdbx_helical_symmetry&gt;
&lt;/PDBx:pdbx_helical_symmetryCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.circular_symmetry"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.circular_symmetry"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.dyad_axis"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.dyad_axis"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.n_subunits_divisor"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.n_subunits_divisor"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.number_of_operations"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.number_of_operations"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.rise_per_n_subunits"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.rise_per_n_subunits"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.rotation_per_n_subunits"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.rotation_per_n_subunits"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.entry_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
