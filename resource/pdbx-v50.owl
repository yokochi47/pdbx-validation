        has a category holder pdbx_solvent_infoCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#pdbx_solvent_info"/>
   </owl:InverseFunctionalProperty>
