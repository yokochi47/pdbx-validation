        has a category holder struct_ncs_ensCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#struct_ncs_ens"/>
   </owl:InverseFunctionalProperty>
