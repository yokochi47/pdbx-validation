   <owl:DatatypeProperty rdf:ID="struct_sheet_range.pdbx_beg_PDB_ins_code">
      <rdfs:subPropertyOf rdf:resource="#struct_sheet_rangeItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
