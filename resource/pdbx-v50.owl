   <owl:DatatypeProperty rdf:ID="pdbx_reference_molecule.type_evidence_code">
      <rdfs:subPropertyOf rdf:resource="#pdbx_reference_moleculeItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_reference_molecule.type_evidence_code</rdfs:label>
