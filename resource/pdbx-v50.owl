      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#publ_manuscript_incl"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_publ_manuscript_incl">
      <rdfs:label>referenced_by_publ_manuscript_incl</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from publ_manuscript_incl.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#publ_manuscript_incl"/>
