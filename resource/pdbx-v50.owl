      <rdfs:comment xml:lang="en">
Twin operators determined by REFMAC.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_density.twin_operator_xtriage">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_densityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_dcc_density.twin_operator_xtriage</rdfs:label>
      <rdfs:comment xml:lang="en">
A list of the twin operators determined by Xtriage.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_density.twin_type">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_densityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_dcc_density.twin_type</rdfs:label>
      <rdfs:comment xml:lang="en">
Type of twin (merohedral,Pseudo-merohedral or non-merohedral)
determined by Xtriage.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_density.unit_cell">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_densityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_dcc_density.unit_cell</rdfs:label>
      <rdfs:comment xml:lang="en">
The unit cell parameters (a b c alpha beta gamma) separated
by a space.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_density.wavelength">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_densityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_dcc_density.wavelength</rdfs:label>
      <rdfs:comment xml:lang="en">
The wavelength reported from the model file.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_density.working_set_count">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_densityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_dcc_density.working_set_count</rdfs:label>
      <rdfs:comment xml:lang="en">
The number of unique reflections for refinement (working set)
