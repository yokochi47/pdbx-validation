      <rdfs:subPropertyOf rdf:resource="#pdbx_chem_comp_atom_editItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_chem_comp_atom_edit.edit_atom_id</rdfs:label>
