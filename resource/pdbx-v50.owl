      <rdfs:seeAlso rdf:resource="#database_PDB_remark"/>
      <rdfs:domain rdf:resource="#database_PDB_remarkCategory"/>
      <rdfs:range rdf:resource="#database_PDB_remark"/>
   </owl:InverseFunctionalProperty>
