   <owl:DatatypeProperty rdf:ID="pdbx_chem_comp_depositor_info.descriptor_type">
      <rdfs:subPropertyOf rdf:resource="#pdbx_chem_comp_depositor_infoItem"/>
      <rdfs:domain rdf:resource="#pdbx_chem_comp_depositor_info"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SMILES</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InChI</rdf:first>
                        <rdf:rest>
