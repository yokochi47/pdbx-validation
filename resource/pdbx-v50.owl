      <rdfs:label>pdbx_entity_src_gen_prod_pcr.step_id</rdfs:label>
      <rdfs:comment xml:lang="en">
This item is the unique identifier for this PCR step.
                     </rdfs:comment>
   </owl:DatatypeProperty>
