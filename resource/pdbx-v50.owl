      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#pdbx_view_item"/>
      <rdfs:domain rdf:resource="#pdbx_view_itemCategory"/>
      <rdfs:range rdf:resource="#pdbx_view_item"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_view_itemItem">
      <rdfs:label>pdbx_view_itemItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for pdbx_view_item items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#pdbx_view_item"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_pdbx_view_item">
      <rdfs:label>reference_to_pdbx_view_item</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to pdbx_view_item.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#pdbx_view_item"/>
   </owl:ObjectProperty>
