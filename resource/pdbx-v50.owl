   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_struct_assembly_depositor_info.details">
      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_assembly_depositor_infoItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_struct_assembly_depositor_info.details</rdfs:label>
      <rdfs:comment xml:lang="en">
A description of special aspects of the macromolecular assembly.
                                The icosahedral virus particle.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_struct_assembly_depositor_info.matrix_flag">
      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_assembly_depositor_infoItem"/>
      <rdfs:domain rdf:resource="#pdbx_struct_assembly_depositor_info"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Y</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
A flag to indicate that the depositor has provided matrix records
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_struct_assembly_depositor_info.method_details">
      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_assembly_depositor_infoItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_struct_assembly_depositor_info.method_details</rdfs:label>
      <rdfs:comment xml:lang="en">
Provides details of the method used to determine or
compute the assembly.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_struct_assembly_depositor_info.oligomeric_count">
      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_assembly_depositor_infoItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_struct_assembly_depositor_info.oligomeric_count</rdfs:label>
      <rdfs:comment xml:lang="en">
The number of polymer molecules in the assembly.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_struct_assembly_depositor_info.oligomeric_details">
      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_assembly_depositor_infoItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_struct_assembly_depositor_info.oligomeric_details</rdfs:label>
      <rdfs:comment xml:lang="en">
Provides the details of the oligomeric state of the assembly.
monomer
octameric
tetradecameric
eicosameric
21-meric
60-meric
180-meric
helical
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_struct_assembly_depositor_info.upload_file_name">
      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_assembly_depositor_infoItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_struct_assembly_depositor_info.upload_file_name</rdfs:label>
      <rdfs:comment xml:lang="en">
The name of a file containing matrix records.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_struct_assembly_depositor_info.id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_assembly_depositor_infoItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_struct_assembly_depositor_info.id</rdfs:label>
      <rdfs:comment xml:lang="en">
The value of attribute id in category pdbx_struct_assembly_depositor_info must uniquely identify a record in
 the PDBX_STRUCT_ASSEMBLY_DEPOSITOR_INFO list.
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="pdbx_struct_assembly_genCategory">
