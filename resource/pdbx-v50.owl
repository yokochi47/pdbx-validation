   <owl:Class rdf:ID="em_entity_assembly_molwtCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_em_entity_assembly_molwt"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="em_entity_assembly_molwt">
      <rdfs:label>em_entity_assembly_molwt</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in this category record details about the molecular weight of
an assembly component of the sample.
 Example 1 - based on PDB entry 1DYL and laboratory records for the
             structure corresponding to PDB entry 1DYL
&lt;PDBx:em_entity_assembly_molwtCategory&gt;
   &lt;PDBx:em_entity_assembly_molwt entity_assembly_id="1" id="1"&gt;
      &lt;PDBx:units&gt;MEGADALTONS&lt;/PDBx:units&gt;
      &lt;PDBx:value&gt;30.5&lt;/PDBx:value&gt;
   &lt;/PDBx:em_entity_assembly_molwt&gt;
&lt;/PDBx:em_entity_assembly_molwtCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_entity_assembly_molwt.experimental_flag"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_entity_assembly_molwt.experimental_flag"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_entity_assembly_molwt.method"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_entity_assembly_molwt.method"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_entity_assembly_molwt.units"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_entity_assembly_molwt.units"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_entity_assembly_molwt.value"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_entity_assembly_molwt.value"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_entity_assembly_molwt.entity_assembly_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_entity_assembly_molwt.id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_em_entity_assembly_molwtCategory">
