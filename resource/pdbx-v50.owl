      <rdfs:label>pdbx_entity_src_gen_refold.date</rdfs:label>
      <rdfs:comment xml:lang="en">
The date of this production step.
2003-12-25
2003-12-25:09:00
                        </rdfs:comment>
   </owl:DatatypeProperty>
