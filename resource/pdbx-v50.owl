      <rdfs:label>pdbx_serial_crystallography_measurementItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for pdbx_serial_crystallography_measurement items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#pdbx_serial_crystallography_measurement"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_pdbx_serial_crystallography_measurement">
      <rdfs:label>reference_to_pdbx_serial_crystallography_measurement</rdfs:label>
