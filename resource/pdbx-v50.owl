   <owl:DatatypeProperty rdf:ID="pdbx_nmr_ensemble_rms.atom_type">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nmr_ensemble_rmsItem"/>
      <rdfs:domain rdf:resource="#pdbx_nmr_ensemble_rms"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">backbone heavy atoms</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">side chain heavy atoms</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">all heavy atoms</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">all atoms</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">all backbone atoms</rdf:first>
                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
Statistics are often calculated over only some of the atoms,
e.g. backbone, or heavy atoms. Describe which type of atoms are used for
the statistical analysis.
backbone atoms
heavy atoms
                        </rdfs:comment>
   </owl:DatatypeProperty>
