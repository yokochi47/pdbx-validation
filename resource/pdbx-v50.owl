      <rdfs:range rdf:resource="#pdbx_seq_map_depositor_info"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_seq_map_depositor_infoItem">
      <rdfs:label>pdbx_seq_map_depositor_infoItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for pdbx_seq_map_depositor_info items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#pdbx_seq_map_depositor_info"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_pdbx_seq_map_depositor_info">
      <rdfs:label>reference_to_pdbx_seq_map_depositor_info</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to pdbx_seq_map_depositor_info.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#pdbx_seq_map_depositor_info"/>
   </owl:ObjectProperty>
