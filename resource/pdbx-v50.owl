      &lt;PDBx:label_seq_id&gt;77&lt;/PDBx:label_seq_id&gt;
      &lt;PDBx:pdbx_PDB_model_num&gt;1&lt;/PDBx:pdbx_PDB_model_num&gt;
   &lt;/PDBx:struct_mon_prot_cis&gt;
   &lt;PDBx:struct_mon_prot_cis pdbx_id="3"&gt;
