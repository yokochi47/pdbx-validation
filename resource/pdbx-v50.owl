   <owl:Class rdf:ID="pdbx_nmr_refineCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_pdbx_nmr_refine"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="pdbx_nmr_refine">
      <rdfs:label>pdbx_nmr_refine</rdfs:label>
      <rdfs:comment xml:lang="en">

Describe the method and details of the refinement of the deposited structure.
   This example is drawn from the MCP-1 structure.
&lt;PDBx:pdbx_nmr_refineCategory&gt;
   &lt;PDBx:pdbx_nmr_refine entry_id="1ABC" software_ordinal="1"&gt;
      &lt;PDBx:method&gt;torsion angle dynamics&lt;/PDBx:method&gt;
   &lt;/PDBx:pdbx_nmr_refine&gt;
&lt;/PDBx:pdbx_nmr_refineCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
