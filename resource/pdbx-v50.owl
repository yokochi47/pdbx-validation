      &lt;PDBx:comp_id&gt;NAG&lt;/PDBx:comp_id&gt;
      &lt;PDBx:name&gt;N-acetyl glucosamine&lt;/PDBx:name&gt;
   &lt;/PDBx:pdbx_reference_linked_entity_comp_list&gt;
   &lt;PDBx:pdbx_reference_linked_entity_comp_list linked_entity_id="0" list_id="2"&gt;
      &lt;PDBx:comp_id&gt;NAG&lt;/PDBx:comp_id&gt;
