      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="pdbx_nmr_assigned_chem_shift_list">
      <rdfs:label>pdbx_nmr_assigned_chem_shift_list</rdfs:label>
      <rdfs:comment xml:lang="en">

Items in the assigned_chem_shift_list category provide information about a list of reported assigned chemical shift values.

         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_assigned_chem_shift_list.chem_shift_13C_err"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
