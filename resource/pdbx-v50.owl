      <rdfs:subPropertyOf rdf:resource="#struct_sheet_rangeItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>struct_sheet_range.pdbx_end_PDB_ins_code</rdfs:label>
