   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_solvent_info.name">
      <rdfs:subPropertyOf rdf:resource="#pdbx_solvent_infoItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_solvent_info.name</rdfs:label>
      <rdfs:comment xml:lang="en">
Name of solvent.
WATER
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_solvent_info.numb_per_asym_unit">
      <rdfs:subPropertyOf rdf:resource="#pdbx_solvent_infoItem"/>
