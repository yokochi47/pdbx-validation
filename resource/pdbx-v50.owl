   <owl:DatatypeProperty rdf:ID="em_virus_entityItem">
      <rdfs:label>em_virus_entityItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for em_virus_entity items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#em_virus_entity"/>
   </owl:DatatypeProperty>
