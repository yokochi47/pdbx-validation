                  <owl:onProperty rdf:resource="#has_pdbx_diffrn_cell"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="pdbx_diffrn_cell">
      <rdfs:label>pdbx_diffrn_cell</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_DIFFRN_CELL category record details about
a particular set of unit cell parameters.

    Example 1 - based on 6W01.
&lt;PDBx:pdbx_diffrn_cellCategory&gt;
   &lt;PDBx:pdbx_diffrn_cell id="1"&gt;
      &lt;PDBx:angle_alpha&gt;90.00&lt;/PDBx:angle_alpha&gt;
      &lt;PDBx:angle_alpha_esd&gt;0.0&lt;/PDBx:angle_alpha_esd&gt;
      &lt;PDBx:angle_beta&gt;90.00&lt;/PDBx:angle_beta&gt;
      &lt;PDBx:angle_beta_esd&gt;0.0&lt;/PDBx:angle_beta_esd&gt;
      &lt;PDBx:angle_gamma&gt;120.00&lt;/PDBx:angle_gamma&gt;
      &lt;PDBx:angle_gamma_esd&gt;0.0&lt;/PDBx:angle_gamma_esd&gt;
      &lt;PDBx:length_a&gt;150.672&lt;/PDBx:length_a&gt;
      &lt;PDBx:length_a_esd&gt;0.042&lt;/PDBx:length_a_esd&gt;
      &lt;PDBx:length_b&gt;150.672&lt;/PDBx:length_b&gt;
      &lt;PDBx:length_b_esd&gt;0.042&lt;/PDBx:length_b_esd&gt;
      &lt;PDBx:length_c&gt;111.477&lt;/PDBx:length_c&gt;
      &lt;PDBx:length_c_esd&gt;0.160&lt;/PDBx:length_c_esd&gt;
   &lt;/PDBx:pdbx_diffrn_cell&gt;
   &lt;PDBx:pdbx_diffrn_cell id="2"&gt;
      &lt;PDBx:angle_alpha&gt;90.00&lt;/PDBx:angle_alpha&gt;
      &lt;PDBx:angle_alpha_esd&gt;0.0&lt;/PDBx:angle_alpha_esd&gt;
      &lt;PDBx:angle_beta&gt;90.00&lt;/PDBx:angle_beta&gt;
      &lt;PDBx:angle_beta_esd&gt;0.0&lt;/PDBx:angle_beta_esd&gt;
      &lt;PDBx:angle_gamma&gt;120.00&lt;/PDBx:angle_gamma&gt;
      &lt;PDBx:angle_gamma_esd&gt;0.0&lt;/PDBx:angle_gamma_esd&gt;
      &lt;PDBx:length_a&gt;150.607&lt;/PDBx:length_a&gt;
      &lt;PDBx:length_a_esd&gt;0.068&lt;/PDBx:length_a_esd&gt;
      &lt;PDBx:length_b&gt;150.607&lt;/PDBx:length_b&gt;
      &lt;PDBx:length_b_esd&gt;0.068&lt;/PDBx:length_b_esd&gt;
      &lt;PDBx:length_c&gt;111.465&lt;/PDBx:length_c&gt;
      &lt;PDBx:length_c_esd&gt;0.061&lt;/PDBx:length_c_esd&gt;
   &lt;/PDBx:pdbx_diffrn_cell&gt;
&lt;/PDBx:pdbx_diffrn_cellCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_diffrn_cell.angle_alpha"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_diffrn_cell.angle_alpha"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_diffrn_cell.angle_alpha_esd"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_diffrn_cell.angle_alpha_esd"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_diffrn_cell.angle_beta"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_diffrn_cell.angle_beta"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_diffrn_cell.angle_beta_esd"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_diffrn_cell.angle_beta_esd"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
