   <owl:Class rdf:ID="pdbx_linked_entity_list">
      <rdfs:label>pdbx_linked_entity_list</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_LINKED_ENTITY_LIST category record
the list of entity constituents for this molecule.

    Example: 1
&lt;PDBx:pdbx_linked_entity_listCategory&gt;
   &lt;PDBx:pdbx_linked_entity_list component_id="1" entity_id="1" linked_entity_id="L1"&gt;&lt;/PDBx:pdbx_linked_entity_list&gt;
   &lt;PDBx:pdbx_linked_entity_list component_id="2" entity_id="2" linked_entity_id="L1"&gt;&lt;/PDBx:pdbx_linked_entity_list&gt;
   &lt;PDBx:pdbx_linked_entity_list component_id="3" entity_id="3" linked_entity_id="L1"&gt;&lt;/PDBx:pdbx_linked_entity_list&gt;
&lt;/PDBx:pdbx_linked_entity_listCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_linked_entity_list.details"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_linked_entity_list.details"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_linked_entity_list.component_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_linked_entity_list.entity_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_linked_entity_list.linked_entity_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
