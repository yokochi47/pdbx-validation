      &lt;PDBx:n_subunits_divisor&gt;1&lt;/PDBx:n_subunits_divisor&gt;
      &lt;PDBx:number_of_operations&gt;35&lt;/PDBx:number_of_operations&gt;
      &lt;PDBx:rise_per_n_subunits&gt;6.10&lt;/PDBx:rise_per_n_subunits&gt;
