      <rdfs:subPropertyOf rdf:resource="#pdbx_nonpoly_atom_coordinationItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_nonpoly_atom_coordination.PDB_ins_code</rdfs:label>
