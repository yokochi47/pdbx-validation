operations have to be applied to generate a portion of
the biomolecule.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="struct_biol_gen.pdbx_color_blue">
      <rdfs:subPropertyOf rdf:resource="#struct_biol_genItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>struct_biol_gen.pdbx_color_blue</rdfs:label>
