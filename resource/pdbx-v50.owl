1200
5750
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_serial_crystallography_data_reduction.frames_indexed">
      <rdfs:subPropertyOf rdf:resource="#pdbx_serial_crystallography_data_reductionItem"/>
