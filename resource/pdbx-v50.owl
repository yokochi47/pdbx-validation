               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_buffer_component.id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_em_buffer_componentCategory">
      <rdfs:label>em_buffer_componentCategory</rdfs:label>
