      <rdfs:label>pdbx_entity_src_gen_refold.details</rdfs:label>
      <rdfs:comment xml:lang="en">
String value containing details of the refolding.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_entity_src_gen_refold.end_construct_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_entity_src_gen_refoldItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_entity_src_gen_refold.end_construct_id</rdfs:label>
      <rdfs:comment xml:lang="en">
This item is a pointer to pdbx_construct.id in the PDBX_CONSTRUCT
category. The referenced sequence is expected to be the amino
acid sequence of the expressed product after the refolding
step.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_entity_src_gen_refold.next_step_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_entity_src_gen_refoldItem"/>
