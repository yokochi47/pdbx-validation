2
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nonstandard_list.number_atoms_nh">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nonstandard_listItem"/>
