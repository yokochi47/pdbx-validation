   <owl:DatatypeProperty rdf:ID="em_high_pressure_freezing.details">
      <rdfs:subPropertyOf rdf:resource="#em_high_pressure_freezingItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_high_pressure_freezing.details</rdfs:label>
      <rdfs:comment xml:lang="en">
Additional details about high pressure freezing.
 High pressure freezing chamber was 250 um thick, 3.0 mm diameter,
  with central cavities 1.5 mm x 0.5 mm x 200 um deep.  The chamber
  was pre-coated with 0.5% lecithin in chloroform.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_high_pressure_freezing.em_tomography_specimen_id">
      <rdfs:subPropertyOf rdf:resource="#em_high_pressure_freezingItem"/>
