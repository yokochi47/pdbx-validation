   <owl:DatatypeProperty rdf:ID="geom_bond.publ_flag">
      <rdfs:subPropertyOf rdf:resource="#geom_bondItem"/>
      <rdfs:domain rdf:resource="#geom_bond"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">n</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">y</rdf:first>
                                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
This code signals whether the bond distance is referred to in a
publication or should be placed in a list of significant bond
distances.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="geom_bond.valence">
      <rdfs:subPropertyOf rdf:resource="#geom_bondItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>geom_bond.valence</rdfs:label>
      <rdfs:comment xml:lang="en">
The bond valence calculated from attribute dist in category geom_bond. 
                        </rdfs:comment>
   </owl:DatatypeProperty>
