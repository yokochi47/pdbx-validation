        This property indicates that datablock
        has a category holder phasing_setCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#phasing_set"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_phasing_set">
      <rdfs:label>phasing_setCategory</rdfs:label>
