      <rdfs:label>pdbx_nmr_chem_shift_ref.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_entry.id'
2DSX
                     </rdfs:comment>
   </owl:DatatypeProperty>
