      &lt;PDBx:comp_id&gt;LYS&lt;/PDBx:comp_id&gt;
      &lt;PDBx:edit_op&gt;DELETE&lt;/PDBx:edit_op&gt;
   &lt;/PDBx:pdbx_chem_comp_atom_edit&gt;
