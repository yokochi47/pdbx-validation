                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biotin</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carbohydrate</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chromophore/chromophore-like</rdf:first>
                                          <rdf:rest>
