   <owl:DatatypeProperty rdf:ID="pdbx_diffrn_ed.electron_source">
      <rdfs:subPropertyOf rdf:resource="#pdbx_diffrn_edItem"/>
      <rdfs:domain rdf:resource="#pdbx_diffrn_ed"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FIELD EMISSION GUN</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LAB6</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OTHER</rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
The source of electrons, i.e. the electron gun
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_diffrn_ed.energyfilter_lower">
      <rdfs:subPropertyOf rdf:resource="#pdbx_diffrn_edItem"/>
