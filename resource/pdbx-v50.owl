   <owl:Class rdf:ID="pdbx_na_strand_info">
      <rdfs:label>pdbx_na_strand_info</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_NA_STRAND_INFO category are still used until
the 'entity' categories are entered into the database, even though
the information is repeated.

    Example 1 - based on NDB entry DDH048
&lt;PDBx:pdbx_na_strand_infoCategory&gt;
   &lt;PDBx:pdbx_na_strand_info id="1"&gt;
      &lt;PDBx:fract_NA_strand_per_asym_unit&gt;half&lt;/PDBx:fract_NA_strand_per_asym_unit&gt;
      &lt;PDBx:num_of_NA_strands_per_asym_unit&gt;2&lt;/PDBx:num_of_NA_strands_per_asym_unit&gt;
      &lt;PDBx:num_of_NA_strands_per_biol_unit&gt;2&lt;/PDBx:num_of_NA_strands_per_biol_unit&gt;
   &lt;/PDBx:pdbx_na_strand_info&gt;
&lt;/PDBx:pdbx_na_strand_infoCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_na_strand_info.fract_NA_strand_per_asym_unit"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_na_strand_info.fract_NA_strand_per_asym_unit"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_na_strand_info.num_of_NA_strands_per_asym_unit"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_na_strand_info.num_of_NA_strands_per_asym_unit"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_na_strand_info.num_of_NA_strands_per_biol_unit"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_na_strand_info.num_of_NA_strands_per_biol_unit"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_na_strand_info.id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
