   <owl:Class rdf:ID="pdbx_trna_info">
      <rdfs:label>pdbx_trna_info</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_TRNA_INFO category are still used until
the 'entity' categories are entered into the database, even though the
T-RNA is repeated.

    Example 1 - based on NDB entry TRNA04
&lt;PDBx:pdbx_trna_infoCategory&gt;
   &lt;PDBx:pdbx_trna_info id="1"&gt;
      &lt;PDBx:name&gt;Yeast Phenylalanine T-RNA&lt;/PDBx:name&gt;
      &lt;PDBx:num_per_asym_unit&gt;1&lt;/PDBx:num_per_asym_unit&gt;
   &lt;/PDBx:pdbx_trna_info&gt;
&lt;/PDBx:pdbx_trna_infoCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_trna_info.name"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_trna_info.name"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_trna_info.num_per_asym_unit"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_trna_info.num_per_asym_unit"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_trna_info.id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_pdbx_trna_infoCategory">
