   <owl:DatatypeProperty rdf:ID="pdbx_nonpoly_atom_coordination.geometry_abbr">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nonpoly_atom_coordinationItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_nonpoly_atom_coordination.geometry_abbr</rdfs:label>
      <rdfs:comment xml:lang="en">
This data item lists the abbreviated name of the
geometry, as specified in the
attribute descriptor in category pdbx_nonpoly_atom_coordination_sphere. For
 instance, square planar is abbreviated to SPL. The
geometry derived from observed geometries in atomic
coordinate files.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nonpoly_atom_coordination.geometry_calculated">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nonpoly_atom_coordinationItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_nonpoly_atom_coordination.geometry_calculated</rdfs:label>
      <rdfs:comment xml:lang="en">
This data item contains the geometry output from a software program
(for example, FindGeo or MetalCoord). The geometry is based on what
is observed in the coordinate file.
                        </rdfs:comment>
   </owl:DatatypeProperty>
