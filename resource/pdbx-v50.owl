   <owl:DatatypeProperty rdf:ID="pdbx_reference_entity_list.type">
      <rdfs:subPropertyOf rdf:resource="#pdbx_reference_entity_listItem"/>
      <rdfs:domain rdf:resource="#pdbx_reference_entity_list"/>
