      <rdfs:range rdf:resource="#diffrn_reflns"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="diffrn_reflnsItem">
      <rdfs:label>diffrn_reflnsItem</rdfs:label>
