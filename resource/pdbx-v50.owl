   &lt;/PDBx:pdbx_reference_entity_sequence&gt;
   &lt;PDBx:pdbx_reference_entity_sequence prd_id="PRD_000010" ref_entity_id="5"&gt;
      &lt;PDBx:NRP_flag&gt;Y&lt;/PDBx:NRP_flag&gt;
