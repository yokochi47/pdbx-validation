      <rdfs:subPropertyOf rdf:resource="#pdbx_phasing_MAD_shellItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_phasing_MAD_shell.power_centric</rdfs:label>
      <rdfs:comment xml:lang="en">
attribute power_centric in category pdbx_phasing_MAD_shell records phasing powe
 using centric data for MAD phasing.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_phasing_MAD_shell.reflns">
      <rdfs:subPropertyOf rdf:resource="#pdbx_phasing_MAD_shellItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_phasing_MAD_shell.reflns</rdfs:label>
      <rdfs:comment xml:lang="en">
attribute reflns in category pdbx_phasing_MAD_shell records the number of
 reflections used for MAD phasing.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_phasing_MAD_shell.reflns_acentric">
      <rdfs:subPropertyOf rdf:resource="#pdbx_phasing_MAD_shellItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_phasing_MAD_shell.reflns_acentric</rdfs:label>
      <rdfs:comment xml:lang="en">
attribute reflns_acentric in category pdbx_phasing_MAD_shell records the number of
 acentric reflections for MAD phasing.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_phasing_MAD_shell.reflns_centric">
