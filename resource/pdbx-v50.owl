   <owl:DatatypeProperty rdf:ID="pdbx_exptl_crystal_grow_comp.comp_name">
      <rdfs:subPropertyOf rdf:resource="#pdbx_exptl_crystal_grow_compItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_exptl_crystal_grow_comp.comp_name</rdfs:label>
      <rdfs:comment xml:lang="en">
A common name for the component of the solution.
protein in buffer
acetic acid
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_exptl_crystal_grow_comp.conc">
      <rdfs:subPropertyOf rdf:resource="#pdbx_exptl_crystal_grow_compItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_exptl_crystal_grow_comp.conc</rdfs:label>
      <rdfs:comment xml:lang="en">
The concentration value of the solution component.
200.
0.1
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_exptl_crystal_grow_comp.conc_range">
      <rdfs:subPropertyOf rdf:resource="#pdbx_exptl_crystal_grow_compItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_exptl_crystal_grow_comp.conc_range</rdfs:label>
      <rdfs:comment xml:lang="en">
The concentration range of the solution component.
200. - 230.
0.1 - 0.2
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_exptl_crystal_grow_comp.conc_units">
      <rdfs:subPropertyOf rdf:resource="#pdbx_exptl_crystal_grow_compItem"/>
      <rdfs:domain rdf:resource="#pdbx_exptl_crystal_grow_comp"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mg/ml</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">g/l</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ug/ml</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ug/ul</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ng/ul</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">molar</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">millimolar</rdf:first>
                                                      <rdf:rest>
                                                         <rdf:List>
                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">micromolar</rdf:first>
                                                            <rdf:rest>
                                                               <rdf:List>
                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">percent</rdf:first>
                                                                  <rdf:rest>
                                                                     <rdf:List>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">percent_weight_by_volume</rdf:first>
                                                                        <rdf:rest>
                                                                           <rdf:List>
                                                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">percent_weight_by_weight</rdf:first>
                                                                              <rdf:rest>
                                                                                 <rdf:List>
                                                                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">percent_volume_by_volume</rdf:first>
                                                                                    <rdf:rest>
                                                                                       <rdf:List>
                                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">percent_volume_by_weight</rdf:first>
                                                                                          <rdf:rest>
                                                                                             <rdf:List>
                                                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nanomolar</rdf:first>
                                                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                             </rdf:List>
                                                                                          </rdf:rest>
                                                                                       </rdf:List>
                                                                                    </rdf:rest>
                                                                                 </rdf:List>
                                                                              </rdf:rest>
                                                                           </rdf:List>
                                                                        </rdf:rest>
                                                                     </rdf:List>
                                                                  </rdf:rest>
                                                               </rdf:List>
                                                            </rdf:rest>
                                                         </rdf:List>
                                                      </rdf:rest>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
The concentration units for the solution component.
millimolar
percent_weight_by_volume
milligrams_per_milliliter
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_exptl_crystal_grow_comp.sol_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_exptl_crystal_grow_compItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_exptl_crystal_grow_comp.sol_id</rdfs:label>
      <rdfs:comment xml:lang="en">
An identifier for the solution to which the given solution
component belongs.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_exptl_crystal_grow_comp.comp_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_exptl_crystal_grow_compItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_exptl_crystal_grow_comp.comp_id</rdfs:label>
      <rdfs:comment xml:lang="en">
The value of attribute comp_id in category exptl_crystal_grow_comp must uniquely identify
 each item in the PDBX_EXPTL_CRYSTAL_GROW_COMP list.

Note that this item need not be a number; it can be any unique
identifier.
1
2
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_exptl_crystal_grow_comp.crystal_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_exptl_crystal_grow_compItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_exptl_crystal_grow_comp.crystal_id</rdfs:label>
      <rdfs:comment xml:lang="en">
This data item is a pointer to attribute id in category exptl_crystal in the
 EXPTL_CRYSTAL category.
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="pdbx_exptl_crystal_grow_solCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_pdbx_exptl_crystal_grow_sol"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="pdbx_exptl_crystal_grow_sol">
      <rdfs:label>pdbx_exptl_crystal_grow_sol</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_EXPTL_CRYSTAL_GROW_SOL category record
details about the solutions that were 'mixed'
to produce the crystal.
 Example 1
&lt;PDBx:pdbx_exptl_crystal_grow_solCategory&gt;
   &lt;PDBx:pdbx_exptl_crystal_grow_sol crystal_id="1" sol_id="protein"&gt;
      &lt;PDBx:pH&gt;7.5&lt;/PDBx:pH&gt;
      &lt;PDBx:volume&gt;0.5&lt;/PDBx:volume&gt;
      &lt;PDBx:volume_units&gt;microliter&lt;/PDBx:volume_units&gt;
   &lt;/PDBx:pdbx_exptl_crystal_grow_sol&gt;
   &lt;PDBx:pdbx_exptl_crystal_grow_sol crystal_id="1" sol_id="precipitant"&gt;
      &lt;PDBx:pH&gt;7.3&lt;/PDBx:pH&gt;
      &lt;PDBx:volume&gt;0.5&lt;/PDBx:volume&gt;
      &lt;PDBx:volume_units&gt;microliter&lt;/PDBx:volume_units&gt;
   &lt;/PDBx:pdbx_exptl_crystal_grow_sol&gt;
   &lt;PDBx:pdbx_exptl_crystal_grow_sol crystal_id="1" sol_id="reservoir"&gt;
      &lt;PDBx:pH&gt;7.3&lt;/PDBx:pH&gt;
      &lt;PDBx:volume&gt;0.5&lt;/PDBx:volume&gt;
      &lt;PDBx:volume_units&gt;milliliter&lt;/PDBx:volume_units&gt;
   &lt;/PDBx:pdbx_exptl_crystal_grow_sol&gt;
&lt;/PDBx:pdbx_exptl_crystal_grow_solCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_exptl_crystal_grow_sol.pH"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_exptl_crystal_grow_sol.pH"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_exptl_crystal_grow_sol.volume"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_exptl_crystal_grow_sol.volume"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_exptl_crystal_grow_sol.volume_units"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_exptl_crystal_grow_sol.volume_units"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_exptl_crystal_grow_sol.crystal_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_exptl_crystal_grow_sol.sol_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_pdbx_exptl_crystal_grow_solCategory">
      <rdfs:label>pdbx_exptl_crystal_grow_solCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that datablock
        has a category holder pdbx_exptl_crystal_grow_solCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
