      <rdfs:label>pdbx_linked_entity_link_list.component_2</rdfs:label>
      <rdfs:comment xml:lang="en">
The entity component identifier for the second of two entities containing the linkage.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_linked_entity_link_list.details">
