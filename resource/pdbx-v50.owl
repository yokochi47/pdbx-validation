      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_domain_range.end_label_comp_id</rdfs:label>
      <rdfs:comment xml:lang="en">
A component of the identifier for the monomer at which this
segment of the domain ends.

This data item is a pointer to attribute label_comp_id in category atom_site in the
 ATOM_SITE category.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_domain_range.end_label_seq_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_domain_rangeItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_domain_range.end_label_seq_id</rdfs:label>
