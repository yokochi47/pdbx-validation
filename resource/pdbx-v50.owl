                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_final_classification.avg_num_images_per_class"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_final_classification.details"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_final_classification.details"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_final_classification.image_processing_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_final_classification.image_processing_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_final_classification.num_classes"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_final_classification.num_classes"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_final_classification.type"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_final_classification.type"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_final_classification.id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
