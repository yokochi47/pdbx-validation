               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#chem_link_tor.atom_4_comp_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#chem_link_tor.atom_4_comp_id"/>
