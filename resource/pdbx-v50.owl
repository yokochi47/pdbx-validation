      <rdfs:label>journal_index.term</rdfs:label>
      <rdfs:comment xml:lang="en">
Journal index data items are defined by the journal staff.
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="journal_index.type">
