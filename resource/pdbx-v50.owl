      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_msym_genItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_struct_msym_gen.entity_inst_id</rdfs:label>
      <rdfs:comment xml:lang="en">
This data item is a pointer to attribute id in category pdbx_struct_entity_inst in
 the PDBX_STRUCT_ENTITY_INST category.
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_struct_msym_gen.msym_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_msym_genItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_struct_msym_gen.msym_id</rdfs:label>
      <rdfs:comment xml:lang="en">
Uniquely identifies the this structure instance in
point symmetry unit.
                     </rdfs:comment>
   </owl:DatatypeProperty>
