        has a category holder chem_comp_chirCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#chem_comp_chir"/>
   </owl:InverseFunctionalProperty>
