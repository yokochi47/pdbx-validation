      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_densityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_dcc_density.twin_fraction_xtriage</rdfs:label>
      <rdfs:comment xml:lang="en">
The twin fraction determined by Xtriage.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_density.twin_operator">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_densityItem"/>
