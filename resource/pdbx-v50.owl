      <rdfs:label>referenced_by_pdbx_entity_src_gen_pure</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from pdbx_entity_src_gen_pure.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#pdbx_entity_src_gen_pure"/>
