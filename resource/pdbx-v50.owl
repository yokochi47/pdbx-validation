   <owl:Class rdf:ID="struct_conf_typeCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_struct_conf_type"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="struct_conf_type">
      <rdfs:label>struct_conf_type</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the STRUCT_CONF_TYPE category record details
about the criteria used to identify backbone conformations of a
segment of polymer.

    Example 1 - based on PDB entry 5HVP and laboratory records for the
                structure corresponding to PDB entry 5HVP.
&lt;PDBx:struct_conf_typeCategory&gt;
   &lt;PDBx:struct_conf_type id="HELX_RH_AL_P"&gt;
      &lt;PDBx:criteria&gt;author judgement&lt;/PDBx:criteria&gt;
      &lt;PDBx:reference xsi:nil="true" /&gt;
   &lt;/PDBx:struct_conf_type&gt;
   &lt;PDBx:struct_conf_type id="STRN_P"&gt;
      &lt;PDBx:criteria&gt;author judgement&lt;/PDBx:criteria&gt;
      &lt;PDBx:reference xsi:nil="true" /&gt;
   &lt;/PDBx:struct_conf_type&gt;
   &lt;PDBx:struct_conf_type id="TURN_TY1_P"&gt;
      &lt;PDBx:criteria&gt;author judgement&lt;/PDBx:criteria&gt;
      &lt;PDBx:reference xsi:nil="true" /&gt;
   &lt;/PDBx:struct_conf_type&gt;
   &lt;PDBx:struct_conf_type id="TURN_TY1P_P"&gt;
      &lt;PDBx:criteria&gt;author judgement&lt;/PDBx:criteria&gt;
      &lt;PDBx:reference xsi:nil="true" /&gt;
   &lt;/PDBx:struct_conf_type&gt;
   &lt;PDBx:struct_conf_type id="TURN_TY2_P"&gt;
      &lt;PDBx:criteria&gt;author judgement&lt;/PDBx:criteria&gt;
      &lt;PDBx:reference xsi:nil="true" /&gt;
   &lt;/PDBx:struct_conf_type&gt;
   &lt;PDBx:struct_conf_type id="TURN_TY2P_P"&gt;
      &lt;PDBx:criteria&gt;author judgement&lt;/PDBx:criteria&gt;
      &lt;PDBx:reference xsi:nil="true" /&gt;
   &lt;/PDBx:struct_conf_type&gt;
&lt;/PDBx:struct_conf_typeCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_conf_type.criteria"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_conf_type.criteria"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_conf_type.reference"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_conf_type.reference"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_conf_type.id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_struct_conf_typeCategory">
      <rdfs:label>struct_conf_typeCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
