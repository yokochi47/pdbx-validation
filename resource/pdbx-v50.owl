      <rdfs:subPropertyOf rdf:resource="#pdbx_chem_comp_depositor_infoItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_chem_comp_depositor_info.ordinal</rdfs:label>
      <rdfs:comment xml:lang="en">
Ordinal index for this category.
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="pdbx_chem_comp_descriptorCategory">
