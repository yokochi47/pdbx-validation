      <rdfs:range rdf:resource="#pdbx_post_process_status"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_post_process_status.annotator">
      <rdfs:subPropertyOf rdf:resource="#pdbx_post_process_statusItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_post_process_status.annotator</rdfs:label>
      <rdfs:comment xml:lang="en">
The name of the annotator.
Anke Gelbin
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_post_process_status.date_begin">
      <rdfs:subPropertyOf rdf:resource="#pdbx_post_process_statusItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_post_process_status.date_begin</rdfs:label>
      <rdfs:comment xml:lang="en">
The starting date for the current post-processing cycle.
1998-10-22:09:30
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_post_process_status.date_end">
      <rdfs:subPropertyOf rdf:resource="#pdbx_post_process_statusItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_post_process_status.date_end</rdfs:label>
      <rdfs:comment xml:lang="en">
The completion date for the current post-processing cycle.
1998-10-22:10:00
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_post_process_status.details">
      <rdfs:subPropertyOf rdf:resource="#pdbx_post_process_statusItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_post_process_status.details</rdfs:label>
      <rdfs:comment xml:lang="en">
A description of the current post-processing cycle.
Fixing ligand nomenclature.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_post_process_status.cycle_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_post_process_statusItem"/>
      <rdfs:domain rdf:resource="#pdbx_post_process_status"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">7</rdf:first>
                                                      <rdf:rest>
                                                         <rdf:List>
                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">8</rdf:first>
                                                            <rdf:rest>
                                                               <rdf:List>
                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">9</rdf:first>
                                                                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                               </rdf:List>
                                                            </rdf:rest>
                                                         </rdf:List>
                                                      </rdf:rest>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
Identifier for the current cycle of post-processing.
1 for the initial cycle
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_post_process_status.entry_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_post_process_statusItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_post_process_status.entry_id</rdfs:label>
