      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#pdbx_exptl_crystal_grow_sol"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_pdbx_exptl_crystal_grow_sol">
      <rdfs:label>reference_to_pdbx_exptl_crystal_grow_sol</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to pdbx_exptl_crystal_grow_sol.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#pdbx_exptl_crystal_grow_sol"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_pdbx_exptl_crystal_grow_sol">
      <rdfs:label>referenced_by_pdbx_exptl_crystal_grow_sol</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from pdbx_exptl_crystal_grow_sol.</rdfs:comment>
