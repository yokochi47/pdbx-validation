      <rdfs:label>pdbx_data_processing_statusItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for pdbx_data_processing_status items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#pdbx_data_processing_status"/>
   </owl:DatatypeProperty>
