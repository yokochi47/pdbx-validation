      <rdfs:label>pdbx_solvent_info.numb_per_asym_unit</rdfs:label>
      <rdfs:comment xml:lang="en">
Number of solvent molecules per asymmetric unit.
22
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_solvent_info.id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_solvent_infoItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_solvent_info.id</rdfs:label>
      <rdfs:comment xml:lang="en">
Serial number.
1
                     </rdfs:comment>
   </owl:DatatypeProperty>
