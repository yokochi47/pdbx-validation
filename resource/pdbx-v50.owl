                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_density.tls_group_number">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_densityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_dcc_density.tls_group_number</rdfs:label>
      <rdfs:comment xml:lang="en">
Number of TLS groups used in refinement.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_density.translational_pseudo_symmetry">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_densityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_dcc_density.translational_pseudo_symmetry</rdfs:label>
      <rdfs:comment xml:lang="en">
Boolean whether translational pseudo symmetry exist (Y) or
