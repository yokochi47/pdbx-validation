      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#pdbx_entity_src_gen_proteolysis"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_pdbx_entity_src_gen_proteolysis">
      <rdfs:label>reference_to_pdbx_entity_src_gen_proteolysis</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to pdbx_entity_src_gen_proteolysis.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#pdbx_entity_src_gen_proteolysis"/>
   </owl:ObjectProperty>
