String value containing details of the lysis protocol.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_entity_src_gen_lysis.end_construct_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_entity_src_gen_lysisItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_entity_src_gen_lysis.end_construct_id</rdfs:label>
      <rdfs:comment xml:lang="en">
This item is a pointer to pdbx_construct.id in the PDBX_CONSTRUCT
category. The referenced sequence is expected to be the amino
acid sequence of the expressed product after lysis.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_entity_src_gen_lysis.method">
      <rdfs:subPropertyOf rdf:resource="#pdbx_entity_src_gen_lysisItem"/>
      <rdfs:domain rdf:resource="#pdbx_entity_src_gen_lysis"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">S</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">B</rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
The lysis method.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_entity_src_gen_lysis.next_step_id">
