   <owl:DatatypeProperty rdf:ID="pdbx_diffrn_orientation.matrix11">
      <rdfs:subPropertyOf rdf:resource="#pdbx_diffrn_orientationItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_diffrn_orientation.matrix11</rdfs:label>
      <rdfs:comment xml:lang="en">
The [1][1] element of the 3x3 matrix that defines the
orientation of the reciprocal cell with respect to the
local right-handed coordinate system. See also
attribute type in category pdbx_diffrn_orientation. 
                        </rdfs:comment>
   </owl:DatatypeProperty>
