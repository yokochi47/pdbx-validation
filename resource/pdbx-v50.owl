   <owl:DatatypeProperty rdf:ID="pdbx_reference_linked_entity.class">
      <rdfs:subPropertyOf rdf:resource="#pdbx_reference_linked_entityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
