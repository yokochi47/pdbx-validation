   </owl:Class>
   <owl:Class rdf:ID="pdbx_entity_branch_link">
      <rdfs:label>pdbx_entity_branch_link</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_ENTITY_BRANCH_LINK category give details about
the linkages between components within a branched entity.

    Example 1 - base on PDB entry 2WMG
&lt;PDBx:pdbx_entity_branch_linkCategory&gt;
   &lt;PDBx:pdbx_entity_branch_link link_id="1"&gt;
      &lt;PDBx:atom_id_1&gt;O4&lt;/PDBx:atom_id_1&gt;
      &lt;PDBx:atom_id_2&gt;C1&lt;/PDBx:atom_id_2&gt;
      &lt;PDBx:atom_stereo_config_2&gt;R&lt;/PDBx:atom_stereo_config_2&gt;
      &lt;PDBx:comp_id_1&gt;NAG&lt;/PDBx:comp_id_1&gt;
      &lt;PDBx:comp_id_2&gt;GAL&lt;/PDBx:comp_id_2&gt;
      &lt;PDBx:entity_branch_list_num_1&gt;1&lt;/PDBx:entity_branch_list_num_1&gt;
      &lt;PDBx:entity_branch_list_num_2&gt;2&lt;/PDBx:entity_branch_list_num_2&gt;
      &lt;PDBx:entity_id&gt;2&lt;/PDBx:entity_id&gt;
      &lt;PDBx:leaving_atom_id_1&gt;HO4&lt;/PDBx:leaving_atom_id_1&gt;
      &lt;PDBx:leaving_atom_id_2&gt;O1&lt;/PDBx:leaving_atom_id_2&gt;
      &lt;PDBx:value_order&gt;sing&lt;/PDBx:value_order&gt;
   &lt;/PDBx:pdbx_entity_branch_link&gt;
   &lt;PDBx:pdbx_entity_branch_link link_id="2"&gt;
      &lt;PDBx:atom_id_1&gt;O2&lt;/PDBx:atom_id_1&gt;
      &lt;PDBx:atom_id_2&gt;C1&lt;/PDBx:atom_id_2&gt;
      &lt;PDBx:atom_stereo_config_2&gt;R&lt;/PDBx:atom_stereo_config_2&gt;
      &lt;PDBx:comp_id_1&gt;GAL&lt;/PDBx:comp_id_1&gt;
      &lt;PDBx:comp_id_2&gt;FUC&lt;/PDBx:comp_id_2&gt;
      &lt;PDBx:entity_branch_list_num_1&gt;2&lt;/PDBx:entity_branch_list_num_1&gt;
      &lt;PDBx:entity_branch_list_num_2&gt;3&lt;/PDBx:entity_branch_list_num_2&gt;
      &lt;PDBx:entity_id&gt;2&lt;/PDBx:entity_id&gt;
      &lt;PDBx:leaving_atom_id_1&gt;HO2&lt;/PDBx:leaving_atom_id_1&gt;
      &lt;PDBx:leaving_atom_id_2&gt;O1&lt;/PDBx:leaving_atom_id_2&gt;
      &lt;PDBx:value_order&gt;sing&lt;/PDBx:value_order&gt;
   &lt;/PDBx:pdbx_entity_branch_link&gt;
   &lt;PDBx:pdbx_entity_branch_link link_id="3"&gt;
      &lt;PDBx:atom_id_1&gt;O3&lt;/PDBx:atom_id_1&gt;
      &lt;PDBx:atom_id_2&gt;C1&lt;/PDBx:atom_id_2&gt;
      &lt;PDBx:atom_stereo_config_2&gt;R&lt;/PDBx:atom_stereo_config_2&gt;
      &lt;PDBx:comp_id_1&gt;NAG&lt;/PDBx:comp_id_1&gt;
      &lt;PDBx:comp_id_2&gt;FUC&lt;/PDBx:comp_id_2&gt;
      &lt;PDBx:entity_branch_list_num_1&gt;1&lt;/PDBx:entity_branch_list_num_1&gt;
      &lt;PDBx:entity_branch_list_num_2&gt;4&lt;/PDBx:entity_branch_list_num_2&gt;
      &lt;PDBx:entity_id&gt;2&lt;/PDBx:entity_id&gt;
      &lt;PDBx:leaving_atom_id_1&gt;HO3&lt;/PDBx:leaving_atom_id_1&gt;
      &lt;PDBx:leaving_atom_id_2&gt;O1&lt;/PDBx:leaving_atom_id_2&gt;
      &lt;PDBx:value_order&gt;sing&lt;/PDBx:value_order&gt;
   &lt;/PDBx:pdbx_entity_branch_link&gt;
&lt;/PDBx:pdbx_entity_branch_linkCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_link.atom_id_1"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_link.atom_id_1"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_link.atom_id_2"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_link.atom_id_2"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_link.atom_stereo_config_1"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_link.atom_stereo_config_1"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_link.atom_stereo_config_2"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_link.atom_stereo_config_2"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_link.comp_id_1"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_link.comp_id_1"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_link.comp_id_2"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_link.comp_id_2"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_link.details"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_link.details"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_link.entity_branch_list_num_1"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_link.entity_branch_list_num_1"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_branch_link.entity_branch_list_num_2"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
