               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#reflns_shell.meanI_over_uI_all"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
