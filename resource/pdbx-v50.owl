      &lt;PDBx:symmetry&gt;1_555&lt;/PDBx:symmetry&gt;
   &lt;/PDBx:struct_sheet_range&gt;
   &lt;PDBx:struct_sheet_range id="strand_g" sheet_id="sheet_1"&gt;
      &lt;PDBx:beg_label_asym_id&gt;A&lt;/PDBx:beg_label_asym_id&gt;
