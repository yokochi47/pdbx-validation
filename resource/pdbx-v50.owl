      <rdfs:subPropertyOf rdf:resource="#pdbx_feature_entryItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_feature_entry.feature_assigned_by</rdfs:label>
