               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_entity_assembly_recombinant.ncbi_tax_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_entity_assembly_recombinant.organism"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_entity_assembly_recombinant.organism"/>
