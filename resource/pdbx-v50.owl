      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#pdbx_SG_project"/>
      <rdfs:domain rdf:resource="#pdbx_SG_projectCategory"/>
      <rdfs:range rdf:resource="#pdbx_SG_project"/>
   </owl:InverseFunctionalProperty>
