   <owl:Class rdf:ID="pdbx_validate_torsion">
      <rdfs:label>pdbx_validate_torsion</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_VALIDATE_TORSION category list the
residues with torsion angles outside the expected ramachandran regions

    Example 1
&lt;PDBx:pdbx_validate_torsionCategory&gt;
   &lt;PDBx:pdbx_validate_torsion id="1"&gt;
      &lt;PDBx:PDB_ins_code xsi:nil="true" /&gt;
      &lt;PDBx:PDB_model_num&gt;1&lt;/PDBx:PDB_model_num&gt;
      &lt;PDBx:auth_asym_id&gt;A&lt;/PDBx:auth_asym_id&gt;
      &lt;PDBx:auth_comp_id&gt;SER&lt;/PDBx:auth_comp_id&gt;
      &lt;PDBx:auth_seq_id&gt;12&lt;/PDBx:auth_seq_id&gt;
      &lt;PDBx:phi&gt;-64.75&lt;/PDBx:phi&gt;
      &lt;PDBx:psi&gt;2.02&lt;/PDBx:psi&gt;
   &lt;/PDBx:pdbx_validate_torsion&gt;
   &lt;PDBx:pdbx_validate_torsion id="2"&gt;
      &lt;PDBx:PDB_ins_code xsi:nil="true" /&gt;
      &lt;PDBx:PDB_model_num&gt;1&lt;/PDBx:PDB_model_num&gt;
      &lt;PDBx:auth_asym_id&gt;A&lt;/PDBx:auth_asym_id&gt;
      &lt;PDBx:auth_comp_id&gt;THR&lt;/PDBx:auth_comp_id&gt;
      &lt;PDBx:auth_seq_id&gt;22&lt;/PDBx:auth_seq_id&gt;
      &lt;PDBx:phi&gt;-116.30&lt;/PDBx:phi&gt;
      &lt;PDBx:psi&gt;61.44&lt;/PDBx:psi&gt;
   &lt;/PDBx:pdbx_validate_torsion&gt;
&lt;/PDBx:pdbx_validate_torsionCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.PDB_ins_code"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.PDB_ins_code"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.PDB_model_num"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.PDB_model_num"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.auth_asym_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.auth_asym_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.auth_comp_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.auth_comp_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.auth_seq_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.auth_seq_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.label_alt_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.label_alt_id"/>
