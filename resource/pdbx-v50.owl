      <rdfs:subPropertyOf rdf:resource="#pdbx_investigationItem"/>
      <rdfs:domain rdf:resource="#pdbx_investigation"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fragment Screening</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crystallization Screening</rdf:first>
