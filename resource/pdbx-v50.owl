   <owl:Class rdf:ID="pdbx_chem_comp_related">
      <rdfs:label>pdbx_chem_comp_related</rdfs:label>
      <rdfs:comment xml:lang="en">
PDBX_CHEM_COMP_RELATED describes the relationship between two chemical components.

    Example 1 -
&lt;PDBx:pdbx_chem_comp_relatedCategory&gt;
   &lt;PDBx:pdbx_chem_comp_related comp_id="SGN" related_comp_id="GLC" relationship_type="Carbohydrate core"&gt;
   &lt;/PDBx:pdbx_chem_comp_related&gt;
&lt;/PDBx:pdbx_chem_comp_relatedCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_related.details"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_related.details"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_related.comp_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_related.related_comp_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_related.relationship_type"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
