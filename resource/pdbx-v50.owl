   <owl:Class rdf:ID="pdbx_chem_comp_instance_depositor_info">
      <rdfs:label>pdbx_chem_comp_instance_depositor_info</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_CHEM_COMP_INSTANCE_DEPOSITOR_INFO category records
depositor provided information about the chemical context of component instances.

    Example -
&lt;PDBx:pdbx_chem_comp_instance_depositor_infoCategory&gt;
   &lt;PDBx:pdbx_chem_comp_instance_depositor_info ordinal="1"&gt;
      &lt;PDBx:PDB_ins_code xsi:nil="true" /&gt;
      &lt;PDBx:auth_asym_id&gt;W&lt;/PDBx:auth_asym_id&gt;
      &lt;PDBx:auth_seq_id&gt;102&lt;/PDBx:auth_seq_id&gt;
      &lt;PDBx:author_provided_flag&gt;Y&lt;/PDBx:author_provided_flag&gt;
      &lt;PDBx:comp_id&gt;X78&lt;/PDBx:comp_id&gt;
      &lt;PDBx:in_polymer_flag&gt;N&lt;/PDBx:in_polymer_flag&gt;
      &lt;PDBx:label_alt_id xsi:nil="true" /&gt;
   &lt;/PDBx:pdbx_chem_comp_instance_depositor_info&gt;
&lt;/PDBx:pdbx_chem_comp_instance_depositor_infoCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_instance_depositor_info.PDB_ins_code"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_instance_depositor_info.PDB_ins_code"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_instance_depositor_info.auth_asym_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_instance_depositor_info.auth_asym_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_instance_depositor_info.auth_seq_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_instance_depositor_info.auth_seq_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_instance_depositor_info.author_provided_flag"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_instance_depositor_info.author_provided_flag"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_instance_depositor_info.comp_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_instance_depositor_info.comp_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_instance_depositor_info.formula"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_instance_depositor_info.formula"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_instance_depositor_info.in_polymer_flag"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
