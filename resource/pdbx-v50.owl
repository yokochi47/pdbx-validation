      <rdfs:label>pdbx_family_prd_auditItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for pdbx_family_prd_audit items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#pdbx_family_prd_audit"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_pdbx_family_prd_audit">
      <rdfs:label>reference_to_pdbx_family_prd_audit</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to pdbx_family_prd_audit.</rdfs:comment>
