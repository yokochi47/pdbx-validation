   <owl:InverseFunctionalProperty rdf:ID="has_pdbx_atlasCategory">
      <rdfs:label>pdbx_atlasCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that datablock
        has a category holder pdbx_atlasCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#pdbx_atlas"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_pdbx_atlas">
      <rdfs:label>pdbx_atlasCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that pdbx_atlasCategory.
        has a category pdbx_atlas.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#pdbx_atlas"/>
      <rdfs:domain rdf:resource="#pdbx_atlasCategory"/>
      <rdfs:range rdf:resource="#pdbx_atlas"/>
   </owl:InverseFunctionalProperty>
