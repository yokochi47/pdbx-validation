      <rdfs:label>em_diffraction_shell.num_structure_factors</rdfs:label>
      <rdfs:comment xml:lang="en">
Number of measured structure factors in this resolution shell
244
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_diffraction_shell.phase_residual">
      <rdfs:subPropertyOf rdf:resource="#em_diffraction_shellItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_diffraction_shell.phase_residual</rdfs:label>
      <rdfs:comment xml:lang="en">
Phase residual for this resolution shell, in degrees
13.5
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_diffraction_shell.id">
      <rdfs:subPropertyOf rdf:resource="#em_diffraction_shellItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_diffraction_shell.id</rdfs:label>
      <rdfs:comment xml:lang="en">
PRIMARY KEY
                     </rdfs:comment>
   </owl:DatatypeProperty>
