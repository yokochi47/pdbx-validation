   <owl:DatatypeProperty rdf:ID="pdbx_nmr_upload.data_file_name">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nmr_uploadItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_nmr_upload.data_file_name</rdfs:label>
      <rdfs:comment xml:lang="en">

The directory path and file name for the data file that is to be uploaded.
t1_relaxation_1.txt
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nmr_upload.data_file_syntax">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nmr_uploadItem"/>
      <rdfs:domain rdf:resource="#pdbx_nmr_upload"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NMR-STAR 3.1</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NMR-STAR 2.1</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AMBER</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">XPLOR</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TALOS</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CYANA</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The syntax or format of the file that is uploaded.
NMR-STAR v3
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nmr_upload.data_file_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nmr_uploadItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_nmr_upload.data_file_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Unique code assigned to the file being uploaded by the depositor and that
contains data that will be incorporated into this entry.
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nmr_upload.entry_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nmr_uploadItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_nmr_upload.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_entry.id'
2DSX
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="pdbx_nonpoly_atom_coordinationCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_pdbx_nonpoly_atom_coordination"/>
