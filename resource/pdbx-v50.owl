      <rdfs:label>pdbx_view_category.category_id</rdfs:label>
      <rdfs:comment xml:lang="en">
The mmCIF category identifier.
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="pdbx_view_category_groupCategory">
      <rdfs:subClassOf>
         <owl:Class>
