   <owl:DatatypeProperty rdf:ID="pdbx_depui_validation_status_flags.adp_outliers_low">
      <rdfs:subPropertyOf rdf:resource="#pdbx_depui_validation_status_flagsItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_depui_validation_status_flags.adp_outliers_low</rdfs:label>
      <rdfs:comment xml:lang="en">
Count of atoms with ADP (B-values) values less than 0
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_depui_validation_status_flags.adp_outliers_zero">
      <rdfs:subPropertyOf rdf:resource="#pdbx_depui_validation_status_flagsItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_depui_validation_status_flags.adp_outliers_zero</rdfs:label>
      <rdfs:comment xml:lang="en">
A flag to indicate if any isotropic B factors are zero.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_depui_validation_status_flags.occupancy_outliers_high">
      <rdfs:subPropertyOf rdf:resource="#pdbx_depui_validation_status_flagsItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_depui_validation_status_flags.occupancy_outliers_high</rdfs:label>
      <rdfs:comment xml:lang="en">
Count of atoms with occupancy values greater than 1
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_depui_validation_status_flags.occupancy_outliers_low">
      <rdfs:subPropertyOf rdf:resource="#pdbx_depui_validation_status_flagsItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_depui_validation_status_flags.occupancy_outliers_low</rdfs:label>
      <rdfs:comment xml:lang="en">
Count of atoms with occupancy values less than 0
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_depui_validation_status_flags.residual_B_factors_flag">
      <rdfs:subPropertyOf rdf:resource="#pdbx_depui_validation_status_flagsItem"/>
      <rdfs:domain rdf:resource="#pdbx_depui_validation_status_flags"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Y</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
A flag to indicate if the uploaded data is contains residual B-values
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_depui_validation_status_flags.solvent_outliers">
      <rdfs:subPropertyOf rdf:resource="#pdbx_depui_validation_status_flagsItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_depui_validation_status_flags.solvent_outliers</rdfs:label>
      <rdfs:comment xml:lang="en">
Count of solvent atoms with anonalous positions.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_depui_validation_status_flags.tls_no_aniso">
      <rdfs:subPropertyOf rdf:resource="#pdbx_depui_validation_status_flagsItem"/>
      <rdfs:domain rdf:resource="#pdbx_depui_validation_status_flags"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Y</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
A flag to indicate if the uploaded model has TLS records
but no anisotropic ones.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_depui_validation_status_flags.dep_dataset_id">
