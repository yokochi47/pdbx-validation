   <owl:Class rdf:ID="pdbx_ion_info">
      <rdfs:label>pdbx_ion_info</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_ION_INFO category are still used until
the 'entity' categories are entered into the database, even though the
information is repeated.

    Example 1 - based on NDB entry DDH048
&lt;PDBx:pdbx_ion_infoCategory&gt;
   &lt;PDBx:pdbx_ion_info id="1"&gt;
      &lt;PDBx:name&gt;MG&lt;/PDBx:name&gt;
      &lt;PDBx:numb_per_asym_unit&gt;3&lt;/PDBx:numb_per_asym_unit&gt;
   &lt;/PDBx:pdbx_ion_info&gt;
&lt;/PDBx:pdbx_ion_infoCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_ion_info.name"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_ion_info.name"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_ion_info.numb_per_asym_unit"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_ion_info.numb_per_asym_unit"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_ion_info.id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_pdbx_ion_infoCategory">
      <rdfs:label>pdbx_ion_infoCategory</rdfs:label>
