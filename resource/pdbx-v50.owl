      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_msym_genItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_struct_msym_gen.oper_expression</rdfs:label>
      <rdfs:comment xml:lang="en">
Identifies the operation from category PDBX_STRUCT_OPER_LIST.
(1)
(1-3)
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="pdbx_struct_ncs_virus_genCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_pdbx_struct_ncs_virus_gen"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
