   <owl:Class rdf:ID="pdbx_sifts_xref_db">
      <rdfs:label>pdbx_sifts_xref_db</rdfs:label>
      <rdfs:comment xml:lang="en">
pdbx_sifts_xref_db describes residue-level cross-references to external databases.

    Example 1 -
&lt;PDBx:pdbx_sifts_xref_dbCategory&gt;
   &lt;PDBx:pdbx_sifts_xref_db asym_id="A" entity_id="1" seq_id="254" seq_id_ordinal="1"&gt;
      &lt;PDBx:mh_id&gt;1&lt;/PDBx:mh_id&gt;
      &lt;PDBx:mon_id&gt;ILE&lt;/PDBx:mon_id&gt;
      &lt;PDBx:mon_id_one_letter_code&gt;I&lt;/PDBx:mon_id_one_letter_code&gt;
      &lt;PDBx:observed&gt;1&lt;/PDBx:observed&gt;
      &lt;PDBx:res_type xsi:nil="true" /&gt;
      &lt;PDBx:unp_acc&gt;P00720&lt;/PDBx:unp_acc&gt;
      &lt;PDBx:unp_instance_id&gt;1&lt;/PDBx:unp_instance_id&gt;
      &lt;PDBx:unp_num&gt;50&lt;/PDBx:unp_num&gt;
      &lt;PDBx:unp_res&gt;I&lt;/PDBx:unp_res&gt;
      &lt;PDBx:unp_segment_id&gt;1&lt;/PDBx:unp_segment_id&gt;
      &lt;PDBx:xref_db_acc&gt;PF14843&lt;/PDBx:xref_db_acc&gt;
      &lt;PDBx:xref_db_instance_id&gt;1&lt;/PDBx:xref_db_instance_id&gt;
      &lt;PDBx:xref_db_name&gt;Pfam&lt;/PDBx:xref_db_name&gt;
      &lt;PDBx:xref_db_segment_id&gt;1&lt;/PDBx:xref_db_segment_id&gt;
      &lt;PDBx:xref_domain_name xsi:nil="true" /&gt;
   &lt;/PDBx:pdbx_sifts_xref_db&gt;
&lt;/PDBx:pdbx_sifts_xref_dbCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_sifts_xref_db.mh_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
