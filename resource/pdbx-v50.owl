                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp.pdbx_number_subcomponents">
      <rdfs:subPropertyOf rdf:resource="#chem_compItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>chem_comp.pdbx_number_subcomponents</rdfs:label>
      <rdfs:comment xml:lang="en">
The number of subcomponents represented in this component.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp.pdbx_pcm">
      <rdfs:subPropertyOf rdf:resource="#chem_compItem"/>
      <rdfs:domain rdf:resource="#chem_comp"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Y</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N</rdf:first>
