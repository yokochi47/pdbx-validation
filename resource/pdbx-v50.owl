      <rdfs:label>reference_to_pdbx_struct_assembly_gen</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to pdbx_struct_assembly_gen.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
