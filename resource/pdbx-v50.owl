      &lt;PDBx:domain_name&gt;SF&lt;/PDBx:domain_name&gt;
   &lt;/PDBx:pdbx_sifts_xref_db_segments&gt;
&lt;/PDBx:pdbx_sifts_xref_db_segmentsCategory&gt;


