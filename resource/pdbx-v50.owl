   <owl:Class rdf:ID="pdbx_struct_chem_comp_diagnostics">
      <rdfs:label>pdbx_struct_chem_comp_diagnostics</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_STRUCT_CHEM_COMP_DIAGNOSTICS category provides
structural diagnostics in chemical components instances.

    Example 1 -
&lt;PDBx:pdbx_struct_chem_comp_diagnosticsCategory&gt;
   &lt;PDBx:pdbx_struct_chem_comp_diagnostics ordinal="1"&gt;
      &lt;PDBx:asym_id&gt;Q&lt;/PDBx:asym_id&gt;
      &lt;PDBx:auth_comp_id&gt;Q20&lt;/PDBx:auth_comp_id&gt;
      &lt;PDBx:auth_seq_id&gt;10&lt;/PDBx:auth_seq_id&gt;
      &lt;PDBx:details&gt;Strained geometry.  Long carbonyl bond at C10.&lt;/PDBx:details&gt;
      &lt;PDBx:pdb_strand_id&gt;Q&lt;/PDBx:pdb_strand_id&gt;
      &lt;PDBx:seq_num xsi:nil="true" /&gt;
      &lt;PDBx:type&gt;GEOMETRY&lt;/PDBx:type&gt;
   &lt;/PDBx:pdbx_struct_chem_comp_diagnostics&gt;
&lt;/PDBx:pdbx_struct_chem_comp_diagnosticsCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_struct_chem_comp_diagnostics.asym_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_struct_chem_comp_diagnostics.asym_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_struct_chem_comp_diagnostics.auth_comp_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_struct_chem_comp_diagnostics.auth_comp_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_struct_chem_comp_diagnostics.auth_seq_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_struct_chem_comp_diagnostics.auth_seq_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_struct_chem_comp_diagnostics.details"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_struct_chem_comp_diagnostics.details"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_struct_chem_comp_diagnostics.pdb_ins_code"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_struct_chem_comp_diagnostics.pdb_ins_code"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_struct_chem_comp_diagnostics.pdb_strand_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_struct_chem_comp_diagnostics.pdb_strand_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_struct_chem_comp_diagnostics.seq_num"/>
