      <rdfs:subPropertyOf rdf:resource="#pdbx_domainItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_domain.details</rdfs:label>
      <rdfs:comment xml:lang="en">
A description of special aspects of the structural elements that
comprise a domain.
                                 The loop between residues 18 and 23.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_domain.id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_domainItem"/>
