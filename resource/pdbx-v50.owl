      <rdfs:comment xml:lang="en">

PDBML Schema translated from the PDBx/mmCIF Dictionary v5.414:
 http://mmcif.wwpdb.org/dictionaries/ascii/mmcif_pdbx_v50.dic

        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://pdbml.pdb.org/schema/pdbx-v50.xsd"/>
   </owl:DatatypeProperty>
   <owl:InverseFunctionalProperty rdf:ID="hasCategory">
      <rdfs:comment xml:lang="en">Abstract property pointing to category.</rdfs:comment>
