   <owl:Class rdf:ID="pdbx_entity_src_gen_express">
      <rdfs:label>pdbx_entity_src_gen_express</rdfs:label>
      <rdfs:comment xml:lang="en">
This category contains details for the EXPRESSION steps used in
the overall protein production process. It is hoped that this category
will cover all forms of cell-based expression by reading induction as
induction/transformation/transfection.

         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_src_gen_express.C_terminal_seq_tag"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
