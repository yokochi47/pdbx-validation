      <rdfs:label>pdbx_view_category_groupItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for pdbx_view_category_group items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#pdbx_view_category_group"/>
   </owl:DatatypeProperty>
