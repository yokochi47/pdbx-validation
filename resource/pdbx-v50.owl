      <rdfs:subPropertyOf rdf:resource="#pdbx_soln_scatterItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_soln_scatter.mean_guiner_radius</rdfs:label>
