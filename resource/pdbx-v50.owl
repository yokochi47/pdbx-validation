      <rdfs:label>reference_to_pdbx_summary_flags</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to pdbx_summary_flags.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#pdbx_summary_flags"/>
   </owl:ObjectProperty>
