      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_entity_src_gen_refold.denature_buffer_id</rdfs:label>
      <rdfs:comment xml:lang="en">
This item is a pointer to pdbx_buffer.id in the PDBX_BUFFER category.
The referenced buffer is that in which the protein was denatured.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_entity_src_gen_refold.details">
      <rdfs:subPropertyOf rdf:resource="#pdbx_entity_src_gen_refoldItem"/>
