   <owl:InverseFunctionalProperty rdf:ID="has_journalCategory">
      <rdfs:label>journalCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that datablock
        has a category holder journalCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#journal"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_journal">
      <rdfs:label>journalCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that journalCategory.
        has a category journal.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#journal"/>
      <rdfs:domain rdf:resource="#journalCategory"/>
      <rdfs:range rdf:resource="#journal"/>
   </owl:InverseFunctionalProperty>
