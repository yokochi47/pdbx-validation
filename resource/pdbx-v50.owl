                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

Common name or abbreviation used in the literature for the molecule used
as a chemical shift reference.
DSS
                     </rdfs:comment>
   </owl:DatatypeProperty>
