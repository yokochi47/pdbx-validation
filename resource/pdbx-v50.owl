   <owl:DatatypeProperty rdf:ID="em_entity_assembly_naturalsource.cell">
      <rdfs:subPropertyOf rdf:resource="#em_entity_assembly_naturalsourceItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_entity_assembly_naturalsource.cell</rdfs:label>
      <rdfs:comment xml:lang="en">
The cell type from which the component was obtained.
CHO
HELA
3T3
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_entity_assembly_naturalsource.cellular_location">
      <rdfs:subPropertyOf rdf:resource="#em_entity_assembly_naturalsourceItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_entity_assembly_naturalsource.cellular_location</rdfs:label>
      <rdfs:comment xml:lang="en">
The cellular location of the component.
cytoplasm
endoplasmic reticulum
plasma membrane
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_entity_assembly_naturalsource.details">
      <rdfs:subPropertyOf rdf:resource="#em_entity_assembly_naturalsourceItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_entity_assembly_naturalsource.details</rdfs:label>
