This data item is a pointer to attribute id in category struct_asym in the
 STRUCT_ASYM category.
1
A
2B3
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_sifts_unp_segments.entity_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_sifts_unp_segmentsItem"/>
