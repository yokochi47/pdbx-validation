                                                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Terminal acetylation</rdf:first>
                                                                                                <rdf:rest>
                                                                                                   <rdf:List>
                                                                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Terminal amidation</rdf:first>
                                                                                                      <rdf:rest>
                                                                                                         <rdf:List>
                                                                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Metal coordination</rdf:first>
                                                                                                            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                                         </rdf:List>
                                                                                                      </rdf:rest>
                                                                                                   </rdf:List>
                                                                                                </rdf:rest>
                                                                                             </rdf:List>
                                                                                          </rdf:rest>
                                                                                       </rdf:List>
                                                                                    </rdf:rest>
                                                                                 </rdf:List>
                                                                              </rdf:rest>
