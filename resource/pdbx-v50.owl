   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_struct_assembly_gen.auth_asym_id_list">
      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_assembly_genItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_struct_assembly_gen.auth_asym_id_list</rdfs:label>
      <rdfs:comment xml:lang="en">
This data item is a pointer to attribute auth_asym_id in category atom_site in
 the ATOM_SITE category.

This item may be expressed as a comma separated list of identifiers.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_struct_assembly_gen.entity_inst_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_assembly_genItem"/>
