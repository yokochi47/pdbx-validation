      <rdfs:label>reference_to_pdbx_struct_asym_gen</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to pdbx_struct_asym_gen.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#pdbx_struct_asym_gen"/>
   </owl:ObjectProperty>
