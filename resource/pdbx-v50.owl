      <rdfs:comment xml:lang="en">cross-reference to struct_biol_gen.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#struct_biol_gen"/>
   </owl:ObjectProperty>
