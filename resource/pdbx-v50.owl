20
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nmr_ensemble.distance_constraint_violation_method">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nmr_ensembleItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
