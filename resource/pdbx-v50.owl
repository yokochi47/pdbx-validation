   <owl:Class rdf:ID="pdbx_modification_featureCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_pdbx_modification_feature"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="pdbx_modification_feature">
      <rdfs:label>pdbx_modification_feature</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_MODIFICATION_FEATURE category provides 
information about all the protein modifications that have been 
modeled in the entry.

    An example of the category in an entry that contains a disulfide bridge and 
    two phosphoserine modifications.
&lt;PDBx:pdbx_modification_featureCategory&gt;
   &lt;PDBx:pdbx_modification_feature ordinal="1"&gt;
      &lt;PDBx:auth_asym_id&gt;A&lt;/PDBx:auth_asym_id&gt;
      &lt;PDBx:auth_comp_id&gt;SEP&lt;/PDBx:auth_comp_id&gt;
      &lt;PDBx:auth_seq_id&gt;65&lt;/PDBx:auth_seq_id&gt;
      &lt;PDBx:category&gt;Named protein modification&lt;/PDBx:category&gt;
      &lt;PDBx:comp_id_linking_atom xsi:nil="true" /&gt;
      &lt;PDBx:label_asym_id&gt;A&lt;/PDBx:label_asym_id&gt;
      &lt;PDBx:label_comp_id&gt;SEP&lt;/PDBx:label_comp_id&gt;
      &lt;PDBx:label_seq_id&gt;65&lt;/PDBx:label_seq_id&gt;
      &lt;PDBx:modified_residue_PDB_ins_code xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_auth_asym_id xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_auth_comp_id xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_auth_seq_id xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_id&gt;SER&lt;/PDBx:modified_residue_id&gt;
      &lt;PDBx:modified_residue_id_linking_atom xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_label_alt_id xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_label_asym_id xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_label_comp_id xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_label_seq_id xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_symmetry xsi:nil="true" /&gt;
      &lt;PDBx:ref_comp_id&gt;SEP&lt;/PDBx:ref_comp_id&gt;
      &lt;PDBx:ref_pcm_id&gt;1&lt;/PDBx:ref_pcm_id&gt;
      &lt;PDBx:symmetry&gt;1_555&lt;/PDBx:symmetry&gt;
      &lt;PDBx:type&gt;Phosphorylation&lt;/PDBx:type&gt;
   &lt;/PDBx:pdbx_modification_feature&gt;
   &lt;PDBx:pdbx_modification_feature ordinal="2"&gt;
      &lt;PDBx:auth_asym_id&gt;B&lt;/PDBx:auth_asym_id&gt;
      &lt;PDBx:auth_comp_id&gt;SEP&lt;/PDBx:auth_comp_id&gt;
      &lt;PDBx:auth_seq_id&gt;65&lt;/PDBx:auth_seq_id&gt;
      &lt;PDBx:category&gt;Named protein modification&lt;/PDBx:category&gt;
      &lt;PDBx:comp_id_linking_atom xsi:nil="true" /&gt;
      &lt;PDBx:label_asym_id&gt;B&lt;/PDBx:label_asym_id&gt;
      &lt;PDBx:label_comp_id&gt;SEP&lt;/PDBx:label_comp_id&gt;
      &lt;PDBx:label_seq_id&gt;65&lt;/PDBx:label_seq_id&gt;
      &lt;PDBx:modified_residue_PDB_ins_code xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_auth_asym_id xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_auth_comp_id xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_auth_seq_id xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_id&gt;SER&lt;/PDBx:modified_residue_id&gt;
      &lt;PDBx:modified_residue_id_linking_atom xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_label_alt_id xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_label_asym_id xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_label_comp_id xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_label_seq_id xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_symmetry xsi:nil="true" /&gt;
      &lt;PDBx:ref_comp_id&gt;SEP&lt;/PDBx:ref_comp_id&gt;
      &lt;PDBx:ref_pcm_id&gt;1&lt;/PDBx:ref_pcm_id&gt;
      &lt;PDBx:symmetry&gt;1_555&lt;/PDBx:symmetry&gt;
      &lt;PDBx:type&gt;Phosphorylation&lt;/PDBx:type&gt;
   &lt;/PDBx:pdbx_modification_feature&gt;
   &lt;PDBx:pdbx_modification_feature ordinal="3"&gt;
      &lt;PDBx:auth_asym_id&gt;A&lt;/PDBx:auth_asym_id&gt;
      &lt;PDBx:auth_comp_id&gt;CYS&lt;/PDBx:auth_comp_id&gt;
      &lt;PDBx:auth_seq_id&gt;46&lt;/PDBx:auth_seq_id&gt;
      &lt;PDBx:category&gt;Disulfide bridge&lt;/PDBx:category&gt;
      &lt;PDBx:comp_id_linking_atom&gt;SG&lt;/PDBx:comp_id_linking_atom&gt;
      &lt;PDBx:label_asym_id&gt;A&lt;/PDBx:label_asym_id&gt;
      &lt;PDBx:label_comp_id&gt;CYS&lt;/PDBx:label_comp_id&gt;
      &lt;PDBx:label_seq_id&gt;46&lt;/PDBx:label_seq_id&gt;
      &lt;PDBx:modified_residue_auth_asym_id&gt;B&lt;/PDBx:modified_residue_auth_asym_id&gt;
      &lt;PDBx:modified_residue_auth_comp_id&gt;CYS&lt;/PDBx:modified_residue_auth_comp_id&gt;
      &lt;PDBx:modified_residue_auth_seq_id&gt;46&lt;/PDBx:modified_residue_auth_seq_id&gt;
      &lt;PDBx:modified_residue_id xsi:nil="true" /&gt;
      &lt;PDBx:modified_residue_id_linking_atom&gt;SG&lt;/PDBx:modified_residue_id_linking_atom&gt;
      &lt;PDBx:modified_residue_label_asym_id&gt;B&lt;/PDBx:modified_residue_label_asym_id&gt;
      &lt;PDBx:modified_residue_label_comp_id&gt;CYS&lt;/PDBx:modified_residue_label_comp_id&gt;
      &lt;PDBx:modified_residue_label_seq_id&gt;46&lt;/PDBx:modified_residue_label_seq_id&gt;
      &lt;PDBx:modified_residue_symmetry&gt;1_555&lt;/PDBx:modified_residue_symmetry&gt;
      &lt;PDBx:ref_comp_id xsi:nil="true" /&gt;
      &lt;PDBx:ref_pcm_id xsi:nil="true" /&gt;
      &lt;PDBx:symmetry&gt;1_555&lt;/PDBx:symmetry&gt;
      &lt;PDBx:type&gt;None&lt;/PDBx:type&gt;
   &lt;/PDBx:pdbx_modification_feature&gt;
&lt;/PDBx:pdbx_modification_featureCategory&gt;


    An example of the category in an entry that contains a two cysteine 
    hydroxylation modification sites and two palmitoylation modification sites.
&lt;PDBx:pdbx_modification_featureCategory&gt;
   &lt;PDBx:pdbx_modification_feature ordinal="1"&gt;
      &lt;PDBx:auth_asym_id&gt;C&lt;/PDBx:auth_asym_id&gt;
      &lt;PDBx:auth_comp_id&gt;CSO&lt;/PDBx:auth_comp_id&gt;
