   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="struct_mon_nucl.tau2">
      <rdfs:subPropertyOf rdf:resource="#struct_mon_nuclItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>struct_mon_nucl.tau2</rdfs:label>
