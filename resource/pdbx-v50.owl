            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_pdbx_nonstandard_list"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="pdbx_nonstandard_list">
      <rdfs:label>pdbx_nonstandard_list</rdfs:label>
      <rdfs:comment xml:lang="en">
The information in this category is exclusively used to store
the HET records of a PDB file.  This record will be generated
by the PROGRAM.

    Example 1 - based on NDB entry DDLB57.
&lt;PDBx:pdbx_nonstandard_listCategory&gt;
   &lt;PDBx:pdbx_nonstandard_list id="BR" label_asym_id="A"&gt;
      &lt;PDBx:label_seq_num&gt;3&lt;/PDBx:label_seq_num&gt;
      &lt;PDBx:number_atoms_nh&gt;1&lt;/PDBx:number_atoms_nh&gt;
   &lt;/PDBx:pdbx_nonstandard_list&gt;
   &lt;PDBx:pdbx_nonstandard_list id="BR" label_asym_id="C"&gt;
      &lt;PDBx:label_seq_num&gt;27&lt;/PDBx:label_seq_num&gt;
      &lt;PDBx:number_atoms_nh&gt;1&lt;/PDBx:number_atoms_nh&gt;
   &lt;/PDBx:pdbx_nonstandard_list&gt;
   &lt;PDBx:pdbx_nonstandard_list id="CPT" label_asym_id="E"&gt;
      &lt;PDBx:label_seq_num&gt;49&lt;/PDBx:label_seq_num&gt;
      &lt;PDBx:number_atoms_nh&gt;3&lt;/PDBx:number_atoms_nh&gt;
   &lt;/PDBx:pdbx_nonstandard_list&gt;
   &lt;PDBx:pdbx_nonstandard_list id="CPT" label_asym_id="F"&gt;
      &lt;PDBx:label_seq_num&gt;50&lt;/PDBx:label_seq_num&gt;
      &lt;PDBx:number_atoms_nh&gt;3&lt;/PDBx:number_atoms_nh&gt;
   &lt;/PDBx:pdbx_nonstandard_list&gt;
&lt;/PDBx:pdbx_nonstandard_listCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonstandard_list.auth_asym_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonstandard_list.auth_asym_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonstandard_list.auth_seq_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonstandard_list.auth_seq_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonstandard_list.ins_code"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonstandard_list.ins_code"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonstandard_list.label_seq_num"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonstandard_list.label_seq_num"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonstandard_list.number_atoms_nh"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nonstandard_list.number_atoms_nh"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
