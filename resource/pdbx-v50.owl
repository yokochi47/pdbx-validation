                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
Flag indicating that all polymer chains are used in the assembly
Y
                        </rdfs:comment>
   </owl:DatatypeProperty>
