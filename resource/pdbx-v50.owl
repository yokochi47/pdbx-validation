                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_density.pdbid">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_densityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
