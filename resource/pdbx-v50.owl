   <owl:DatatypeProperty rdf:ID="pdbx_refine_component.auth_asym_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_refine_componentItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_refine_component.auth_asym_id</rdfs:label>
      <rdfs:comment xml:lang="en">
A component of the identifier for the component.

This data item is a pointer to attribute auth_asym_id in category atom_site in the
 ATOM_SITE category.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_refine_component.auth_comp_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_refine_componentItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_refine_component.auth_comp_id</rdfs:label>
      <rdfs:comment xml:lang="en">
A component of the identifier for the component.

This data item is a pointer to attribute auth_comp_id in category atom_site in the
