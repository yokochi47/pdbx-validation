   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_chemical_formula">
      <rdfs:label>referenced_by_chemical_formula</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from chemical_formula.</rdfs:comment>
