      <rdfs:comment xml:lang="en">cross-reference to em_obsolete.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#em_obsolete"/>
   </owl:ObjectProperty>
