   <owl:Class rdf:ID="pdbx_supporting_exp_data_set">
      <rdfs:label>pdbx_supporting_exp_data_set</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_SUPPORTING_EXP_DATA_SET category record
to experimental data set dependencies for this entry.

    Example 1 -
&lt;PDBx:pdbx_supporting_exp_data_setCategory&gt;
   &lt;PDBx:pdbx_supporting_exp_data_set ordinal="1"&gt;
      &lt;PDBx:data_content_type&gt;X-ray structure factor amplitudes&lt;/PDBx:data_content_type&gt;
      &lt;PDBx:data_version_major&gt;1&lt;/PDBx:data_version_major&gt;
      &lt;PDBx:data_version_minor&gt;2&lt;/PDBx:data_version_minor&gt;
   &lt;/PDBx:pdbx_supporting_exp_data_set&gt;
&lt;/PDBx:pdbx_supporting_exp_data_setCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_supporting_exp_data_set.data_content_type"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_supporting_exp_data_set.data_content_type"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_supporting_exp_data_set.data_version_major"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_supporting_exp_data_set.data_version_major"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_supporting_exp_data_set.data_version_minor"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_supporting_exp_data_set.data_version_minor"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_supporting_exp_data_set.details"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_supporting_exp_data_set.details"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_supporting_exp_data_set.ordinal"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
