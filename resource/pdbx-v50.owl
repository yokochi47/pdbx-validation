      <rdfs:subPropertyOf rdf:resource="#em_entity_assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>em_entity_assembly.parent_id</rdfs:label>
      <rdfs:comment xml:lang="en">
The parent of this assembly.
This data item is an internal category pointer to attribute id.
 in category em_entity_assembly By convention, the full assembly (top of hierarchy) is assigned parent id 0 (zero).
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_entity_assembly.source">
      <rdfs:subPropertyOf rdf:resource="#em_entity_assemblyItem"/>
      <rdfs:domain rdf:resource="#em_entity_assembly"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NATURAL</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RECOMBINANT</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MULTIPLE SOURCES</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYNTHETIC</rdf:first>
                                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
The type of source (e.g., natural source) for the component (sample or sample
subcomponent)
                        </rdfs:comment>
   </owl:DatatypeProperty>
