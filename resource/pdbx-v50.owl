      <rdfs:range rdf:resource="#pdbx_entity_remapping"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_entity_remapping.orig_entity_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_entity_remappingItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
