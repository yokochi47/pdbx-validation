                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="geom_contact.atom_site_id_2">
      <rdfs:subPropertyOf rdf:resource="#geom_contactItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>geom_contact.atom_site_id_2</rdfs:label>
