   <owl:Class rdf:ID="pdbx_na_struct_keywds">
      <rdfs:label>pdbx_na_struct_keywds</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_NA_STRUCT_KEYWDS category record give details
about structural features of the NA.

    Example 1 - based on NDB entry UDJ031
&lt;PDBx:pdbx_na_struct_keywdsCategory&gt;
   &lt;PDBx:pdbx_na_struct_keywds entry_id="UDJ031"&gt;
      &lt;PDBx:conformation_type&gt;B&lt;/PDBx:conformation_type&gt;
      &lt;PDBx:special_feature&gt;         FLIPPED-OUT BASES, INTERMOLECULAR BASE TRIPLET&lt;/PDBx:special_feature&gt;
      &lt;PDBx:strand_description&gt;DOUBLE HELIX&lt;/PDBx:strand_description&gt;
   &lt;/PDBx:pdbx_na_struct_keywds&gt;
&lt;/PDBx:pdbx_na_struct_keywdsCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_na_struct_keywds.conformation_type"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_na_struct_keywds.conformation_type"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_na_struct_keywds.special_feature"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_na_struct_keywds.special_feature"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_na_struct_keywds.strand_description"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_na_struct_keywds.strand_description"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_na_struct_keywds.entry_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_pdbx_na_struct_keywdsCategory">
      <rdfs:label>pdbx_na_struct_keywdsCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that datablock
        has a category holder pdbx_na_struct_keywdsCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#pdbx_na_struct_keywds"/>
   </owl:InverseFunctionalProperty>
