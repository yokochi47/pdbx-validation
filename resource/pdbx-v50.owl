      &lt;PDBx:label_comp_id&gt;SF4&lt;/PDBx:label_comp_id&gt;
      &lt;PDBx:label_seq_id xsi:nil="true" /&gt;
      &lt;PDBx:provenance&gt;Author&lt;/PDBx:provenance&gt;
      &lt;PDBx:type&gt;Group charge&lt;/PDBx:type&gt;
      &lt;PDBx:value&gt;2&lt;/PDBx:value&gt;
   &lt;/PDBx:pdbx_nonpoly_feature&gt;
&lt;/PDBx:pdbx_nonpoly_featureCategory&gt;


         </rdfs:comment>
