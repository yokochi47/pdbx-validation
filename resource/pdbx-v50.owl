      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_depui_entity_features.dep_dataset_id</rdfs:label>
      <rdfs:comment xml:lang="en">
The internal identifier assigned to each deposition.
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_depui_entity_features.entity_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_depui_entity_featuresItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_depui_entity_features.entity_id</rdfs:label>
