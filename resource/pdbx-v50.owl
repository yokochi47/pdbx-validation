      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="pdbx_chem_comp_feature">
      <rdfs:label>pdbx_chem_comp_feature</rdfs:label>
      <rdfs:comment xml:lang="en">
Additional features associated with the chemical component.

    Example 1 -
&lt;PDBx:pdbx_chem_comp_featureCategory&gt;
   &lt;PDBx:pdbx_chem_comp_feature comp_id="05L" source="PDB" type="CARBOHYDRATE ANOMER" value="beta"&gt;&lt;/PDBx:pdbx_chem_comp_feature&gt;
   &lt;PDBx:pdbx_chem_comp_feature comp_id="05L" source="PDB" type="CARBOHYDRATE ISOMER" value="D"&gt;&lt;/PDBx:pdbx_chem_comp_feature&gt;
   &lt;PDBx:pdbx_chem_comp_feature comp_id="07E" source="PDB" type="CARBOHYDRATE RING" value="pyranose"&gt;&lt;/PDBx:pdbx_chem_comp_feature&gt;
&lt;/PDBx:pdbx_chem_comp_featureCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_feature.support"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_feature.support"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_feature.comp_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_feature.source"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_feature.type"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_chem_comp_feature.value"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_pdbx_chem_comp_featureCategory">
      <rdfs:label>pdbx_chem_comp_featureCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that datablock
        has a category holder pdbx_chem_comp_featureCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#pdbx_chem_comp_feature"/>
   </owl:InverseFunctionalProperty>
