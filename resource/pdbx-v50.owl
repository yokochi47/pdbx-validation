        has a category pdbx_database_status_history.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#pdbx_database_status_history"/>
      <rdfs:domain rdf:resource="#pdbx_database_status_historyCategory"/>
      <rdfs:range rdf:resource="#pdbx_database_status_history"/>
   </owl:InverseFunctionalProperty>
