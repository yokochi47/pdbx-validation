      <rdfs:label>pdbx_summary_flags.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">
Entry ID.
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_summary_flags.flag_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_summary_flagsItem"/>
      <rdfs:domain rdf:resource="#pdbx_summary_flags"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">experimental_data_Y_N</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anisotropic_refinement_Y_N</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
A feature flag name.
                     </rdfs:comment>
   </owl:DatatypeProperty>
