    <PDBo:has_em_3d_fittingCategory>
      <PDBo:em_3d_fittingCategory rdf:about="http://rdf.wwpdb.org/pdb/7ZBU/em_3d_fittingCategory">
        <PDBo:has_em_3d_fitting>
          <PDBo:em_3d_fitting rdf:about="http://rdf.wwpdb.org/pdb/7ZBU/em_3d_fitting/7ZBU,1">
            <PDBo:of_datablock rdf:resource="http://rdf.wwpdb.org/pdb/7ZBU"/>
            <PDBo:reference_to_entry>
