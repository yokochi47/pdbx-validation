            <PDBo:entity.type>polymer</PDBo:entity.type>
            <PDBo:link_to_enzyme rdf:resource="http://purl.uniprot.org/enzyme/3.4.23.-" rdfs:label="ec-code:3.4.23.-"/>
            <owl:sameAs rdf:resource="http://purl.uniprot.org/enzyme/3.4.23.-"/>
            <rdfs:seeAlso rdf:resource="http://identifiers.org/ec-code/3.4.23.-" rdfs:label="ec-code:3.4.23.-"/>
