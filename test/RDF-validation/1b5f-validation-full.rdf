                <PDBo:referenced_by_pdbx_entry_details rdf:resource="http://rdf.wwpdb.org/vrpt/1B5F/pdbx_entry_details/1B5F"/>
              </rdf:Description>
            </PDBo:reference_to_entry>
            <PDBo:pdbx_entry_details.entry_id>1B5F</PDBo:pdbx_entry_details.entry_id>
            <PDBo:pdbx_entry_details.compound_details>MATURE CARDOSIN A IS FOUND IN A TWO CHAIN FORM DUE TO A
POST-TRANSLATIONAL CLEAVAGE EVENT. A FIRST, 35 KD CHAIN
COMPRISES RESIDUES 0/1 - 238 AND THE SECOND 15 KD CHAIN
COMPRISES RESIDUES 243 - 326. THE ASYMMETRIC UNIT
CONTAINS TWO CARDOSIN A MOLECULES. MOLECULE 1 HAS BEEN
ASSIGNED CHAIN INDICATORS *A* AND *B*, AND MOLECULE 2
HAVE BEEN ASSIGNED CHAIN INDICATORS *C* AND *D*.</PDBo:pdbx_entry_details.compound_details>
          </PDBo:pdbx_entry_details>
        </PDBo:has_pdbx_entry_details>
      </PDBo:pdbx_entry_detailsCategory>
