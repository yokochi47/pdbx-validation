   <owl:DatatypeProperty rdf:ID="struct_asym.id">
      <rdfs:subPropertyOf rdf:resource="#struct_asymItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>struct_asym.id</rdfs:label>
      <rdfs:comment xml:lang="en">
The value of attribute id in category struct_asym must uniquely identify a record in
 the STRUCT_ASYM list.

Note that this item need not be a number; it can be any unique
identifier.
1
A
2B3
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_struct_asym.id.html"/>
