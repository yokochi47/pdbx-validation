      <rdfs:comment xml:lang="en">
Part of the identifier of the residue

This data item is a pointer to attribute auth_asym_id in category atom_site in the
 ATOM_SITE category.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_validate_torsion.auth_asym_id.html"/>
