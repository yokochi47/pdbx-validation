      &lt;VRPTx:atom_id_2 xsi:nil="true" /&gt;
      &lt;VRPTx:atom_stereo_config_1 xsi:nil="true" /&gt;
      &lt;VRPTx:atom_stereo_config_2 xsi:nil="true" /&gt;
      &lt;VRPTx:comp_id_1 xsi:nil="true" /&gt;
      &lt;VRPTx:comp_id_2 xsi:nil="true" /&gt;
