   <owl:Class rdf:ID="pdbx_coordinate_model">
      <rdfs:label>pdbx_coordinate_model</rdfs:label>
      <rdfs:comment xml:lang="en">
The details of the composition of the coordinate model.

    Example 1 -
&lt;VRPTx:pdbx_coordinate_modelCategory&gt;
   &lt;VRPTx:pdbx_coordinate_model asym_id="A"&gt;
      &lt;VRPTx:type&gt;CA ATOMS ONLY&lt;/VRPTx:type&gt;
   &lt;/VRPTx:pdbx_coordinate_model&gt;
   &lt;VRPTx:pdbx_coordinate_model asym_id="B"&gt;
      &lt;VRPTx:type&gt;CA ATOMS ONLY&lt;/VRPTx:type&gt;
   &lt;/VRPTx:pdbx_coordinate_model&gt;
   &lt;VRPTx:pdbx_coordinate_model asym_id="X"&gt;
      &lt;VRPTx:type&gt;P ATOMS ONLY&lt;/VRPTx:type&gt;
   &lt;/VRPTx:pdbx_coordinate_model&gt;
   &lt;VRPTx:pdbx_coordinate_model asym_id="Y"&gt;
      &lt;VRPTx:type&gt;P ATOMS ONLY&lt;/VRPTx:type&gt;
   &lt;/VRPTx:pdbx_coordinate_model&gt;
&lt;/VRPTx:pdbx_coordinate_modelCategory&gt;


         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://pdbml.pdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/pdbx_coordinate_model.html"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_coordinate_model.type"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_coordinate_model.type"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_coordinate_model.asym_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
      <owl:equivalentClass rdf:resource="PDBo:pdbx_coordinate_model"/>
   </owl:Class>
