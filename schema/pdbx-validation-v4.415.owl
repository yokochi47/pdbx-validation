   <owl:DatatypeProperty rdf:ID="phasing_MAD.details">
      <rdfs:subPropertyOf rdf:resource="#phasing_MADItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>phasing_MAD.details</rdfs:label>
      <rdfs:comment xml:lang="en">
A description of special aspects of the MAD phasing.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_phasing_MAD.details.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:phasing_MAD.details"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="phasing_MAD.method">
      <rdfs:subPropertyOf rdf:resource="#phasing_MADItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>phasing_MAD.method</rdfs:label>
      <rdfs:comment xml:lang="en">
A description of the MAD phasing method used to phase
this structure.

Note that this is not the computer program used, which is
described in the SOFTWARE category, but rather the method
itself.

This data item should be used to describe significant
methodological options used within the MAD phasing program.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_phasing_MAD.method.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:phasing_MAD.method"/>
   </owl:DatatypeProperty>
