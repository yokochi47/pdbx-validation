   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_struct_assembly_prop.biol_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_assembly_propItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_struct_assembly_prop.biol_id</rdfs:label>
      <rdfs:comment xml:lang="en">
The identifier for the assembly used in category PDBX_STRUCT_ASSEMBLY.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_struct_assembly_prop.biol_id.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_struct_assembly_prop.biol_id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_struct_assembly_prop.type">
      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_assembly_propItem"/>
      <rdfs:domain rdf:resource="#pdbx_struct_assembly_prop"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ABSA (A^2)</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SSA (A^2)</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MORE</rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
The property type for the assembly.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_struct_assembly_prop.type.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_struct_assembly_prop.type"/>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="pdbx_struct_asym_genCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_pdbx_struct_asym_gen"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
      <owl:equivalentClass rdf:resource="PDBo:pdbx_struct_asym_genCategory"/>
   </owl:Class>
   <owl:Class rdf:ID="pdbx_struct_asym_gen">
      <rdfs:label>pdbx_struct_asym_gen</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_STRUCT_ASYM_GEN category record details about
the generation of the crystallographic asymmetric unit. The
PDBX_STRUCT_ASYM_GEN data items provide the specifications of the
components that constitute the asymmetric unit in terms of cartesian
transformations of deposited coordinates.

    Example 1 -
&lt;VRPTx:pdbx_struct_asym_genCategory&gt;
   &lt;VRPTx:pdbx_struct_asym_gen entity_inst_id="A" oper_expression="1"&gt;
      &lt;VRPTx:asym_id&gt;A&lt;/VRPTx:asym_id&gt;
   &lt;/VRPTx:pdbx_struct_asym_gen&gt;
   &lt;VRPTx:pdbx_struct_asym_gen entity_inst_id="B" oper_expression="1"&gt;
      &lt;VRPTx:asym_id&gt;B&lt;/VRPTx:asym_id&gt;
   &lt;/VRPTx:pdbx_struct_asym_gen&gt;
&lt;/VRPTx:pdbx_struct_asym_genCategory&gt;


         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://pdbml.pdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/pdbx_struct_asym_gen.html"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_struct_asym_gen.asym_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_struct_asym_gen.asym_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_struct_asym_gen.entity_inst_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_struct_asym_gen.oper_expression"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
      <owl:equivalentClass rdf:resource="PDBo:pdbx_struct_asym_gen"/>
   </owl:Class>
