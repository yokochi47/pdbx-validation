The number of electron density positive peaks larger than 6 sigma.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_dcc_density.mFo-DFc-6sigma_positive.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_dcc_density.mFo-DFc-6sigma_positive"/>
