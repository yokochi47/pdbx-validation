      <owl:equivalentProperty rdf:resource="PDBo:pdbx_struct_assembly_gen.asym_id_list"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_struct_assembly_gen.oper_expression">
      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_assembly_genItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_struct_assembly_gen.oper_expression</rdfs:label>
      <rdfs:comment xml:lang="en">
Identifies the operation of collection of operations
from category PDBX_STRUCT_OPER_LIST.

Operation expressions may have the forms:

(1)        the single operation 1
(1,2,5)    the operations 1, 2, 5
(1-4)      the operations 1,2,3 and 4
(1,2)(3,4) the combinations of operations
3 and 4 followed by 1 and 2 (i.e.
the cartesian product of parenthetical
groups applied from right to left)
(1)
(1,2,5)
(1-60)
(1-60)(61)
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_struct_assembly_gen.oper_expression.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_struct_assembly_gen.oper_expression"/>
   </owl:DatatypeProperty>
