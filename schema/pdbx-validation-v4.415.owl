      <rdfs:comment xml:lang="en">
The measured value of the intensity in arbitrary units.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_refln_sys_abs.I.html"/>
