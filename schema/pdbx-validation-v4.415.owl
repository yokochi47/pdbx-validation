      <owl:equivalentProperty rdf:resource="PDBo:pdbx_dcc_geometry.angle_ligand_max"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_geometry.angle_ligand_rms">
