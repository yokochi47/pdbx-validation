      &lt;VRPTx:end_label_asym_id&gt;B&lt;/VRPTx:end_label_asym_id&gt;
      &lt;VRPTx:end_label_comp_id&gt;GLY&lt;/VRPTx:end_label_comp_id&gt;
      &lt;VRPTx:end_label_seq_id&gt;59&lt;/VRPTx:end_label_seq_id&gt;
   &lt;/VRPTx:struct_ncs_dom_lim&gt;
