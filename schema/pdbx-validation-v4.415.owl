      <rdfs:subPropertyOf rdf:resource="#pdbx_nmr_refineItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_nmr_refine.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">
You can leave this blank as an ID will be assigned by the RCSB.

                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_nmr_refine.entry_id.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_refine.entry_id"/>
      <owl:equivalentProperty rdf:resource="BMRBo:entry.id"/>
   </owl:DatatypeProperty>
