   <owl:DatatypeProperty rdf:ID="pdbx_helical_symmetry.circular_symmetry">
      <rdfs:subPropertyOf rdf:resource="#pdbx_helical_symmetryItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_helical_symmetry.circular_symmetry</rdfs:label>
      <rdfs:comment xml:lang="en">
Rotational n-fold symmetry about the helical axis.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_helical_symmetry.circular_symmetry.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_helical_symmetry.circular_symmetry"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_helical_symmetry.dyad_axis">
      <rdfs:subPropertyOf rdf:resource="#pdbx_helical_symmetryItem"/>
      <rdfs:domain rdf:resource="#pdbx_helical_symmetry"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
Two-fold symmetry perpendicular to the helical axis.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_helical_symmetry.dyad_axis.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_helical_symmetry.dyad_axis"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_helical_symmetry.n_subunits_divisor">
