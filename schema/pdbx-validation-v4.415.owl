      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_density_corrItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_dcc_density_corr.ls_number_reflns_obs</rdfs:label>
      <rdfs:comment xml:lang="en">
The number of unique reflections (work+test sets).
                        </rdfs:comment>
