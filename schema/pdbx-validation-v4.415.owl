   <owl:DatatypeProperty rdf:ID="pdbx_phasing_dm_shell.reflns">
      <rdfs:subPropertyOf rdf:resource="#pdbx_phasing_dm_shellItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_phasing_dm_shell.reflns</rdfs:label>
      <rdfs:comment xml:lang="en">
The value of attribute reflns in category pdbx_phasing_dm_shell identifies the number
