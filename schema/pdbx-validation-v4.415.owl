      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>struct_sheet_order.range_id_2</rdfs:label>
      <rdfs:comment xml:lang="en">
This data item is a pointer to attribute id in category struct_sheet_range in
 the STRUCT_SHEET_RANGE category.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_struct_sheet_order.range_id_2.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:struct_sheet_order.range_id_2"/>
