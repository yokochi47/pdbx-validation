      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#pdbx_em_fsc_resolution"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_pdbx_em_fsc_resolution">
      <rdfs:label>pdbx_em_fsc_resolutionCategory</rdfs:label>
