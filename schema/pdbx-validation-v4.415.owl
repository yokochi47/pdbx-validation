   <owl:DatatypeProperty rdf:ID="pdbx_point_symmetry.H-M_notation">
      <rdfs:subPropertyOf rdf:resource="#pdbx_point_symmetryItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_point_symmetry.H-M_notation</rdfs:label>
      <rdfs:comment xml:lang="en">
The Hermann-Mauguin notation for this point symmetry group.
I -&gt; 532
O -&gt; 432
T -&gt; 23
Cn -&gt; n (e.g. C5 -&gt; 5)
Dn -&gt; n22 (n even)
Dn -&gt; n2  (n odd)
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_point_symmetry.H-M_notation.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_point_symmetry.H-M_notation"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_point_symmetry.Schoenflies_symbol">
      <rdfs:subPropertyOf rdf:resource="#pdbx_point_symmetryItem"/>
      <rdfs:domain rdf:resource="#pdbx_point_symmetry"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">I</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">T</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D</rdf:first>
                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
The Schoenflies point symmetry symbol.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_point_symmetry.Schoenflies_symbol.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_point_symmetry.Schoenflies_symbol"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_point_symmetry.circular_symmetry">
      <rdfs:subPropertyOf rdf:resource="#pdbx_point_symmetryItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_point_symmetry.circular_symmetry</rdfs:label>
      <rdfs:comment xml:lang="en">
Rotational n-fold C and D point symmetry.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_point_symmetry.circular_symmetry.html"/>
