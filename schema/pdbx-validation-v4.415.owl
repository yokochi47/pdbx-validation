   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_imaging.alignment_procedure">
      <rdfs:subPropertyOf rdf:resource="#em_imagingItem"/>
      <rdfs:domain rdf:resource="#em_imaging"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NONE</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BASIC</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ZEMLIN TABLEAU</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COMA FREE</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OTHER</rdf:first>
                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
The type of procedure used to align the microscope electron beam.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_imaging.alignment_procedure.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_imaging.alignment_procedure"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_imaging.astigmatism">
      <rdfs:subPropertyOf rdf:resource="#em_imagingItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_imaging.astigmatism</rdfs:label>
      <rdfs:comment xml:lang="en">
Astigmatism
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_imaging.astigmatism.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_imaging.astigmatism"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_imaging.c2_aperture_diameter">
      <rdfs:subPropertyOf rdf:resource="#em_imagingItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_imaging.c2_aperture_diameter</rdfs:label>
      <rdfs:comment xml:lang="en">
The open diameter of the c2 condenser lens,
in microns.
100
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_imaging.c2_aperture_diameter.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_imaging.c2_aperture_diameter"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_imaging.calibrated_defocus_max">
      <rdfs:subPropertyOf rdf:resource="#em_imagingItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_imaging.calibrated_defocus_max</rdfs:label>
      <rdfs:comment xml:lang="en">
The maximum calibrated defocus value of the objective lens (in nanometres) used
to obtain the recorded images. Negative values refer to overfocus.
5000
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_imaging.calibrated_defocus_max.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_imaging.calibrated_defocus_max"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_imaging.calibrated_defocus_min">
      <rdfs:subPropertyOf rdf:resource="#em_imagingItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_imaging.calibrated_defocus_min</rdfs:label>
      <rdfs:comment xml:lang="en">
The minimum calibrated defocus value of the objective lens (in nanometres) used
to obtain the recorded images. Negative values refer to overfocus.
1200
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_imaging.calibrated_defocus_min.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_imaging.calibrated_defocus_min"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_imaging.calibrated_magnification">
      <rdfs:subPropertyOf rdf:resource="#em_imagingItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>em_imaging.calibrated_magnification</rdfs:label>
      <rdfs:comment xml:lang="en">
The magnification value obtained for a known standard just
prior to, during or just after the imaging experiment.
61200
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_imaging.calibrated_magnification.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_imaging.calibrated_magnification"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_imaging.citation_id">
      <rdfs:subPropertyOf rdf:resource="#em_imagingItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_imaging.citation_id</rdfs:label>
      <rdfs:comment xml:lang="en">
This data item is a pointer to attribute id in category citation in
 the CITATION category.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_imaging.citation_id.html"/>
