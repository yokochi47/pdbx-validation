      <rdfs:label>referenced_by_pdbx_em_raw_raps_marker</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from pdbx_em_raw_raps_marker.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
