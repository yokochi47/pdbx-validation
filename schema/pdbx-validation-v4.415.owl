   <owl:Class rdf:ID="pdbx_phasing_MAD_set_site">
      <rdfs:label>pdbx_phasing_MAD_set_site</rdfs:label>
      <rdfs:comment xml:lang="en">
Record the details (coordinates etc.) of anomalous scatters.



