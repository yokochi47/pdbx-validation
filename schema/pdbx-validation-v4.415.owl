      <rdfs:subPropertyOf rdf:resource="#em_image_recordingItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_image_recording.avg_electron_dose_per_image</rdfs:label>
      <rdfs:comment xml:lang="en">
The electron dose received by the specimen per image (electrons per square angstrom).
30.0
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_image_recording.avg_electron_dose_per_image.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_image_recording.avg_electron_dose_per_image"/>
   </owl:DatatypeProperty>
