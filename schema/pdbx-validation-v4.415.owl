      <rdfs:comment xml:lang="en">
The value of attribute sigma_I_translation in category pdbx_phasing_MR identifies the
 sigma cut off of intensity used for translation search.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_phasing_MR.sigma_I_translation.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_phasing_MR.sigma_I_translation"/>
   </owl:DatatypeProperty>
