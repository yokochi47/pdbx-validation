      <rdfs:domain rdf:resource="#pdbx_struct_nmr_ens_clustCategory"/>
      <rdfs:range rdf:resource="#pdbx_struct_nmr_ens_clust"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_struct_nmr_ens_clustItem">
      <rdfs:label>pdbx_struct_nmr_ens_clustItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for pdbx_struct_nmr_ens_clust items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#pdbx_struct_nmr_ens_clust"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_pdbx_struct_nmr_ens_clust">
      <rdfs:label>reference_to_pdbx_struct_nmr_ens_clust</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to pdbx_struct_nmr_ens_clust.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#pdbx_struct_nmr_ens_clust"/>
   </owl:ObjectProperty>
