   <owl:Class rdf:ID="struct_ncs_oper">
      <rdfs:label>struct_ncs_oper</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the STRUCT_NCS_OPER category describe the
noncrystallographic symmetry operations.

Each operator is specified as a matrix and a subsequent
translation vector. Operators need not represent proper
rotations.

    Example 1 - based on laboratory records for the protein NS1.
&lt;VRPTx:struct_ncs_operCategory&gt;
   &lt;VRPTx:struct_ncs_oper id="1"&gt;
      &lt;VRPTx:code&gt;given&lt;/VRPTx:code&gt;
      &lt;VRPTx:details&gt; Matrix and translation vector for pseudo-twofold operation.&lt;/VRPTx:details&gt;
      &lt;VRPTx:matrix11&gt;0.247&lt;/VRPTx:matrix11&gt;
      &lt;VRPTx:matrix12&gt;0.935&lt;/VRPTx:matrix12&gt;
      &lt;VRPTx:matrix13&gt;0.256&lt;/VRPTx:matrix13&gt;
      &lt;VRPTx:matrix21&gt;0.929&lt;/VRPTx:matrix21&gt;
      &lt;VRPTx:matrix22&gt;0.153&lt;/VRPTx:matrix22&gt;
      &lt;VRPTx:matrix23&gt;0.337&lt;/VRPTx:matrix23&gt;
      &lt;VRPTx:matrix31&gt;0.276&lt;/VRPTx:matrix31&gt;
      &lt;VRPTx:matrix32&gt;0.321&lt;/VRPTx:matrix32&gt;
      &lt;VRPTx:matrix33&gt;-0.906&lt;/VRPTx:matrix33&gt;
      &lt;VRPTx:vector1&gt;-8.253&lt;/VRPTx:vector1&gt;
      &lt;VRPTx:vector2&gt;-11.743&lt;/VRPTx:vector2&gt;
      &lt;VRPTx:vector3&gt;-1.782&lt;/VRPTx:vector3&gt;
   &lt;/VRPTx:struct_ncs_oper&gt;
&lt;/VRPTx:struct_ncs_operCategory&gt;


         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://pdbml.pdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/struct_ncs_oper.html"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_ncs_oper.code"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_ncs_oper.code"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_ncs_oper.details"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_ncs_oper.details"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_ncs_oper.matrix11"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_ncs_oper.matrix11"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_ncs_oper.matrix12"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_ncs_oper.matrix12"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_ncs_oper.matrix13"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_ncs_oper.matrix13"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_ncs_oper.matrix21"/>
