The highest resolution limit reported in the model file.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_dcc_density.ls_d_res_high.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_dcc_density.ls_d_res_high"/>
   </owl:DatatypeProperty>
