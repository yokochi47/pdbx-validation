      <rdfs:comment xml:lang="en">
The value of attribute sigma_F_rotation in category pdbx_phasing_MR identifies the
 sigma cut off of structure factor used for rotation search.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_phasing_MR.sigma_F_rotation.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_phasing_MR.sigma_F_rotation"/>
   </owl:DatatypeProperty>
