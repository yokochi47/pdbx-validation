   <owl:DatatypeProperty rdf:ID="em_admin.composite_map">
      <rdfs:subPropertyOf rdf:resource="#em_adminItem"/>
      <rdfs:domain rdf:resource="#em_admin"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">YES</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NO</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
Indicates whether the authors have declared that this is a composite map deposition
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_admin.composite_map.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_admin.composite_map"/>
   </owl:DatatypeProperty>
