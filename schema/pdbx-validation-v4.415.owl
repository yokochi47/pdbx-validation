   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nmr_force_constants.covalent_geom_angles_term_units">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nmr_force_constantsItem"/>
      <rdfs:domain rdf:resource="#pdbx_nmr_force_constants"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kcal/mol/rad**2</rdf:first>
                  <rdf:rest>
                     <rdf:List>
