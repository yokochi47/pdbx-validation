      <rdfs:label>em_imaging.date</rdfs:label>
      <rdfs:comment xml:lang="en">
Date (YYYY-MM-DD) of imaging experiment or the date at which
a series of experiments began.
2001-05-08
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_imaging.date.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_imaging.date"/>
   </owl:DatatypeProperty>
