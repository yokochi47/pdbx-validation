   <owl:DatatypeProperty rdf:ID="pdbx_entity_branch_list.hetero">
      <rdfs:subPropertyOf rdf:resource="#pdbx_entity_branch_listItem"/>
      <rdfs:domain rdf:resource="#pdbx_entity_branch_list"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">n</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">y</rdf:first>
                                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
A flag to indicate whether this monomer in the entity is
heterogeneous in sequence.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_entity_branch_list.hetero.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_entity_branch_list.hetero"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_entity_branch_list.comp_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_entity_branch_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_entity_branch_list.comp_id</rdfs:label>
      <rdfs:comment xml:lang="en">
This data item is a pointer to attribute id in category chem_comp in the CHEM_COMP
 category.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_entity_branch_list.comp_id.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_entity_branch_list.comp_id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_entity_branch_list.entity_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_entity_branch_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_entity_branch_list.entity_id</rdfs:label>
      <rdfs:comment xml:lang="en">
This data item is a pointer to attribute id in category entity in the ENTITY category. 
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_entity_branch_list.entity_id.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_entity_branch_list.entity_id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_entity_branch_list.num">
      <rdfs:subPropertyOf rdf:resource="#pdbx_entity_branch_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_entity_branch_list.num</rdfs:label>
      <rdfs:comment xml:lang="en">
The value pair  _pdbx_entity_branch_list.num and _pdbx_entity_branch_list.comp_id
must uniquely identify a record in the PDBX_ENTITY_BRANCH_LIST list.

                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_entity_branch_list.num.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_entity_branch_list.num"/>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="pdbx_entity_descriptorCategory">
      <rdfs:subClassOf>
