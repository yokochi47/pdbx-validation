 ATOM_SITE category.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_validate_rmsd_torsions_atom.label_alt_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_validate_rmsd_torsions_atomItem"/>
