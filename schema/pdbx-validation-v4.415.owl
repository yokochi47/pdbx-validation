      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_dcc_density.solvent_content.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_dcc_density.solvent_content"/>
