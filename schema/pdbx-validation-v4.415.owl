      <rdfs:label>em_imaging_optics.chr_aberration_corrector</rdfs:label>
      <rdfs:comment xml:lang="en">
Chromatic aberration corrector information
 CEOS manufactured Cc corrector
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_imaging_optics.chr_aberration_corrector.html"/>
