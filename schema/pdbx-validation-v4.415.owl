      <rdfs:comment xml:lang="en">cross-reference to pdbx_re_refinement.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#pdbx_re_refinement"/>
