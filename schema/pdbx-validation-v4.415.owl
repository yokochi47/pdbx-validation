                                                                                                                                          <rdf:rest>
                                                                                                                                             <rdf:List>
                                                                                                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chi31</rdf:first>
                                                                                                                                                <rdf:rest>
                                                                                                                                                   <rdf:List>
