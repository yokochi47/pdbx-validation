      &lt;VRPTx:number_of_monomers&gt;96&lt;/VRPTx:number_of_monomers&gt;
   &lt;/VRPTx:pdbx_struct_nmr_ens_dom&gt;
&lt;/VRPTx:pdbx_struct_nmr_ens_domCategory&gt;


