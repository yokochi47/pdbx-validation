               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#refine_analyze.number_disordered_residues"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
