   <owl:Class rdf:ID="em_virus_shell">
      <rdfs:label>em_virus_shell</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the EMD_VIRUS_SHELL category record details
of the viral shell number, shell diameter, and icosahedral triangulation number.

    Example 1 - Bluetongue Virus
&lt;VRPTx:em_virus_shellCategory&gt;
   &lt;VRPTx:em_virus_shell entity_assembly_id="1" id="1"&gt;
      &lt;VRPTx:diameter&gt;348&lt;/VRPTx:diameter&gt;
      &lt;VRPTx:name&gt;VP7 layer&lt;/VRPTx:name&gt;
      &lt;VRPTx:triangulation&gt;13&lt;/VRPTx:triangulation&gt;
   &lt;/VRPTx:em_virus_shell&gt;
   &lt;VRPTx:em_virus_shell entity_assembly_id="1" id="2"&gt;
      &lt;VRPTx:diameter&gt;348&lt;/VRPTx:diameter&gt;
      &lt;VRPTx:name&gt;VP3 layer&lt;/VRPTx:name&gt;
      &lt;VRPTx:triangulation&gt;2&lt;/VRPTx:triangulation&gt;
   &lt;/VRPTx:em_virus_shell&gt;
&lt;/VRPTx:em_virus_shellCategory&gt;


         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://pdbml.pdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/em_virus_shell.html"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_virus_shell.diameter"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_virus_shell.diameter"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_virus_shell.name"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_virus_shell.name"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_virus_shell.triangulation"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_virus_shell.triangulation"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_virus_shell.entity_assembly_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_virus_shell.id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
      <owl:equivalentClass rdf:resource="PDBo:em_virus_shell"/>
   </owl:Class>
