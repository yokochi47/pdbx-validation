      <rdfs:subPropertyOf rdf:resource="#em_entity_assembly_molwtItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_entity_assembly_molwt.id</rdfs:label>
      <rdfs:comment xml:lang="en">
PRIMARY KEY
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_entity_assembly_molwt.id.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_entity_assembly_molwt.id"/>
   </owl:DatatypeProperty>
