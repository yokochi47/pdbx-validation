   <owl:DatatypeProperty rdf:ID="pdbx_validate_symm_contact.site_symmetry_1">
      <rdfs:subPropertyOf rdf:resource="#pdbx_validate_symm_contactItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_validate_symm_contact.site_symmetry_1</rdfs:label>
      <rdfs:comment xml:lang="en">
The symmetry of the first of the two atoms define the close contact.
Symmetry defined in ORTEP style of 555 equal to unit cell with translations
+-1 from 555 as 000
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_validate_symm_contact.site_symmetry_1.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_validate_symm_contact.site_symmetry_1"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_validate_symm_contact.site_symmetry_2">
      <rdfs:subPropertyOf rdf:resource="#pdbx_validate_symm_contactItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_validate_symm_contact.site_symmetry_2</rdfs:label>
      <rdfs:comment xml:lang="en">
The symmetry of the second of the two atoms define the close contact.
Symmetry defined in ORTEP style of 555 equal to unit cell with translations
+-1 from 555 as 000
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_validate_symm_contact.site_symmetry_2.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_validate_symm_contact.site_symmetry_2"/>
   </owl:DatatypeProperty>
