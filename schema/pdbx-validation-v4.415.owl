   </owl:Class>
   <owl:Class rdf:ID="em_imaging_optics">
      <rdfs:label>em_imaging_optics</rdfs:label>
      <rdfs:comment xml:lang="en">
Description of a few specialist optics apparatus

    Example 1 -
&lt;VRPTx:em_imaging_opticsCategory&gt;
   &lt;VRPTx:em_imaging_optics id="1" imaging_id="1"&gt;
      &lt;VRPTx:chr_aberration_corrector&gt;CEOS manufactured Cc corrector&lt;/VRPTx:chr_aberration_corrector&gt;
      &lt;VRPTx:energyfilter_lower&gt;0&lt;/VRPTx:energyfilter_lower&gt;
      &lt;VRPTx:energyfilter_name&gt;FEI&lt;/VRPTx:energyfilter_name&gt;
      &lt;VRPTx:energyfilter_upper&gt;15&lt;/VRPTx:energyfilter_upper&gt;
   &lt;/VRPTx:em_imaging_optics&gt;
&lt;/VRPTx:em_imaging_opticsCategory&gt;


         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://pdbml.pdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/em_imaging_optics.html"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_imaging_optics.chr_aberration_corrector"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_imaging_optics.chr_aberration_corrector"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_imaging_optics.details"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_imaging_optics.details"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_imaging_optics.energyfilter_lower"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_imaging_optics.energyfilter_lower"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_imaging_optics.energyfilter_name"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_imaging_optics.energyfilter_name"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_imaging_optics.energyfilter_slit_width"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_imaging_optics.energyfilter_slit_width"/>
