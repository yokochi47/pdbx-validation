Angular rotation (degrees) in N subunits
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_helical_symmetry.rise_per_n_subunits.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_helical_symmetry.rise_per_n_subunits"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_helical_symmetry.rotation_per_n_subunits">
      <rdfs:subPropertyOf rdf:resource="#pdbx_helical_symmetryItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_helical_symmetry.rotation_per_n_subunits</rdfs:label>
      <rdfs:comment xml:lang="en">
Angular rotation (degrees) in N subunits
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_helical_symmetry.rotation_per_n_subunits.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_helical_symmetry.rotation_per_n_subunits"/>
   </owl:DatatypeProperty>
