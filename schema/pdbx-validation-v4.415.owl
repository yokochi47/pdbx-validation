      <owl:equivalentProperty rdf:resource="PDBo:pdbx_phasing_dm_shell.d_res_high"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_phasing_dm_shell.d_res_low">
