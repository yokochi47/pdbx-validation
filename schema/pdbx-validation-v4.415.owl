      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>struct_mon_nucl.label_comp_id</rdfs:label>
      <rdfs:comment xml:lang="en">
A component of the identifier for participants in the site.

This data item is a pointer to attribute label_comp_id in category atom_site in the
 ATOM_SITE category.
                        </rdfs:comment>
      <owl:equivalentProperty rdf:resource="PDBo:struct_mon_nucl.label_comp_id"/>
