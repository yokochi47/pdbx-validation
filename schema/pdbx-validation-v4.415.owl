      <owl:equivalentProperty rdf:resource="PDBo:has_pdbx_struct_asym_genCategory"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_pdbx_struct_asym_gen">
      <rdfs:label>pdbx_struct_asym_genCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that pdbx_struct_asym_genCategory.
        has a category pdbx_struct_asym_gen.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
