   <owl:DatatypeProperty rdf:ID="em_entity_assembly.chimera">
      <rdfs:subPropertyOf rdf:resource="#em_entity_assemblyItem"/>
      <rdfs:domain rdf:resource="#em_entity_assembly"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">YES</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NO</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
An indication if an assembly is contains a chimeric polymer
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_entity_assembly.chimera.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_entity_assembly.chimera"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_entity_assembly.details">
      <rdfs:subPropertyOf rdf:resource="#em_entity_assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_entity_assembly.details</rdfs:label>
      <rdfs:comment xml:lang="en">
Additional details about the sample or sample subcomponent.
Fab fragment generated by proteolytic cleavage of LA2 IgG antibody.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_entity_assembly.details.html"/>
