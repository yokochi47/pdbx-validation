      <rdfs:label>referenced_by_struct_mon_nucl</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from struct_mon_nucl.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
