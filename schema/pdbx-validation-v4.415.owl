      &lt;VRPTx:provider&gt;author&lt;/VRPTx:provider&gt;
      &lt;VRPTx:type&gt;Coordinate replacement&lt;/VRPTx:type&gt;
   &lt;/VRPTx:pdbx_audit_revision_details&gt;
&lt;/VRPTx:pdbx_audit_revision_detailsCategory&gt;


