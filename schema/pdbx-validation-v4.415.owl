      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#em_2d_crystal_entity"/>
      <owl:equivalentProperty rdf:resource="PDBo:referenced_by_em_2d_crystal_entity"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="em_2d_crystal_entity.angle_gamma">
      <rdfs:subPropertyOf rdf:resource="#em_2d_crystal_entityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_2d_crystal_entity.angle_gamma</rdfs:label>
      <rdfs:comment xml:lang="en">
Unit-cell angle gamma in degrees.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_2d_crystal_entity.angle_gamma.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_2d_crystal_entity.angle_gamma"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_2d_crystal_entity.c_sampling_length">
      <rdfs:subPropertyOf rdf:resource="#em_2d_crystal_entityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_2d_crystal_entity.c_sampling_length</rdfs:label>
      <rdfs:comment xml:lang="en">
Length used to sample the reciprocal lattice lines in the c-direction.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_2d_crystal_entity.c_sampling_length.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_2d_crystal_entity.c_sampling_length"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_2d_crystal_entity.length_a">
      <rdfs:subPropertyOf rdf:resource="#em_2d_crystal_entityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_2d_crystal_entity.length_a</rdfs:label>
      <rdfs:comment xml:lang="en">
Unit-cell length a in angstroms.
62.4
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_2d_crystal_entity.length_a.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_2d_crystal_entity.length_a"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_2d_crystal_entity.length_b">
      <rdfs:subPropertyOf rdf:resource="#em_2d_crystal_entityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_2d_crystal_entity.length_b</rdfs:label>
      <rdfs:comment xml:lang="en">
Unit-cell length b in angstroms.
62.4
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_2d_crystal_entity.length_b.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_2d_crystal_entity.length_b"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_2d_crystal_entity.length_c">
      <rdfs:subPropertyOf rdf:resource="#em_2d_crystal_entityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_2d_crystal_entity.length_c</rdfs:label>
