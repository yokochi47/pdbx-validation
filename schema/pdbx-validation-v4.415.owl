      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#pdbx_entity_assembly"/>
      <owl:equivalentProperty rdf:resource="PDBo:referenced_by_pdbx_entity_assembly"/>
   </owl:ObjectProperty>
