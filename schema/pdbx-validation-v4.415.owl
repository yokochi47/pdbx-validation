   <owl:DatatypeProperty rdf:ID="struct_mon_prot.PDB_model_num">
      <rdfs:subPropertyOf rdf:resource="#struct_mon_protItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>struct_mon_prot.PDB_model_num</rdfs:label>
