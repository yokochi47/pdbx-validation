   <owl:DatatypeProperty rdf:ID="pdbx_refine_component.B_iso">
      <rdfs:subPropertyOf rdf:resource="#pdbx_refine_componentItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_refine_component.B_iso</rdfs:label>
      <rdfs:comment xml:lang="en">
The average isotropic B factors for the group of atoms
(e.g. residue or ligand, side chain, main chain).
The B factors for each atom is given by attribute B_iso_or_equiv in category atom_site 
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_refine_component.B_iso.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_refine_component.B_iso"/>
   </owl:DatatypeProperty>
