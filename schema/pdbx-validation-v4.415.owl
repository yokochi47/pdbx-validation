      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_refine_ls_restr_ncs.pdbx_asym_id.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:refine_ls_restr_ncs.pdbx_asym_id"/>
