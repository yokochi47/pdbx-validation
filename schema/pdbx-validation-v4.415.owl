Pointer to attribute label_asym_id in category atom_site. 
1
A
2B3
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="pdbx_em_validate_map_model_overallCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_pdbx_em_validate_map_model_overall"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
