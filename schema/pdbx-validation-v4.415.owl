   <owl:DatatypeProperty rdf:ID="em_image_recording.average_exposure_time">
      <rdfs:subPropertyOf rdf:resource="#em_image_recordingItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_image_recording.average_exposure_time</rdfs:label>
      <rdfs:comment xml:lang="en">
The average exposure time for each image.
2.0
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_image_recording.average_exposure_time.html"/>
