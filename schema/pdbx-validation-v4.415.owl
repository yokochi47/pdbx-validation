The value of attribute fom_acentric in category pdbx_phasing_dm_shell identifies the figure of merit
 for acentric data with resolution shells
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_phasing_dm_shell.fom_acentric.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_phasing_dm_shell.fom_acentric"/>
   </owl:DatatypeProperty>
