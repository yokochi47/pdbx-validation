   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="refine_hist.number_reflns_R_free">
      <rdfs:subPropertyOf rdf:resource="#refine_histItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>refine_hist.number_reflns_R_free</rdfs:label>
      <rdfs:comment xml:lang="en">
The number of reflections that satisfy the resolution limits
established by attribute d_res_high in category refine_hist and
