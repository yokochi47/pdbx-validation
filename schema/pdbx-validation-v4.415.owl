      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_3d_fitting_list.pdb_entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">
The PDB code for the entry used in fitting.
1EHZ
                        </rdfs:comment>
