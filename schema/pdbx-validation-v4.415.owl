                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">g/L</rdf:first>
                                                      <rdf:rest>
                                                         <rdf:List>
                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ug/mL</rdf:first>
                                                            <rdf:rest>
                                                               <rdf:List>
                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mg</rdf:first>
                                                                  <rdf:rest>
                                                                     <rdf:List>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mg/L</rdf:first>
                                                                        <rdf:rest>
                                                                           <rdf:List>
                                                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mg/uL</rdf:first>
                                                                              <rdf:rest>
                                                                                 <rdf:List>
                                                                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ug/uL</rdf:first>
                                                                                    <rdf:rest>
                                                                                       <rdf:List>
                                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uM</rdf:first>
                                                                                          <rdf:rest>
                                                                                             <rdf:List>
                                                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">v/v</rdf:first>
                                                                                                <rdf:rest>
                                                                                                   <rdf:List>
                                                                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">w/v</rdf:first>
                                                                                                      <rdf:rest>
                                                                                                         <rdf:List>
                                                                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">w/w</rdf:first>
                                                                                                            <rdf:rest>
                                                                                                               <rdf:List>
                                                                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">% w/v</rdf:first>
                                                                                                                  <rdf:rest>
                                                                                                                     <rdf:List>
                                                                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">% w/w</rdf:first>
                                                                                                                        <rdf:rest>
                                                                                                                           <rdf:List>
                                                                                                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">% v/v</rdf:first>
                                                                                                                              <rdf:rest>
                                                                                                                                 <rdf:List>
                                                                                                                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">saturated</rdf:first>
                                                                                                                                    <rdf:rest>
                                                                                                                                       <rdf:List>
                                                                                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">na</rdf:first>
                                                                                                                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                                                                       </rdf:List>
                                                                                                                                    </rdf:rest>
                                                                                                                                 </rdf:List>
                                                                                                                              </rdf:rest>
                                                                                                                           </rdf:List>
                                                                                                                        </rdf:rest>
                                                                                                                     </rdf:List>
                                                                                                                  </rdf:rest>
                                                                                                               </rdf:List>
                                                                                                            </rdf:rest>
                                                                                                         </rdf:List>
                                                                                                      </rdf:rest>
                                                                                                   </rdf:List>
                                                                                                </rdf:rest>
                                                                                             </rdf:List>
                                                                                          </rdf:rest>
                                                                                       </rdf:List>
                                                                                    </rdf:rest>
