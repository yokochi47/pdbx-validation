               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#phasing_MIR_der.pdbx_R_kraut"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#phasing_MIR_der.pdbx_R_kraut_acentric"/>
