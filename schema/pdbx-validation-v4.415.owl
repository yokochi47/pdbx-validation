   <owl:DatatypeProperty rdf:ID="pdbx_diffrn_ed.recording_mode">
      <rdfs:subPropertyOf rdf:resource="#pdbx_diffrn_edItem"/>
      <rdfs:domain rdf:resource="#pdbx_diffrn_ed"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electron Counting</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Integrating</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Other</rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
The mode of the detector for electron diffraction recording, e.g.
Electron Counting (Event) mode, Linear (Integrating) mode
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_diffrn_ed.recording_mode.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_diffrn_ed.recording_mode"/>
   </owl:DatatypeProperty>
