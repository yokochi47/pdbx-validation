   <owl:Class rdf:ID="pdbx_re_refinement">
      <rdfs:label>pdbx_re_refinement</rdfs:label>
      <rdfs:comment xml:lang="en">
Describes the origin of the experimental data used in this
entry.

    Example 1 -
&lt;VRPTx:pdbx_re_refinementCategory&gt;
   &lt;VRPTx:pdbx_re_refinement entry_id="1ABC"&gt;
      &lt;VRPTx:citation_id&gt;2&lt;/VRPTx:citation_id&gt;
      &lt;VRPTx:details&gt;Re-refinement of data from entry 1ABC&lt;/VRPTx:details&gt;
   &lt;/VRPTx:pdbx_re_refinement&gt;
&lt;/VRPTx:pdbx_re_refinementCategory&gt;


         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://pdbml.pdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/pdbx_re_refinement.html"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_re_refinement.citation_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_re_refinement.citation_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_re_refinement.details"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_re_refinement.details"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_re_refinement.entry_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
      <owl:equivalentClass rdf:resource="PDBo:pdbx_re_refinement"/>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_pdbx_re_refinementCategory">
      <rdfs:label>pdbx_re_refinementCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that datablock
        has a category holder pdbx_re_refinementCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#pdbx_re_refinement"/>
