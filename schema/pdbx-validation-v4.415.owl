   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_geometry.bond_overall_rms">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_geometryItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_dcc_geometry.bond_overall_rms</rdfs:label>
      <rdfs:comment xml:lang="en">
The overall root mean square deviation for bond lengths (all atoms).
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_dcc_geometry.bond_overall_rms.html"/>
