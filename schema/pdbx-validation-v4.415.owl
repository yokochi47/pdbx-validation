   <owl:DatatypeProperty rdf:ID="struct_mon_nucl.label_alt_id">
      <rdfs:subPropertyOf rdf:resource="#struct_mon_nuclItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
