      <rdfs:label>pdbx_nmr_restraint_summary.unmapped_restraints_total</rdfs:label>
      <rdfs:comment xml:lang="en">
The total number of unmapped restraints to the coordinates.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nmr_restraint_summary.entry_id">
