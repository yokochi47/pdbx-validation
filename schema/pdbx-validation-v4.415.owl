reflections.(untwinned: 2.000; perfect twin 1.500).
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_dcc_density.mean_I2_over_mean_I_square.html"/>
