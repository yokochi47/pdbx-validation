               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#phasing_MIR.reflns_centric"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#phasing_MIR.reflns_criterion"/>
