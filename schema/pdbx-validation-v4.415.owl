   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_vitrification.humidity">
      <rdfs:subPropertyOf rdf:resource="#em_vitrificationItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_vitrification.humidity</rdfs:label>
      <rdfs:comment xml:lang="en">
Relative humidity (%) of air surrounding the specimen just prior to
vitrification.
90
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_vitrification.humidity.html"/>
