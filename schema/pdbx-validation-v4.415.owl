      <rdfs:label>refln_sys_abs.sigmaI</rdfs:label>
      <rdfs:comment xml:lang="en">
The standard uncertainty (estimated standard deviation) of
attribute I in category refln_sys_abs in arbitrary units. 
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_refln_sys_abs.sigmaI.html"/>
