        This property indicates that pdbx_nmr_restraint_listCategory.
        has a category pdbx_nmr_restraint_list.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#pdbx_nmr_restraint_list"/>
      <rdfs:domain rdf:resource="#pdbx_nmr_restraint_listCategory"/>
      <rdfs:range rdf:resource="#pdbx_nmr_restraint_list"/>
   </owl:InverseFunctionalProperty>
