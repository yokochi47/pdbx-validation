               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#refine_ls_restr.rejects"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#refine_ls_restr.weight"/>
