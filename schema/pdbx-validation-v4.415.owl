This data item is a pointer to attribute label_alt_id in category atom_site in the
 ATOM_SITE category.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_validate_rmsd_torsion.number_dihedral_angles_in_kb">
