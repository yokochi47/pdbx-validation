   <owl:DatatypeProperty rdf:ID="phasing_MAD_expt.delta_delta_phi">
      <rdfs:subPropertyOf rdf:resource="#phasing_MAD_exptItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>phasing_MAD_expt.delta_delta_phi</rdfs:label>
      <rdfs:comment xml:lang="en">
The difference between two independent determinations of
attribute delta_phi in category phasing_MAD_expt. 
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_phasing_MAD_expt.delta_delta_phi.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:phasing_MAD_expt.delta_delta_phi"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="phasing_MAD_expt.delta_phi">
      <rdfs:subPropertyOf rdf:resource="#phasing_MAD_exptItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>phasing_MAD_expt.delta_phi</rdfs:label>
      <rdfs:comment xml:lang="en">
The phase difference between F~t~(h), the structure factor due
to normal scattering from all atoms, and F~a~(h), the structure
factor due to normal scattering from only the anomalous
scatterers.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_phasing_MAD_expt.delta_phi.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:phasing_MAD_expt.delta_phi"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="phasing_MAD_expt.delta_phi_sigma">
      <rdfs:subPropertyOf rdf:resource="#phasing_MAD_exptItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>phasing_MAD_expt.delta_phi_sigma</rdfs:label>
      <rdfs:comment xml:lang="en">
The standard uncertainty (estimated standard deviation)
of attribute delta_phi in category phasing_MAD_expt. 
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_phasing_MAD_expt.delta_phi_sigma.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:phasing_MAD_expt.delta_phi_sigma"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="phasing_MAD_expt.mean_fom">
