   </owl:Class>
   <owl:Class rdf:ID="pdbx_entity_nonpoly">
      <rdfs:label>pdbx_entity_nonpoly</rdfs:label>
      <rdfs:comment xml:lang="en">
The PDBX_ENTITY_NONPOLY category provides a mapping between
entity and the nonpolymer component

    Example 1 - based on PDB entry 3LTQ
&lt;VRPTx:pdbx_entity_nonpolyCategory&gt;
   &lt;VRPTx:pdbx_entity_nonpoly entity_id="2"&gt;
      &lt;VRPTx:comp_id&gt;TB&lt;/VRPTx:comp_id&gt;
      &lt;VRPTx:name&gt;TERBIUM(III) ION&lt;/VRPTx:name&gt;
   &lt;/VRPTx:pdbx_entity_nonpoly&gt;
   &lt;VRPTx:pdbx_entity_nonpoly entity_id="3"&gt;
      &lt;VRPTx:comp_id&gt;ACT&lt;/VRPTx:comp_id&gt;
      &lt;VRPTx:name&gt;ACETATE ION&lt;/VRPTx:name&gt;
   &lt;/VRPTx:pdbx_entity_nonpoly&gt;
   &lt;VRPTx:pdbx_entity_nonpoly entity_id="4"&gt;
      &lt;VRPTx:comp_id&gt;SO4&lt;/VRPTx:comp_id&gt;
      &lt;VRPTx:name&gt;SULFATE ION&lt;/VRPTx:name&gt;
   &lt;/VRPTx:pdbx_entity_nonpoly&gt;
   &lt;VRPTx:pdbx_entity_nonpoly entity_id="5"&gt;
      &lt;VRPTx:comp_id&gt;HOH&lt;/VRPTx:comp_id&gt;
      &lt;VRPTx:name&gt;water&lt;/VRPTx:name&gt;
   &lt;/VRPTx:pdbx_entity_nonpoly&gt;
&lt;/VRPTx:pdbx_entity_nonpolyCategory&gt;


         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://pdbml.pdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/pdbx_entity_nonpoly.html"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_nonpoly.comp_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_nonpoly.comp_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_nonpoly.name"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_nonpoly.name"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_entity_nonpoly.entity_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
      <owl:equivalentClass rdf:resource="PDBo:pdbx_entity_nonpoly"/>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_pdbx_entity_nonpolyCategory">
      <rdfs:label>pdbx_entity_nonpolyCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that datablock
        has a category holder pdbx_entity_nonpolyCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#pdbx_entity_nonpoly"/>
      <owl:equivalentProperty rdf:resource="PDBo:has_pdbx_entity_nonpolyCategory"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_pdbx_entity_nonpoly">
      <rdfs:label>pdbx_entity_nonpolyCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that pdbx_entity_nonpolyCategory.
        has a category pdbx_entity_nonpoly.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#pdbx_entity_nonpoly"/>
