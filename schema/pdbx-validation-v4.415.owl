      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_entity_assembly.entity_id_list</rdfs:label>
      <rdfs:comment xml:lang="en">
Macromolecules associated with this component, if defined
as comma separated list of entity ids (integers).
1,2,3,4
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_entity_assembly.entity_id_list.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_entity_assembly.entity_id_list"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_entity_assembly.mutant_flag">
