      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#pdbx_em_volume_estimate"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_em_volume_estimate.contour_level_title">
      <rdfs:subPropertyOf rdf:resource="#pdbx_em_volume_estimateItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_em_volume_estimate.contour_level_title</rdfs:label>
      <rdfs:comment xml:lang="en">
A title for the contour level (map value) axis of a volume estimation plot.

See also: https://www.wwpdb.org/validation/EMValidationReportHelp#volume_estimate
Contour level
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_em_volume_estimate.enclosed_volume_title">
      <rdfs:subPropertyOf rdf:resource="#pdbx_em_volume_estimateItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_em_volume_estimate.enclosed_volume_title</rdfs:label>
      <rdfs:comment xml:lang="en">
A title for the enclosed volume (by a contour level) axis of a volume
estimation plot.

See also: https://www.wwpdb.org/validation/EMValidationReportHelp#volume_estimate
Number of voxels
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_em_volume_estimate.enclosed_volume_unit">
