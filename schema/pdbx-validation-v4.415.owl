      <owl:equivalentProperty rdf:resource="PDBo:pdbx_struct_oper_list.vector1"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_struct_oper_list.vector2">
      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_oper_listItem"/>
