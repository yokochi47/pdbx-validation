      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>phasing_set_refln.index_k</rdfs:label>
      <rdfs:comment xml:lang="en">
Miller index k of this reflection in this data set.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_phasing_set_refln.index_k.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:phasing_set_refln.index_k"/>
   </owl:DatatypeProperty>
