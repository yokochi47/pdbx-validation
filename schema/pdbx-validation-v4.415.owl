   <owl:DatatypeProperty rdf:ID="phasing_set.detector_specific">
      <rdfs:subPropertyOf rdf:resource="#phasing_setItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>phasing_set.detector_specific</rdfs:label>
      <rdfs:comment xml:lang="en">
The particular radiation detector. In general, this will be a
manufacturer, description, model number or some combination of
these.
Siemens model x
Kodak XG
MAR Research model y
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_phasing_set.detector_specific.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:phasing_set.detector_specific"/>
   </owl:DatatypeProperty>
