      <rdfs:label>em_image_scans.frames_per_image</rdfs:label>
      <rdfs:comment xml:lang="en">
Total number of time-slice (movie) frames taken per image.
10
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_image_scans.frames_per_image.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_image_scans.frames_per_image"/>
