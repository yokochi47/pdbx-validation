      <owl:equivalentProperty rdf:resource="PDBo:pdbx_dcc_density.Bmean-Bwilson"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_density.Cruickshank_dpi_xyz">
