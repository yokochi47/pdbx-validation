0
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nmr_assigned_chem_shift_list.number_map_warnings">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nmr_assigned_chem_shift_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_nmr_assigned_chem_shift_list.number_map_warnings</rdfs:label>
      <rdfs:comment xml:lang="en">
The number of assigned chemical shifts ambiguously mapped to atoms in the NMR structure.
0
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nmr_assigned_chem_shift_list.number_mapped_chem_shifts">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nmr_assigned_chem_shift_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_nmr_assigned_chem_shift_list.number_mapped_chem_shifts</rdfs:label>
      <rdfs:comment xml:lang="en">
The number of assigned chemical shifts successfully mapped to atoms in the NMR structure.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nmr_assigned_chem_shift_list.number_parsed_chem_shifts">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nmr_assigned_chem_shift_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_nmr_assigned_chem_shift_list.number_parsed_chem_shifts</rdfs:label>
