      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_conn_angleItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_struct_conn_angle.ptnr3_label_seq_id</rdfs:label>
      <rdfs:comment xml:lang="en">
