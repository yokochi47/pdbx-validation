                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_geometry.all_atom_clashscore">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_geometryItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_dcc_geometry.all_atom_clashscore</rdfs:label>
      <rdfs:comment xml:lang="en">
All atom score is determined by steric overlaps &gt;0.4A per 1000
atoms.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_dcc_geometry.all_atom_clashscore.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_dcc_geometry.all_atom_clashscore"/>
   </owl:DatatypeProperty>
