   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="diffrn_radiation_wavelengthItem">
      <rdfs:label>diffrn_radiation_wavelengthItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for diffrn_radiation_wavelength items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#diffrn_radiation_wavelength"/>
      <owl:equivalentProperty rdf:resource="PDBo:diffrn_radiation_wavelengthItem"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_diffrn_radiation_wavelength">
      <rdfs:label>reference_to_diffrn_radiation_wavelength</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to diffrn_radiation_wavelength.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#diffrn_radiation_wavelength"/>
      <owl:equivalentProperty rdf:resource="PDBo:reference_to_diffrn_radiation_wavelength"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_diffrn_radiation_wavelength">
      <rdfs:label>referenced_by_diffrn_radiation_wavelength</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from diffrn_radiation_wavelength.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#diffrn_radiation_wavelength"/>
      <owl:equivalentProperty rdf:resource="PDBo:referenced_by_diffrn_radiation_wavelength"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="diffrn_radiation_wavelength.wavelength">
      <rdfs:subPropertyOf rdf:resource="#diffrn_radiation_wavelengthItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>diffrn_radiation_wavelength.wavelength</rdfs:label>
      <rdfs:comment xml:lang="en">
The radiation wavelength in angstroms.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_diffrn_radiation_wavelength.wavelength.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:diffrn_radiation_wavelength.wavelength"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="diffrn_radiation_wavelength.wt">
      <rdfs:subPropertyOf rdf:resource="#diffrn_radiation_wavelengthItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>diffrn_radiation_wavelength.wt</rdfs:label>
      <rdfs:comment xml:lang="en">
The relative weight of a wavelength identified by the code
attribute id in category diffrn_radiation_wavelength in the list of wavelengths. 
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_diffrn_radiation_wavelength.wt.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:diffrn_radiation_wavelength.wt"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="diffrn_radiation_wavelength.id">
      <rdfs:subPropertyOf rdf:resource="#diffrn_radiation_wavelengthItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>diffrn_radiation_wavelength.id</rdfs:label>
      <rdfs:comment xml:lang="en">
The code identifying each value of
attribute wavelength.
 in category diffrn_radiation_wavelength Items in the DIFFRN_RADIATION_WAVELENGTH category are looped
when multiple wavelengths are used.

This code is used to link with the DIFFRN_REFLN category.
The attribute wavelength_id in category diffrn_refln codes must match one of
 the codes defined in this category.
x1
x2
neut
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_diffrn_radiation_wavelength.id.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:diffrn_radiation_wavelength.id"/>
   </owl:DatatypeProperty>
