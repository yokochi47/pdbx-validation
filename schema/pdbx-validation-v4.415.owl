angle corresponds to the specified orientation matrix
and the original measured cell before any subsequent cell
transformations.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_diffrn_refln.angle_kappa.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:diffrn_refln.angle_kappa"/>
   </owl:DatatypeProperty>
