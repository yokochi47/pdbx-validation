   <owl:DatatypeProperty rdf:ID="pdbx_nmr_assigned_chem_shift_list.chem_shift_13C_err">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nmr_assigned_chem_shift_listItem"/>
