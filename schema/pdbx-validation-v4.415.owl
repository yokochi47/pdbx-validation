      <rdfs:comment xml:lang="en">
Pointer to attribute label_entity_id in category atom_site. 
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_nonpoly_scheme.entity_id.html"/>
