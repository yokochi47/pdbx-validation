   <owl:DatatypeProperty rdf:ID="em_3d_fitting_list.details">
      <rdfs:subPropertyOf rdf:resource="#em_3d_fitting_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_3d_fitting_list.details</rdfs:label>
      <rdfs:comment xml:lang="en">
Details about the model used in fitting.
The initial model consisted of the complete biological assembly for PDB entry 2GTL.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_3d_fitting_list.details.html"/>
