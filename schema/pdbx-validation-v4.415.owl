      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_phasing_dm.reflns_acentric</rdfs:label>
      <rdfs:comment xml:lang="en">
The value of attribute reflns_acentric in category pdbx_phasing_dm identifies the number
 of acentric reflections.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_phasing_dm.reflns_acentric.html"/>
