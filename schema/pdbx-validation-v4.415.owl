      &lt;VRPTx:label_comp_id&gt;ILE&lt;/VRPTx:label_comp_id&gt;
      &lt;VRPTx:label_seq_id&gt;47&lt;/VRPTx:label_seq_id&gt;
      &lt;VRPTx:symmetry&gt;1_555&lt;/VRPTx:symmetry&gt;
   &lt;/VRPTx:struct_site_gen&gt;
