   <owl:Class rdf:ID="em_diffraction">
      <rdfs:label>em_diffraction</rdfs:label>
      <rdfs:comment xml:lang="en">
Microscopy parameters relevant only for crystallography

    Example 1 -
&lt;VRPTx:em_diffractionCategory&gt;
   &lt;VRPTx:em_diffraction id="1"&gt;
      &lt;VRPTx:camera_length&gt;800&lt;/VRPTx:camera_length&gt;
      &lt;VRPTx:imaging_id&gt;1&lt;/VRPTx:imaging_id&gt;
   &lt;/VRPTx:em_diffraction&gt;
   &lt;VRPTx:em_diffraction id="2"&gt;
      &lt;VRPTx:camera_length&gt;750&lt;/VRPTx:camera_length&gt;
      &lt;VRPTx:imaging_id&gt;2&lt;/VRPTx:imaging_id&gt;
   &lt;/VRPTx:em_diffraction&gt;
&lt;/VRPTx:em_diffractionCategory&gt;


         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://pdbml.pdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/em_diffraction.html"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_diffraction.camera_length"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_diffraction.camera_length"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_diffraction.imaging_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_diffraction.imaging_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_diffraction.tilt_angle_list"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_diffraction.tilt_angle_list"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_diffraction.id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
      <owl:equivalentClass rdf:resource="PDBo:em_diffraction"/>
   </owl:Class>
