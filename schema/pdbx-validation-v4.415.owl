   <owl:Class rdf:ID="pdbx_validate_torsion">
      <rdfs:label>pdbx_validate_torsion</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_VALIDATE_TORSION category list the
residues with torsion angles outside the expected Ramachandran regions

    Example 1 -
&lt;VRPTx:pdbx_validate_torsionCategory&gt;
   &lt;VRPTx:pdbx_validate_torsion id="1"&gt;
      &lt;VRPTx:PDB_ins_code xsi:nil="true" /&gt;
      &lt;VRPTx:PDB_model_num&gt;1&lt;/VRPTx:PDB_model_num&gt;
      &lt;VRPTx:auth_asym_id&gt;A&lt;/VRPTx:auth_asym_id&gt;
      &lt;VRPTx:auth_comp_id&gt;SER&lt;/VRPTx:auth_comp_id&gt;
      &lt;VRPTx:auth_seq_id&gt;12&lt;/VRPTx:auth_seq_id&gt;
      &lt;VRPTx:phi&gt;-64.75&lt;/VRPTx:phi&gt;
      &lt;VRPTx:psi&gt;2.02&lt;/VRPTx:psi&gt;
   &lt;/VRPTx:pdbx_validate_torsion&gt;
   &lt;VRPTx:pdbx_validate_torsion id="2"&gt;
      &lt;VRPTx:PDB_ins_code xsi:nil="true" /&gt;
      &lt;VRPTx:PDB_model_num&gt;1&lt;/VRPTx:PDB_model_num&gt;
      &lt;VRPTx:auth_asym_id&gt;A&lt;/VRPTx:auth_asym_id&gt;
      &lt;VRPTx:auth_comp_id&gt;THR&lt;/VRPTx:auth_comp_id&gt;
      &lt;VRPTx:auth_seq_id&gt;22&lt;/VRPTx:auth_seq_id&gt;
      &lt;VRPTx:phi&gt;-116.30&lt;/VRPTx:phi&gt;
      &lt;VRPTx:psi&gt;61.44&lt;/VRPTx:psi&gt;
   &lt;/VRPTx:pdbx_validate_torsion&gt;
&lt;/VRPTx:pdbx_validate_torsionCategory&gt;


         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://pdbml.pdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/pdbx_validate_torsion.html"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.PDB_ins_code"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.PDB_ins_code"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.PDB_model_num"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.PDB_model_num"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.auth_asym_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.auth_asym_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.auth_comp_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.auth_comp_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.auth_seq_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.auth_seq_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.label_alt_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.label_alt_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.phi"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.phi"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.psi"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.psi"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_torsion.id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
      <owl:equivalentClass rdf:resource="PDBo:pdbx_validate_torsion"/>
   </owl:Class>
