   <owl:DatatypeProperty rdf:ID="em_vitrification.chamber_temperature">
      <rdfs:subPropertyOf rdf:resource="#em_vitrificationItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_vitrification.chamber_temperature</rdfs:label>
      <rdfs:comment xml:lang="en">
The temperature (in kelvin) of the sample just prior to vitrification.
298
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_vitrification.chamber_temperature.html"/>
