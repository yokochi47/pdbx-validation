      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_phasing_dm.fom_acentric</rdfs:label>
      <rdfs:comment xml:lang="en">
The value of attribute fom_acentric in category pdbx_phasing_dm identifies the figure of merit
 for acentric data
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_phasing_dm.fom_acentric.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_phasing_dm.fom_acentric"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_phasing_dm.fom_centric">
      <rdfs:subPropertyOf rdf:resource="#pdbx_phasing_dmItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_phasing_dm.fom_centric</rdfs:label>
      <rdfs:comment xml:lang="en">
The value of attribute fom_centric in category pdbx_phasing_dm identifies the figure of merit
 for acentric data
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_phasing_dm.fom_centric.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_phasing_dm.fom_centric"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_phasing_dm.mask_type">
