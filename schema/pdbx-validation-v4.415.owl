      <rdfs:label>reference_to_pdbx_em_raps</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to pdbx_em_raps.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#pdbx_em_raps"/>
   </owl:ObjectProperty>
