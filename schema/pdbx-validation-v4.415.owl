      <rdfs:subPropertyOf rdf:resource="#pdbx_phasing_MRItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_phasing_MR.sigma_F_translation</rdfs:label>
      <rdfs:comment xml:lang="en">
The value of attribute sigma_F_translation in category pdbx_phasing_MR identifies the
 sigma cut off of structure factor used for translation search.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_phasing_MR.sigma_F_translation.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_phasing_MR.sigma_F_translation"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_phasing_MR.sigma_I_rotation">
      <rdfs:subPropertyOf rdf:resource="#pdbx_phasing_MRItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_phasing_MR.sigma_I_rotation</rdfs:label>
      <rdfs:comment xml:lang="en">
The value of attribute sigma_I_rotation in category pdbx_phasing_MR identifies the
 sigma cut off of intensity used for rotation search.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_phasing_MR.sigma_I_rotation.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_phasing_MR.sigma_I_rotation"/>
