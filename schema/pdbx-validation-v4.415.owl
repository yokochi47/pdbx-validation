      <rdfs:label>pdbx_nmr_unparsed_chem_shift.list_id</rdfs:label>
      <rdfs:comment xml:lang="en">
Pointer to attribute id in category pdbx_nmr_assigned_chem_shift_list. 
                     </rdfs:comment>
   </owl:DatatypeProperty>
