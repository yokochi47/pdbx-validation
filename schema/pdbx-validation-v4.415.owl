        This property indicates that pdbx_struct_group_listCategory.
        has a category pdbx_struct_group_list.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#pdbx_struct_group_list"/>
