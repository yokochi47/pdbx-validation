   <owl:DatatypeProperty rdf:ID="em_imaging_optics.details">
      <rdfs:subPropertyOf rdf:resource="#em_imaging_opticsItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_imaging_optics.details</rdfs:label>
      <rdfs:comment xml:lang="en">
Details on the use of the phase plate
 Phase plate evolution varied between different microscopes used to collect data but positions were shifted once phase evolution progressed past 120 degrees.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_imaging_optics.details.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_imaging_optics.details"/>
   </owl:DatatypeProperty>
