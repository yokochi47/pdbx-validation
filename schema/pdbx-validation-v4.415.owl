      <owl:equivalentProperty rdf:resource="PDBo:em_3d_fitting_list.source_name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_3d_fitting_list.type">
      <rdfs:subPropertyOf rdf:resource="#em_3d_fitting_listItem"/>
      <rdfs:domain rdf:resource="#em_3d_fitting_list"/>
      <rdfs:range>
         <owl:DataRange>
