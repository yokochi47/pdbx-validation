      <rdfs:label>pdbx_dcc_density.real_space_R_overall</rdfs:label>
      <rdfs:comment xml:lang="en">
The overall real space R factor.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_dcc_density.real_space_R_overall.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_dcc_density.real_space_R_overall"/>
