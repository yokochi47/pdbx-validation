      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_dcc_density.reflection_status_archived.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_dcc_density.reflection_status_archived"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_density.reflection_status_used">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_densityItem"/>
