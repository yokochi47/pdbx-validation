                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_image_recording.num_diffraction_images.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_image_recording.num_diffraction_images"/>
   </owl:DatatypeProperty>
