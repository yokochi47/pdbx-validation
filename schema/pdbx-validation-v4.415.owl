        has a category pdbx_phasing_dm.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#pdbx_phasing_dm"/>
      <rdfs:domain rdf:resource="#pdbx_phasing_dmCategory"/>
      <rdfs:range rdf:resource="#pdbx_phasing_dm"/>
      <owl:equivalentProperty rdf:resource="PDBo:has_pdbx_phasing_dm"/>
   </owl:InverseFunctionalProperty>
