   <owl:ObjectProperty rdf:ID="referenced_by_refine_hist">
      <rdfs:label>referenced_by_refine_hist</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from refine_hist.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#refine_hist"/>
      <owl:equivalentProperty rdf:resource="PDBo:referenced_by_refine_hist"/>
