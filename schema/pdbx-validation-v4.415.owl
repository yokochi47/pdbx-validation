   <owl:Class rdf:ID="pdbx_validate_peptide_omegaCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_pdbx_validate_peptide_omega"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
