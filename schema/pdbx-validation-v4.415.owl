                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_crystal_formation.specimen_id.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_crystal_formation.specimen_id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_crystal_formation.temperature">
      <rdfs:subPropertyOf rdf:resource="#em_crystal_formationItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_crystal_formation.temperature</rdfs:label>
      <rdfs:comment xml:lang="en">
The value of the temperature in kelvin used for
growing the crystals.
298
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_crystal_formation.temperature.html"/>
