      <rdfs:subPropertyOf rdf:resource="#pdbx_entity_assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_entity_assembly.num_copies</rdfs:label>
      <rdfs:comment xml:lang="en">
The number of copies of this entity in the assembly.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_entity_assembly.num_copies.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_entity_assembly.num_copies"/>
