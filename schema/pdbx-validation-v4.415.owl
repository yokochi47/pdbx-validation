      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_dcc_density.R_value_R_work</rdfs:label>
      <rdfs:comment xml:lang="en">
The Rwork reported in the model file.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_dcc_density.R_value_R_work.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_dcc_density.R_value_R_work"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_density.Rfree-Rwork">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_densityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_dcc_density.Rfree-Rwork</rdfs:label>
      <rdfs:comment xml:lang="en">
The difference between reported Rfree and reported Rwork.
