      <rdfs:comment xml:lang="en">
A component of the identifier for participants in the site.

This data item is a pointer to attribute id in category atom_sites_alt in the
 ATOM_SITES_ALT category.
                        </rdfs:comment>
      <owl:equivalentProperty rdf:resource="PDBo:struct_mon_nucl.label_alt_id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="struct_mon_nucl.label_asym_id">
