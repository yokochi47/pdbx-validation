   <owl:DatatypeProperty rdf:ID="struct_asym.details">
      <rdfs:subPropertyOf rdf:resource="#struct_asymItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>struct_asym.details</rdfs:label>
      <rdfs:comment xml:lang="en">
A description of special aspects of this portion of the contents
of the asymmetric unit.
                                 The drug binds to this enzyme in two roughly
                                  twofold symmetric modes. Hence this
                                  biological unit (3) is roughly twofold
                                  symmetric to biological unit (2). Disorder in
                                  the protein chain indicated with alternative
                                  ID 2 should be used with this biological unit.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_struct_asym.details.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:struct_asym.details"/>
      <owl:equivalentProperty rdf:resource="BMRBo:entity_assembly.details"/>
   </owl:DatatypeProperty>
