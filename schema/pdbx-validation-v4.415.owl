                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_diffrn_reflns.av_sigmaI_over_netI.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:diffrn_reflns.av_sigmaI_over_netI"/>
   </owl:DatatypeProperty>
