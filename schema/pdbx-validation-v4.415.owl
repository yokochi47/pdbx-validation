                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_image_scans.details.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_image_scans.details"/>
   </owl:DatatypeProperty>
