   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_3d_fitting_list.initial_refinement_model_id">
      <rdfs:subPropertyOf rdf:resource="#em_3d_fitting_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>em_3d_fitting_list.initial_refinement_model_id</rdfs:label>
      <rdfs:comment xml:lang="en">
The value of attribute initial_refinement_model_id in category em_3d_fitting itentifies the id
 in the _pdbx_initial_refinement_model
                        </rdfs:comment>
