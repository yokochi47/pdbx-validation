   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nmr_refine.details">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nmr_refineItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_nmr_refine.details</rdfs:label>
      <rdfs:comment xml:lang="en">
Additional details about the NMR refinement.

Additional comments about the NMR refinement can be placed here, e.g.
the structures are based on a total of 3344 restraints, 3167 are NOE-derived
distance constraints, 68 dihedral angle restraints,109 distance restraints
from hydrogen bonds.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_nmr_refine.details.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_refine.details"/>
      <owl:equivalentProperty rdf:resource="BMRBo:conformer_family_refinement.refine_details"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nmr_refine.method">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nmr_refineItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_nmr_refine.method</rdfs:label>
      <rdfs:comment xml:lang="en">
The method used to determine the structure.

  distance geometry
  simulated annealing
  molecular dynamics
  matrix relaxation
  torsion angle dynamics
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_nmr_refine.method.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_refine.method"/>
      <owl:equivalentProperty rdf:resource="BMRBo:conformer_family_refinement.refine_method"/>
   </owl:DatatypeProperty>
