      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_imaging.temperature</rdfs:label>
      <rdfs:comment xml:lang="en">
The mean specimen stage temperature (kelvin) during imaging
in the microscope.
70
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_imaging.temperature.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_imaging.temperature"/>
