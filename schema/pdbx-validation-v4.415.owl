cryo
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_imaging.specimen_holder_type.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_imaging.specimen_holder_type"/>
