An  identifier for the assembly.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_entity_assembly.biol_id.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_entity_assembly.biol_id"/>
   </owl:DatatypeProperty>
