      <rdfs:label>struct_asym.entity_id</rdfs:label>
      <rdfs:comment xml:lang="en">
This data item is a pointer to attribute id in category entity in the ENTITY category. 
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_struct_asym.entity_id.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:struct_asym.entity_id"/>
      <owl:equivalentProperty rdf:resource="BMRBo:entity_assembly.entity_id"/>
   </owl:DatatypeProperty>
