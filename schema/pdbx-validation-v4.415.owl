The ordinal number of the bin, ordered from lowest signal
to highest.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_refln_signal_binning.ordinal.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_refln_signal_binning.ordinal"/>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="pdbx_reflns_twinCategory">
