                                                                              <rdf:rest>
                                                                                 <rdf:List>
                                                                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">delta</rdf:first>
                                                                                    <rdf:rest>
                                                                                       <rdf:List>
