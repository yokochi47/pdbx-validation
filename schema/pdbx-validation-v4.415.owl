      <rdfs:subPropertyOf rdf:resource="#pdbx_validate_symm_contactItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_validate_symm_contact.id</rdfs:label>
      <rdfs:comment xml:lang="en">
The value of attribute id in category pdbx_validate_symm_contact must uniquely identify
 each item in the PDBX_VALIDATE_SYMM_CONTACT list.
This is an integer serial number.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_validate_symm_contact.id.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_validate_symm_contact.id"/>
   </owl:DatatypeProperty>
