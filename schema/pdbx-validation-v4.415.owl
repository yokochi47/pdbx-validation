A name for the non-polymer entity
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_entity_nonpoly.name.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_entity_nonpoly.name"/>
      <owl:equivalentProperty rdf:resource="BMRBo:entity.name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_entity_nonpoly.entity_id">
