   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_struct_conn_angle.ptnr3_label_comp_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_struct_conn_angleItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_struct_conn_angle.ptnr3_label_comp_id</rdfs:label>
      <rdfs:comment xml:lang="en">
A component of the identifier for partner 3 of the structure angle.

This data item is a pointer to attribute label_comp_id in category atom_site in
 the ATOM_SITE category.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_struct_conn_angle.ptnr3_label_comp_id.html"/>
