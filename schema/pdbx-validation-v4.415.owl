      <rdfs:label>reference_to_pdbx_dcc_density</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to pdbx_dcc_density.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#pdbx_dcc_density"/>
