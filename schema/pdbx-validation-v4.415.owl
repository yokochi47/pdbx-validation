   <owl:DatatypeProperty rdf:ID="em_3d_fitting_list.accession_code">
      <rdfs:subPropertyOf rdf:resource="#em_3d_fitting_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_3d_fitting_list.accession_code</rdfs:label>
