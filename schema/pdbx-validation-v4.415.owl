      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_densityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_dcc_density.ls_d_res_high_sf</rdfs:label>
      <rdfs:comment xml:lang="en">
The highest resolution limit calculated from the structure
factor file.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_dcc_density.ls_d_res_high_sf.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_dcc_density.ls_d_res_high_sf"/>
   </owl:DatatypeProperty>
