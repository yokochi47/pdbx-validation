      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_geometryItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_dcc_geometry.number_bonds</rdfs:label>
      <rdfs:comment xml:lang="en">
The number of bond lengths in the entry used in calculation of
'_pdbx_dcc_geometry.bond_overall_rmsz'.
                        </rdfs:comment>
   </owl:DatatypeProperty>
