   <owl:DatatypeProperty rdf:ID="pdbx_dcc_density.prob_peak_value">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_densityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_dcc_density.prob_peak_value</rdfs:label>
      <rdfs:comment xml:lang="en">
The probability to tell the existence of translational pseudo
symmetry. p_values smaller than 0.05 (1e-3) might indicate weak
(strong) translational pseudo symmetry (by Xtriage).
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_dcc_density.prob_peak_value.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_dcc_density.prob_peak_value"/>
   </owl:DatatypeProperty>
