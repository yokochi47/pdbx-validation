   &lt;/VRPTx:reflns_shell&gt;
   &lt;VRPTx:reflns_shell pdbx_ordinal="5"&gt;
      &lt;VRPTx:Rmerge_F_obs&gt;9.86&lt;/VRPTx:Rmerge_F_obs&gt;
      &lt;VRPTx:d_res_high&gt;2.41&lt;/VRPTx:d_res_high&gt;
