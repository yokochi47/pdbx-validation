                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_dcc_geometry.planarity_overall_rms.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_dcc_geometry.planarity_overall_rms"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_geometry.rotamer_outliers_number">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_geometryItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_dcc_geometry.rotamer_outliers_number</rdfs:label>
      <rdfs:comment xml:lang="en">
Number of rotamer outliers.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_dcc_geometry.rotamer_outliers_number.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_dcc_geometry.rotamer_outliers_number"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_geometry.rotamer_outliers_percent">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_geometryItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_dcc_geometry.rotamer_outliers_percent</rdfs:label>
      <rdfs:comment xml:lang="en">
Percentage of rotamer outliers.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_dcc_geometry.rotamer_outliers_percent.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_dcc_geometry.rotamer_outliers_percent"/>
