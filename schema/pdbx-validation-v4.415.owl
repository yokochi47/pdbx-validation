      <owl:equivalentProperty rdf:resource="PDBo:pdbx_phasing_dm_shell.reflns_acentric"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_phasing_dm_shell.reflns_centric">
      <rdfs:subPropertyOf rdf:resource="#pdbx_phasing_dm_shellItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_phasing_dm_shell.reflns_centric</rdfs:label>
      <rdfs:comment xml:lang="en">
The value of attribute reflns_centric in category pdbx_phasing_dm_shell identifies the number
 of centric reflections with resolution shells.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_phasing_dm_shell.reflns_centric.html"/>
