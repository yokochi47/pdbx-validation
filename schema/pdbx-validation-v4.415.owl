        This property indicates that pdbx_nmr_restraint_violationCategory.
        has a category pdbx_nmr_restraint_violation.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#pdbx_nmr_restraint_violation"/>
      <rdfs:domain rdf:resource="#pdbx_nmr_restraint_violationCategory"/>
      <rdfs:range rdf:resource="#pdbx_nmr_restraint_violation"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nmr_restraint_violationItem">
      <rdfs:label>pdbx_nmr_restraint_violationItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for pdbx_nmr_restraint_violation items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#pdbx_nmr_restraint_violation"/>
   </owl:DatatypeProperty>
