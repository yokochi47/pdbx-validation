      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_entity_nonpoly.entity_id</rdfs:label>
      <rdfs:comment xml:lang="en">
This data item is a pointer to attribute id in category entity in the ENTITY category. 
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_entity_nonpoly.entity_id.html"/>
