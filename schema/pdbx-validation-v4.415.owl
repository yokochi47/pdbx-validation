      <rdfs:label>pdbx_em_validate_map_model_entity.PDB_model_num</rdfs:label>
      <rdfs:comment xml:lang="en">
Pointer to attribute pdbx_PDB_model_num in category atom_site. 
                     </rdfs:comment>
   </owl:DatatypeProperty>
