      &lt;VRPTx:loc&gt;23&lt;/VRPTx:loc&gt;
   &lt;/VRPTx:phasing_MIR_der_shell&gt;
   &lt;VRPTx:phasing_MIR_der_shell d_res_high="3.4" d_res_low="3.8" der_id="KAu(CN)2"&gt;
