   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nonpoly_scheme.pdb_mon_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nonpoly_schemeItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
