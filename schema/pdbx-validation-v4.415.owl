   <owl:DatatypeProperty rdf:ID="pdbx_dcc_density.mFo-DFc-6sigma_positive">
      <rdfs:subPropertyOf rdf:resource="#pdbx_dcc_densityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_dcc_density.mFo-DFc-6sigma_positive</rdfs:label>
