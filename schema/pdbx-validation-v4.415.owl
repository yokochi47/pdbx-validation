   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_entity_assembly.name">
      <rdfs:subPropertyOf rdf:resource="#em_entity_assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_entity_assembly.name</rdfs:label>
      <rdfs:comment xml:lang="en">
The name of the sample or sample subcomponent.
Ternary complex of alpha-tubulin with tubulin folding cofactors TBCE and TBCB
80S Ribosome bound to emetine
messenger RNA
initiation factor 2
GroEL
antibody Fab fragment
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_entity_assembly.name.html"/>
