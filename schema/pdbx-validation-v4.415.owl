   <owl:DatatypeProperty rdf:ID="pdbx_entity_poly_comp_link_list.value_order">
      <rdfs:subPropertyOf rdf:resource="#pdbx_entity_poly_comp_link_listItem"/>
      <rdfs:domain rdf:resource="#pdbx_entity_poly_comp_link_list"/>
