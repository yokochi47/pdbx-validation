      <rdfs:label>refln.A_calc</rdfs:label>
      <rdfs:comment xml:lang="en">
The calculated value of structure-factor component A in
electrons.

A = |F|cos(phase)
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_refln.A_calc.html"/>
