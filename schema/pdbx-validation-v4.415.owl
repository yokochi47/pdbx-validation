      <rdfs:label>phasing_set.cell_length_b</rdfs:label>
      <rdfs:comment xml:lang="en">
Unit-cell length b for this data set in angstroms.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_phasing_set.cell_length_b.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:phasing_set.cell_length_b"/>
