      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pdbx_helical_symmetry.number_of_operations</rdfs:label>
      <rdfs:comment xml:lang="en">
Number of operations.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_helical_symmetry.number_of_operations.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_helical_symmetry.number_of_operations"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_helical_symmetry.rise_per_n_subunits">
