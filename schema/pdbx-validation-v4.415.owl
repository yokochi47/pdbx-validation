   <owl:Class rdf:ID="pdbx_nmr_ensemble_rmsCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_pdbx_nmr_ensemble_rms"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
      <owl:equivalentClass rdf:resource="PDBo:pdbx_nmr_ensemble_rmsCategory"/>
   </owl:Class>
   <owl:Class rdf:ID="pdbx_nmr_ensemble_rms">
      <rdfs:label>pdbx_nmr_ensemble_rms</rdfs:label>
      <rdfs:comment xml:lang="en">
Structural statistics are derived from molecular dynamics and simulated annealing
programs.
  This example is derived from the MCP-1 structure calculation statistics.
   For this  structure the statistics were calculated over residues 5-69 for
   both the monomer and dimer .
&lt;VRPTx:pdbx_nmr_ensemble_rmsCategory&gt;
   &lt;VRPTx:pdbx_nmr_ensemble_rms entry_id="1ABC"&gt;
      &lt;VRPTx:atom_type&gt;all heavy atoms&lt;/VRPTx:atom_type&gt;
      &lt;VRPTx:chain_range_begin&gt;A&lt;/VRPTx:chain_range_begin&gt;
      &lt;VRPTx:chain_range_end&gt;A&lt;/VRPTx:chain_range_end&gt;
      &lt;VRPTx:distance_rms_dev&gt;0.22&lt;/VRPTx:distance_rms_dev&gt;
      &lt;VRPTx:distance_rms_dev_error&gt;0.06&lt;/VRPTx:distance_rms_dev_error&gt;
      &lt;VRPTx:residue_range_begin&gt;5&lt;/VRPTx:residue_range_begin&gt;
      &lt;VRPTx:residue_range_end&gt;69&lt;/VRPTx:residue_range_end&gt;
   &lt;/VRPTx:pdbx_nmr_ensemble_rms&gt;
&lt;/VRPTx:pdbx_nmr_ensemble_rmsCategory&gt;


         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://pdbml.pdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/pdbx_nmr_ensemble_rms.html"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_ensemble_rms.atom_type"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_ensemble_rms.atom_type"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_ensemble_rms.bond_angle_rms_dev"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_ensemble_rms.bond_angle_rms_dev"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_ensemble_rms.bond_angle_rms_dev_error"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_ensemble_rms.bond_angle_rms_dev_error"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_ensemble_rms.chain_range_begin"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_ensemble_rms.chain_range_begin"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_ensemble_rms.chain_range_end"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_ensemble_rms.chain_range_end"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
