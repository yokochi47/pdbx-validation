   </owl:Class>
   <owl:Class rdf:ID="em_3d_reconstruction">
      <rdfs:label>em_3d_reconstruction</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the EM_3D_RECONSTRUCTION category
record details of the 3D reconstruction procedure from 2D projections.
 Example 1 - based on PDB entry 1DYL and laboratory records for the
                structure corresponding to PDB entry 1DYL
&lt;VRPTx:em_3d_reconstructionCategory&gt;
   &lt;VRPTx:em_3d_reconstruction id="1"&gt;
      &lt;VRPTx:actual_pixel_size&gt;2.52&lt;/VRPTx:actual_pixel_size&gt;
      &lt;VRPTx:details xsi:nil="true" /&gt;
      &lt;VRPTx:entry_id&gt;1DYL&lt;/VRPTx:entry_id&gt;
      &lt;VRPTx:method&gt;CROSS-COMMON LINES&lt;/VRPTx:method&gt;
      &lt;VRPTx:nominal_pixel_size&gt;2.64&lt;/VRPTx:nominal_pixel_size&gt;
      &lt;VRPTx:resolution&gt;9&lt;/VRPTx:resolution&gt;
      &lt;VRPTx:resolution_method xsi:nil="true" /&gt;
   &lt;/VRPTx:em_3d_reconstruction&gt;
&lt;/VRPTx:em_3d_reconstructionCategory&gt;


         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://pdbml.pdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/em_3d_reconstruction.html"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_3d_reconstruction.actual_pixel_size"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_3d_reconstruction.actual_pixel_size"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_3d_reconstruction.algorithm"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_3d_reconstruction.algorithm"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_3d_reconstruction.citation_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_3d_reconstruction.citation_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_3d_reconstruction.details"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_3d_reconstruction.details"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_3d_reconstruction.entry_id"/>
