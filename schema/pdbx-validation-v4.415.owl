      &lt;VRPTx:entity_comp_num_2&gt;2&lt;/VRPTx:entity_comp_num_2&gt;
      &lt;VRPTx:entity_id&gt;1&lt;/VRPTx:entity_id&gt;
      &lt;VRPTx:leaving_atom_id_1 xsi:nil="true" /&gt;
