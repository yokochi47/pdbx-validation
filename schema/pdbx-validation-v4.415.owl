   <owl:Class rdf:ID="pdbx_validate_rmsd_ring">
      <rdfs:label>pdbx_validate_rmsd_ring</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_VALIDATE_RMSD_RING category list the
residues that contain unexpected deviations of dihedral
angles in a ring conformation.

The values are computed by Mogul. Mogul finds the similar ring
conformations from small-molecule structures in the Cambridge
Structural Database (CSD).

    Example 1 -
&lt;VRPTx:pdbx_validate_rmsd_ringCategory&gt;
   &lt;VRPTx:pdbx_validate_rmsd_ring id="1"&gt;
      &lt;VRPTx:PDB_ins_code xsi:nil="true" /&gt;
      &lt;VRPTx:PDB_model_num&gt;1&lt;/VRPTx:PDB_model_num&gt;
      &lt;VRPTx:auth_asym_id&gt;A&lt;/VRPTx:auth_asym_id&gt;
      &lt;VRPTx:auth_comp_id&gt;BBA&lt;/VRPTx:auth_comp_id&gt;
      &lt;VRPTx:auth_seq_id&gt;250&lt;/VRPTx:auth_seq_id&gt;
      &lt;VRPTx:dihedral_angle_standard_deviation&gt;5.62&lt;/VRPTx:dihedral_angle_standard_deviation&gt;
      &lt;VRPTx:dihedral_angle_target_value&gt;73.11&lt;/VRPTx:dihedral_angle_target_value&gt;
   &lt;/VRPTx:pdbx_validate_rmsd_ring&gt;
   &lt;VRPTx:pdbx_validate_rmsd_ring id="2"&gt;
      &lt;VRPTx:PDB_ins_code xsi:nil="true" /&gt;
      &lt;VRPTx:PDB_model_num&gt;1&lt;/VRPTx:PDB_model_num&gt;
      &lt;VRPTx:auth_asym_id&gt;B&lt;/VRPTx:auth_asym_id&gt;
      &lt;VRPTx:auth_comp_id&gt;BBA&lt;/VRPTx:auth_comp_id&gt;
      &lt;VRPTx:auth_seq_id&gt;250&lt;/VRPTx:auth_seq_id&gt;
      &lt;VRPTx:dihedral_angle_standard_deviation&gt;6.08&lt;/VRPTx:dihedral_angle_standard_deviation&gt;
      &lt;VRPTx:dihedral_angle_target_value&gt;74.52&lt;/VRPTx:dihedral_angle_target_value&gt;
   &lt;/VRPTx:pdbx_validate_rmsd_ring&gt;
&lt;/VRPTx:pdbx_validate_rmsd_ringCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.PDB_ins_code"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.PDB_ins_code"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.PDB_model_num"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.PDB_model_num"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.auth_asym_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.auth_asym_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.auth_comp_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.auth_comp_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.auth_seq_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.auth_seq_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.dihedral_angle_minimum_diff_to_kb"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.dihedral_angle_minimum_diff_to_kb"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.dihedral_angle_standard_deviation"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.dihedral_angle_standard_deviation"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.dihedral_angle_target_value"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.dihedral_angle_target_value"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.label_alt_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.label_alt_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.number_dihedral_angles_in_kb"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.number_dihedral_angles_in_kb"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_validate_rmsd_ring.id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
