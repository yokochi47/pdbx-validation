      <rdfs:subPropertyOf rdf:resource="#em_embeddingItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_embedding.id</rdfs:label>
      <rdfs:comment xml:lang="en">
PRIMARY KEY
