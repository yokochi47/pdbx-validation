   <owl:ObjectProperty rdf:ID="reference_to_struct_ncs_dom">
      <rdfs:label>reference_to_struct_ncs_dom</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to struct_ncs_dom.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#struct_ncs_dom"/>
      <owl:equivalentProperty rdf:resource="PDBo:reference_to_struct_ncs_dom"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_struct_ncs_dom">
      <rdfs:label>referenced_by_struct_ncs_dom</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from struct_ncs_dom.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#struct_ncs_dom"/>
      <owl:equivalentProperty rdf:resource="PDBo:referenced_by_struct_ncs_dom"/>
