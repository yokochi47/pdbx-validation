      <rdfs:label>em_3d_fitting_list.pdb_chain_residue_range</rdfs:label>
      <rdfs:comment xml:lang="en">
Residue range for the identified chain.
5-545
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_3d_fitting_list.pdb_chain_residue_range.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_3d_fitting_list.pdb_chain_residue_range"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_3d_fitting_list.pdb_entry_id">
