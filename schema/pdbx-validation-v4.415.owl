         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_restraint_summary.dihedral_angle_restraints_total"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_restraint_summary.dihedral_angle_restraints_total"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_restraint_summary.distance_restraints_total"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_restraint_summary.distance_restraints_total"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_restraint_summary.disulfide_bond_restraints_total"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_restraint_summary.disulfide_bond_restraints_total"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_restraint_summary.hydrogen_bond_restraints_total"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_restraint_summary.hydrogen_bond_restraints_total"/>
