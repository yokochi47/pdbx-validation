      &lt;VRPTx:d_res_low&gt;20.00&lt;/VRPTx:d_res_low&gt;
      &lt;VRPTx:f_double_prime&gt;29.17&lt;/VRPTx:f_double_prime&gt;
      &lt;VRPTx:f_prime&gt;-13.97&lt;/VRPTx:f_prime&gt;
      &lt;VRPTx:wavelength_details&gt;edge&lt;/VRPTx:wavelength_details&gt;
