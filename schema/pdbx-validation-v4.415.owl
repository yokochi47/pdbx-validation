      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>em_entity_assembly.number_of_copies</rdfs:label>
      <rdfs:comment xml:lang="en">
number of copies
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_entity_assembly.number_of_copies.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_entity_assembly.number_of_copies"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_entity_assembly.oligomeric_details">
      <rdfs:subPropertyOf rdf:resource="#em_entity_assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_entity_assembly.oligomeric_details</rdfs:label>
      <rdfs:comment xml:lang="en">
Oligomeric details
                        </rdfs:comment>
