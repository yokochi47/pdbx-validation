      <rdfs:label>em_image_scans.dimension_height</rdfs:label>
      <rdfs:comment xml:lang="en">
Height of scanned image, in pixels
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_image_scans.dimension_height.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_image_scans.dimension_height"/>
   </owl:DatatypeProperty>
