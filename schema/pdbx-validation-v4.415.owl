   <owl:DatatypeProperty rdf:ID="em_image_scans.number_digital_images">
      <rdfs:subPropertyOf rdf:resource="#em_image_scansItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>em_image_scans.number_digital_images</rdfs:label>
      <rdfs:comment xml:lang="en">
The number of real images.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_image_scans.number_digital_images.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_image_scans.number_digital_images"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_image_scans.od_range">
      <rdfs:subPropertyOf rdf:resource="#em_image_scansItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_image_scans.od_range</rdfs:label>
      <rdfs:comment xml:lang="en">
The optical density range (OD=-log 10 transmission).
To the eye OD=1 appears light gray and OD=3 is opaque.
1.4
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_image_scans.od_range.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_image_scans.od_range"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_image_scans.quant_bit_size">
      <rdfs:subPropertyOf rdf:resource="#em_image_scansItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>em_image_scans.quant_bit_size</rdfs:label>
      <rdfs:comment xml:lang="en">
The number of bits per pixel.
8
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_image_scans.quant_bit_size.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_image_scans.quant_bit_size"/>
