      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_image_scans.dimension_width</rdfs:label>
      <rdfs:comment xml:lang="en">
Width of scanned image, in pixels
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_image_scans.dimension_width.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_image_scans.dimension_width"/>
   </owl:DatatypeProperty>
