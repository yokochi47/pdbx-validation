      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_entity_assembly.entity_id</rdfs:label>
      <rdfs:comment xml:lang="en">
An enity identifier. A reference to attribute id in category entity. 
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_entity_assembly.entity_id.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_entity_assembly.entity_id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_entity_assembly.id">
