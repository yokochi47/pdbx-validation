      <rdfs:subPropertyOf rdf:resource="#em_diffractionItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_diffraction.tilt_angle_list</rdfs:label>
      <rdfs:comment xml:lang="en">
Comma-separated list of tilt angles (in degrees) used in the electron diffraction experiment.
20,40,50,55
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_diffraction.tilt_angle_list.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_diffraction.tilt_angle_list"/>
   </owl:DatatypeProperty>
