      <rdfs:label>pdbx_refln_signal_binning.upper_threshold</rdfs:label>
      <rdfs:comment xml:lang="en">
The upper (exclusive) threshold of the bin.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_refln_signal_binning.upper_threshold.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_refln_signal_binning.upper_threshold"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_refln_signal_binning.ordinal">
