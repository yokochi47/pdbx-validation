   <owl:DatatypeProperty rdf:ID="pdbx_audit_revision_details.provider">
      <rdfs:subPropertyOf rdf:resource="#pdbx_audit_revision_detailsItem"/>
      <rdfs:domain rdf:resource="#pdbx_audit_revision_details"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">repository</rdf:first>
                  <rdf:rest>
