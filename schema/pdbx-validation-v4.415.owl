                                                                                                                                                                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">all</rdf:first>
                                                                                                                                                                                                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                                                                                                                                   </rdf:List>
                                                                                                                                                                                                </rdf:rest>
                                                                                                                                                                                             </rdf:List>
                                                                                                                                                                                          </rdf:rest>
                                                                                                                                                                                       </rdf:List>
                                                                                                                                                                                    </rdf:rest>
                                                                                                                                                                                 </rdf:List>
                                                                                                                                                                              </rdf:rest>
                                                                                                                                                                           </rdf:List>
                                                                                                                                                                        </rdf:rest>
                                                                                                                                                                     </rdf:List>
                                                                                                                                                                  </rdf:rest>
                                                                                                                                                               </rdf:List>
                                                                                                                                                            </rdf:rest>
                                                                                                                                                         </rdf:List>
                                                                                                                                                      </rdf:rest>
                                                                                                                                                   </rdf:List>
                                                                                                                                                </rdf:rest>
                                                                                                                                             </rdf:List>
                                                                                                                                          </rdf:rest>
                                                                                                                                       </rdf:List>
                                                                                                                                    </rdf:rest>
                                                                                                                                 </rdf:List>
                                                                                                                              </rdf:rest>
                                                                                                                           </rdf:List>
                                                                                                                        </rdf:rest>
                                                                                                                     </rdf:List>
                                                                                                                  </rdf:rest>
                                                                                                               </rdf:List>
                                                                                                            </rdf:rest>
                                                                                                         </rdf:List>
                                                                                                      </rdf:rest>
                                                                                                   </rdf:List>
                                                                                                </rdf:rest>
                                                                                             </rdf:List>
                                                                                          </rdf:rest>
                                                                                       </rdf:List>
                                                                                    </rdf:rest>
                                                                                 </rdf:List>
                                                                              </rdf:rest>
                                                                           </rdf:List>
                                                                        </rdf:rest>
                                                                     </rdf:List>
                                                                  </rdf:rest>
                                                               </rdf:List>
                                                            </rdf:rest>
                                                         </rdf:List>
                                                      </rdf:rest>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
Defines the type of dihedral angle restraints based on
the conventional residue number gap.
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="pdbx_nmr_distance_violationCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_pdbx_nmr_distance_violation"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="pdbx_nmr_distance_violation">
      <rdfs:label>pdbx_nmr_distance_violation</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the category record all distance restraint violations
of the ensemble.

Ref: User guide to the wwPDB NMR validation reports
9. Distance violation analysis
9.5 All violated distance restraints

         </rdfs:comment>
