   &lt;/VRPTx:struct_sheet_order&gt;
   &lt;VRPTx:struct_sheet_order range_id_1="strand_b" range_id_2="strand_c" sheet_id="sheet_1"&gt;
      &lt;VRPTx:offset&gt;+1&lt;/VRPTx:offset&gt;
