      <rdfs:label>pdbx_dcc_density_corr.ls_number_reflns_R_free</rdfs:label>
      <rdfs:comment xml:lang="en">
The number of reflections for the test set only.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_dcc_density_corr.ls_number_reflns_R_free.html"/>
