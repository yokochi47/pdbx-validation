   <owl:InverseFunctionalProperty rdf:ID="has_em_adminCategory">
      <rdfs:label>em_adminCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
        This property indicates that datablock
        has a category holder em_adminCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#em_admin"/>
