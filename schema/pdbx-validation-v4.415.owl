      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_nonpoly_scheme.pdb_seq_num</rdfs:label>
      <rdfs:comment xml:lang="en">
PDB residue number.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_nonpoly_scheme.pdb_seq_num.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nonpoly_scheme.pdb_seq_num"/>
