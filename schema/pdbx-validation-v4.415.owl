   <owl:ObjectProperty rdf:ID="referenced_by_phasing_MIR_der_shell">
      <rdfs:label>referenced_by_phasing_MIR_der_shell</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from phasing_MIR_der_shell.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
