      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_entity_assembly.type</rdfs:label>
      <rdfs:comment xml:lang="en">
The general type of the sample or sample subcomponent.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_entity_assembly.type.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_entity_assembly.type"/>
   </owl:DatatypeProperty>
