                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_struct_ncs_oper.matrix22.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:struct_ncs_oper.matrix22"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="struct_ncs_oper.matrix23">
      <rdfs:subPropertyOf rdf:resource="#struct_ncs_operItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>struct_ncs_oper.matrix23</rdfs:label>
      <rdfs:comment xml:lang="en">
The [2][3] element of the 3x3 matrix component of a
noncrystallographic symmetry operation.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_struct_ncs_oper.matrix23.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:struct_ncs_oper.matrix23"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="struct_ncs_oper.matrix31">
      <rdfs:subPropertyOf rdf:resource="#struct_ncs_operItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>struct_ncs_oper.matrix31</rdfs:label>
      <rdfs:comment xml:lang="en">
The [3][1] element of the 3x3 matrix component of a
noncrystallographic symmetry operation.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_struct_ncs_oper.matrix31.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:struct_ncs_oper.matrix31"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="struct_ncs_oper.matrix32">
      <rdfs:subPropertyOf rdf:resource="#struct_ncs_operItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>struct_ncs_oper.matrix32</rdfs:label>
      <rdfs:comment xml:lang="en">
The [3][2] element of the 3x3 matrix component of a
noncrystallographic symmetry operation.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_struct_ncs_oper.matrix32.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:struct_ncs_oper.matrix32"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="struct_ncs_oper.matrix33">
      <rdfs:subPropertyOf rdf:resource="#struct_ncs_operItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>struct_ncs_oper.matrix33</rdfs:label>
      <rdfs:comment xml:lang="en">
The [3][3] element of the 3x3 matrix component of a
