The Rfree reported in the model file.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_dcc_density.R_value_R_free.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_dcc_density.R_value_R_free"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_dcc_density.R_value_R_work">
