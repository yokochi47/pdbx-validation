      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_virus_entity.virus_host_category</rdfs:label>
      <rdfs:comment xml:lang="en">
The host category description for the virus.
ALGAE
ARCHAEA
BACTERIA(EUBACTERIA)
FUNGI
INVERTEBRATES
PLANTAE (HIGHER PLANTS)
PROTOZOA
VERTEBRATES
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_virus_entity.virus_host_category.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_virus_entity.virus_host_category"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_virus_entity.virus_isolate">
      <rdfs:subPropertyOf rdf:resource="#em_virus_entityItem"/>
      <rdfs:domain rdf:resource="#em_virus_entity"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">STRAIN</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SEROTYPE</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SEROCOMPLEX</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SUBSPECIES</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SPECIES</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OTHER</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
The isolate from which the virus was obtained.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_virus_entity.virus_isolate.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_virus_entity.virus_isolate"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="em_virus_entity.virus_type">
      <rdfs:subPropertyOf rdf:resource="#em_virus_entityItem"/>
      <rdfs:domain rdf:resource="#em_virus_entity"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VIRION</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SATELLITE</rdf:first>
