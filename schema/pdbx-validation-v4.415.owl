                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_struct_conn_angle.ptnr3_auth_seq_id.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_struct_conn_angle.ptnr3_auth_seq_id"/>
   </owl:DatatypeProperty>
