   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nonpoly_scheme.pdb_strand_id">
      <rdfs:subPropertyOf rdf:resource="#pdbx_nonpoly_schemeItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_nonpoly_scheme.pdb_strand_id</rdfs:label>
      <rdfs:comment xml:lang="en">
PDB strand/chain id.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_nonpoly_scheme.pdb_strand_id.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nonpoly_scheme.pdb_strand_id"/>
