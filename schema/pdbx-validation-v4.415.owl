   <owl:DatatypeProperty rdf:ID="em_imaging.tilt_angle_max">
      <rdfs:subPropertyOf rdf:resource="#em_imagingItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>em_imaging.tilt_angle_max</rdfs:label>
      <rdfs:comment xml:lang="en">
The maximum angle at which the specimen was tilted to obtain
recorded images.
70
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_imaging.tilt_angle_max.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_imaging.tilt_angle_max"/>
   </owl:DatatypeProperty>
