                  <owl:onProperty rdf:resource="#pdbx_branch_scheme.hetero"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_branch_scheme.pdb_asym_id"/>
