      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="pdbx_em_fsc_curve">
      <rdfs:label>pdbx_em_fsc_curve</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the category record Fourier-Shell Correlation (FSC)
curve.

Ref: User guide to the wwPDB EM validation reports
8. FSC validation
8.1 Calculated FSC
8.2 Author provided FSC

    Example 1 - based on PDB entry 6RJH.
&lt;VRPTx:pdbx_em_fsc_curveCategory&gt;
   &lt;VRPTx:pdbx_em_fsc_curve id="1"&gt;
      &lt;VRPTx:correlation_coef_title&gt;Correlation coefficient&lt;/VRPTx:correlation_coef_title&gt;
      &lt;VRPTx:spatial_frequency_title&gt;Spatial frequency&lt;/VRPTx:spatial_frequency_title&gt;
      &lt;VRPTx:spatial_frequency_unit&gt;1/A&lt;/VRPTx:spatial_frequency_unit&gt;
      &lt;VRPTx:title&gt;calculated_fsc&lt;/VRPTx:title&gt;
   &lt;/VRPTx:pdbx_em_fsc_curve&gt;
   &lt;VRPTx:pdbx_em_fsc_curve id="2"&gt;
      &lt;VRPTx:correlation_coef_title&gt;Correlation coefficient&lt;/VRPTx:correlation_coef_title&gt;
      &lt;VRPTx:spatial_frequency_title&gt;Spatial frequency&lt;/VRPTx:spatial_frequency_title&gt;
      &lt;VRPTx:spatial_frequency_unit&gt;1/A&lt;/VRPTx:spatial_frequency_unit&gt;
      &lt;VRPTx:title&gt;author_provided_fsc&lt;/VRPTx:title&gt;
   &lt;/VRPTx:pdbx_em_fsc_curve&gt;
&lt;/VRPTx:pdbx_em_fsc_curveCategory&gt;


         </rdfs:comment>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_em_fsc_curve.correlation_coef_title"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_em_fsc_curve.correlation_coef_title"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_em_fsc_curve.name"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_em_fsc_curve.name"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_em_fsc_curve.spatial_frequency_title"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_em_fsc_curve.spatial_frequency_title"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_em_fsc_curve.spatial_frequency_unit"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_em_fsc_curve.spatial_frequency_unit"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_em_fsc_curve.title"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_em_fsc_curve.title"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_em_fsc_curve.type"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_em_fsc_curve.type"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_em_fsc_curve.id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
