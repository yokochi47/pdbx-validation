      <rdfs:comment xml:lang="en">
Pointer to attribute label_comp_id in category atom_site. 
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_nonpoly_scheme.mon_id.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nonpoly_scheme.mon_id"/>
      <owl:equivalentProperty rdf:resource="BMRBo:pdbx_nonpoly_scheme.comp_id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_nonpoly_scheme.pdb_ins_code">
