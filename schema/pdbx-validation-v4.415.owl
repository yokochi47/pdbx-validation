   <owl:ObjectProperty rdf:ID="referenced_by_struct_sheet_order">
      <rdfs:label>referenced_by_struct_sheet_order</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from struct_sheet_order.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
