      <rdfs:subPropertyOf rdf:resource="#em_entity_assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_entity_assembly.synonym</rdfs:label>
