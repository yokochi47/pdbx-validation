      <owl:equivalentClass rdf:resource="PDBo:em_entity_assembly_naturalsourceCategory"/>
   </owl:Class>
   <owl:Class rdf:ID="em_entity_assembly_naturalsource">
      <rdfs:label>em_entity_assembly_naturalsource</rdfs:label>
      <rdfs:comment xml:lang="en">
