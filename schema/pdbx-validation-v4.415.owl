      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_entity_poly_comp_link_list.leaving_atom_id_1.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_entity_poly_comp_link_list.leaving_atom_id_1"/>
   </owl:DatatypeProperty>
