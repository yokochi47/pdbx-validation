      <rdfs:comment xml:lang="en">cross-reference from em_embedding.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#em_embedding"/>
      <owl:equivalentProperty rdf:resource="PDBo:referenced_by_em_embedding"/>
