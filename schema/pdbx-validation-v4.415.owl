      <rdfs:label>pdbx_re_refinementItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for pdbx_re_refinement items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#pdbx_re_refinement"/>
