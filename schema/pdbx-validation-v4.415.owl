   &lt;/VRPTx:pdbx_em_fsc_resolution&gt;
   &lt;VRPTx:pdbx_em_fsc_resolution criterion="half-bit" source="author_provided_fsc"&gt;
      &lt;VRPTx:correlation_coef&gt;0.1772&lt;/VRPTx:correlation_coef&gt;
