   <owl:Class rdf:ID="pdbx_sifts_xref_db_segments">
      <rdfs:label>pdbx_sifts_xref_db_segments</rdfs:label>
      <rdfs:comment xml:lang="en">
pdbx_sifts_xref_db_segments describes residue-range based cross-references to external databases.

    Example 1 -
&lt;VRPTx:pdbx_sifts_xref_db_segmentsCategory&gt;
   &lt;VRPTx:pdbx_sifts_xref_db_segments asym_id="A" entity_id="1" instance_id="1" segment_id="1" seq_id_end="252" seq_id_start="26" xref_db="SCOP2B" xref_db_acc="8102030"&gt;
      &lt;VRPTx:domain_name&gt;SF&lt;/VRPTx:domain_name&gt;
   &lt;/VRPTx:pdbx_sifts_xref_db_segments&gt;
&lt;/VRPTx:pdbx_sifts_xref_db_segmentsCategory&gt;


         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://pdbml.pdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/pdbx_sifts_xref_db_segments.html"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_sifts_xref_db_segments.domain_name"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_sifts_xref_db_segments.domain_name"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_sifts_xref_db_segments.asym_id"/>
