      <rdfs:label>referenced_by_pdbx_exptl_subtype</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from pdbx_exptl_subtype.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#pdbx_exptl_subtype"/>
      <owl:equivalentProperty rdf:resource="PDBo:referenced_by_pdbx_exptl_subtype"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_exptl_subtype.details">
      <rdfs:subPropertyOf rdf:resource="#pdbx_exptl_subtypeItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_exptl_subtype.details</rdfs:label>
      <rdfs:comment xml:lang="en">
Details about the method subtype.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_exptl_subtype.details.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_exptl_subtype.details"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_exptl_subtype.exptl_method">
      <rdfs:subPropertyOf rdf:resource="#pdbx_exptl_subtypeItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_exptl_subtype.exptl_method</rdfs:label>
      <rdfs:comment xml:lang="en">
This data item is a pointer to attribute method in category exptl in the EXPTL category. 
X-RAY CRYSTALLOGRAPHY
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_exptl_subtype.exptl_method.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_exptl_subtype.exptl_method"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_exptl_subtype.method_type">
      <rdfs:subPropertyOf rdf:resource="#pdbx_exptl_subtypeItem"/>
      <rdfs:domain rdf:resource="#pdbx_exptl_subtype"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Microcrystal Electron Diffraction</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2-Dimensional Electron Crystallography</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">
The subtype of the method used in the experiment. The
subtype should be a variance of the primary method
recorded in the attribute method in category exptl item, with distinctive
 technical applications and significant scientific
impacts.
Microcrystal Electron Diffraction
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_exptl_subtype.method_type.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_exptl_subtype.method_type"/>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="pdbx_helical_symmetryCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_pdbx_helical_symmetry"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
      <owl:equivalentClass rdf:resource="PDBo:pdbx_helical_symmetryCategory"/>
   </owl:Class>
   <owl:Class rdf:ID="pdbx_helical_symmetry">
      <rdfs:label>pdbx_helical_symmetry</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the PDBX_HELICAL_SYMMETRY category record details about the
helical symmetry group associated with this entry.

    Example 1 -
&lt;VRPTx:pdbx_helical_symmetryCategory&gt;
   &lt;VRPTx:pdbx_helical_symmetry entry_id="1ABC"&gt;
      &lt;VRPTx:circular_symmetry&gt;1&lt;/VRPTx:circular_symmetry&gt;
      &lt;VRPTx:dyad_axis&gt;no&lt;/VRPTx:dyad_axis&gt;
      &lt;VRPTx:n_subunits_divisor&gt;1&lt;/VRPTx:n_subunits_divisor&gt;
      &lt;VRPTx:number_of_operations&gt;35&lt;/VRPTx:number_of_operations&gt;
      &lt;VRPTx:rise_per_n_subunits&gt;6.10&lt;/VRPTx:rise_per_n_subunits&gt;
      &lt;VRPTx:rotation_per_n_subunits&gt;131.84&lt;/VRPTx:rotation_per_n_subunits&gt;
   &lt;/VRPTx:pdbx_helical_symmetry&gt;
&lt;/VRPTx:pdbx_helical_symmetryCategory&gt;


         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://pdbml.pdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/pdbx_helical_symmetry.html"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.circular_symmetry"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.circular_symmetry"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.dyad_axis"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.dyad_axis"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.n_subunits_divisor"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.n_subunits_divisor"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.number_of_operations"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.number_of_operations"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.rise_per_n_subunits"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.rise_per_n_subunits"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.rotation_per_n_subunits"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.rotation_per_n_subunits"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_helical_symmetry.entry_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
      <owl:equivalentClass rdf:resource="PDBo:pdbx_helical_symmetry"/>
   </owl:Class>
