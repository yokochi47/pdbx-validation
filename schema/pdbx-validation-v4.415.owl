      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_phasing_MAD_ratio.clust_id.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:phasing_MAD_ratio.clust_id"/>
   </owl:DatatypeProperty>
