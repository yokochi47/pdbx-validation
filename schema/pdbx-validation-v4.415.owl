      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>em_imaging_optics.energyfilter_lower</rdfs:label>
      <rdfs:comment xml:lang="en">
The energy filter range lower value in electron volts (eV) set by spectrometer.
0
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_imaging_optics.energyfilter_lower.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:em_imaging_optics.energyfilter_lower"/>
   </owl:DatatypeProperty>
