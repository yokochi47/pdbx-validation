      <rdfs:label>referenced_by_pdbx_em_raps</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from pdbx_em_raps.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#pdbx_em_raps"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_em_raps.power_scale">
      <rdfs:subPropertyOf rdf:resource="#pdbx_em_rapsItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_em_raps.power_scale</rdfs:label>
      <rdfs:comment xml:lang="en">
A scale for the power axis of a Rotationally Averaged Power Spectrum
(RAPS) plot.

See also: https://www.wwpdb.org/validation/EMValidationReportHelp#raps
log10
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_em_raps.power_title">
      <rdfs:subPropertyOf rdf:resource="#pdbx_em_rapsItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_em_raps.power_title</rdfs:label>
      <rdfs:comment xml:lang="en">
A title for the power axis of a Rotationally Averaged Power Spectrum
(RAPS) plot.

See also: https://www.wwpdb.org/validation/EMValidationReportHelp#raps
Intensity
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_em_raps.spatial_frequency_title">
      <rdfs:subPropertyOf rdf:resource="#pdbx_em_rapsItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_em_raps.spatial_frequency_title</rdfs:label>
      <rdfs:comment xml:lang="en">
A title for the spatial frequency axis of a Rotationally Averaged
Power Spectrum (RAPS) plot.

See also: https://www.wwpdb.org/validation/EMValidationReportHelp#raps
Spatial frequency
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_em_raps.spatial_frequency_unit">
      <rdfs:subPropertyOf rdf:resource="#pdbx_em_rapsItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pdbx_em_raps.spatial_frequency_unit</rdfs:label>
      <rdfs:comment xml:lang="en">
A unit for the spatial frequency axis of a Rotationally Averaged
Power Spectrum (RAPS) plot.


See also: https://www.wwpdb.org/validation/EMValidationReportHelp#raps
1/A
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_em_raps.id">
