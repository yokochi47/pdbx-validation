   <owl:DatatypeProperty rdf:ID="pdbx_phasing_dm.delta_phi_final">
      <rdfs:subPropertyOf rdf:resource="#pdbx_phasing_dmItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_phasing_dm.delta_phi_final</rdfs:label>
      <rdfs:comment xml:lang="en">
The value of attribute delta_phi_final in category pdbx_phasing_dm identifies phase difference
 after density modification
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_phasing_dm.delta_phi_final.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_phasing_dm.delta_phi_final"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_phasing_dm.delta_phi_initial">
      <rdfs:subPropertyOf rdf:resource="#pdbx_phasing_dmItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_phasing_dm.delta_phi_initial</rdfs:label>
      <rdfs:comment xml:lang="en">
The value of attribute delta_phi_initial in category pdbx_phasing_dm identifies phase difference
 before density modification
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_phasing_dm.delta_phi_initial.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_phasing_dm.delta_phi_initial"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pdbx_phasing_dm.fom">
      <rdfs:subPropertyOf rdf:resource="#pdbx_phasing_dmItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pdbx_phasing_dm.fom</rdfs:label>
      <rdfs:comment xml:lang="en">
The value of attribute fom in category pdbx_phasing_dm identifies the figure of merit
 for all the data
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_pdbx_phasing_dm.fom.html"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_phasing_dm.fom"/>
   </owl:DatatypeProperty>
