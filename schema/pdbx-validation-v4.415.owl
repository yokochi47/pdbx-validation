   </owl:Class>
   <owl:Class rdf:ID="struct_conn_type">
      <rdfs:label>struct_conn_type</rdfs:label>
      <rdfs:comment xml:lang="en">
Data items in the STRUCT_CONN_TYPE category record details
about the criteria used to identify interactions between
portions of the structure.

    Example 1 - based on PDB entry 5HVP and laboratory records for the
                structure corresponding to PDB entry 5HVP.
&lt;VRPTx:struct_conn_typeCategory&gt;
   &lt;VRPTx:struct_conn_type id="saltbr"&gt;
      &lt;VRPTx:criteria&gt;negative to positive distance &amp;gt; 2.5 \&amp;#37;A, &amp;lt; 3.2 \&amp;#37;A&lt;/VRPTx:criteria&gt;
      &lt;VRPTx:reference xsi:nil="true" /&gt;
   &lt;/VRPTx:struct_conn_type&gt;
   &lt;VRPTx:struct_conn_type id="hydrog"&gt;
      &lt;VRPTx:criteria&gt;NO distance &amp;gt; 2.5\&amp;#37;A, &amp;lt; 3.5\&amp;#37;A, NOC angle &amp;lt; 120 degrees&lt;/VRPTx:criteria&gt;
      &lt;VRPTx:reference xsi:nil="true" /&gt;
   &lt;/VRPTx:struct_conn_type&gt;
&lt;/VRPTx:struct_conn_typeCategory&gt;


         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://pdbml.pdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/struct_conn_type.html"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_conn_type.criteria"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_conn_type.criteria"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_conn_type.reference"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_conn_type.reference"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#struct_conn_type.id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
      <owl:equivalentClass rdf:resource="PDBo:struct_conn_type"/>
   </owl:Class>
