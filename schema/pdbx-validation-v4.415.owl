   <owl:Class rdf:ID="em_diffraction_shell">
      <rdfs:label>em_diffraction_shell</rdfs:label>
      <rdfs:comment xml:lang="en">
Statistical parameters for electron diffraction measurements
within a resolution shell

    Example 1 -
&lt;VRPTx:em_diffraction_shellCategory&gt;
   &lt;VRPTx:em_diffraction_shell id="1"&gt;
      &lt;VRPTx:fourier_space_coverage&gt;93.0&lt;/VRPTx:fourier_space_coverage&gt;
      &lt;VRPTx:high_resolution&gt;7.5&lt;/VRPTx:high_resolution&gt;
      &lt;VRPTx:low_resolution&gt;45&lt;/VRPTx:low_resolution&gt;
      &lt;VRPTx:multiplicity&gt;2.3&lt;/VRPTx:multiplicity&gt;
      &lt;VRPTx:num_structure_factors&gt;327&lt;/VRPTx:num_structure_factors&gt;
      &lt;VRPTx:phase_residual&gt;13.5&lt;/VRPTx:phase_residual&gt;
   &lt;/VRPTx:em_diffraction_shell&gt;
&lt;/VRPTx:em_diffraction_shellCategory&gt;


         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://pdbml.pdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/em_diffraction_shell.html"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_diffraction_shell.em_diffraction_stats_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_diffraction_shell.em_diffraction_stats_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_diffraction_shell.fourier_space_coverage"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_diffraction_shell.fourier_space_coverage"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_diffraction_shell.high_resolution"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_diffraction_shell.high_resolution"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#em_diffraction_shell.low_resolution"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
