   <owl:Class rdf:ID="pdbx_nmr_refine">
      <rdfs:label>pdbx_nmr_refine</rdfs:label>
      <rdfs:comment xml:lang="en">
Describe the method and details of the refinement of the deposited structure.
   This example is drawn from the MCP-1 structure.
&lt;VRPTx:pdbx_nmr_refineCategory&gt;
   &lt;VRPTx:pdbx_nmr_refine entry_id="1ABC" software_ordinal="1"&gt;
      &lt;VRPTx:method&gt;torsion angle dynamics&lt;/VRPTx:method&gt;
   &lt;/VRPTx:pdbx_nmr_refine&gt;
&lt;/VRPTx:pdbx_nmr_refineCategory&gt;


         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="http://pdbml.pdb.org/dictionaries/mmcif_pdbx_v50.dic/Categories/pdbx_nmr_refine.html"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_refine.details"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_refine.details"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_refine.method"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_refine.method"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_refine.entry_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#pdbx_nmr_refine.software_ordinal"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
      <owl:equivalentClass rdf:resource="PDBo:pdbx_nmr_refine"/>
   </owl:Class>
